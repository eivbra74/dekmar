---
import '../styles/global.css';
import { ksUi } from '../data/ks';

interface Props {
  active?: 'home' | 'checklist' | 'deviation' | 'help' | 'portal';
  title?: string;
}
const { active, title } = Astro.props;
const tri = (k: string) => ksUi[k];
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/images/brand/dekmar-logo.png" />
    <title>{title ? `${title} – Dekmar HMS- og KS-system` : 'Dekmar HMS- og KS-system'}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="ks-header">
      <div class="container ks-header__inner">
        <a class="ks-brand" href="/ks/">
          <img src="/images/brand/dekmar-logo.png" alt="Dekmar" width="96" height="48" />
          <span class="ks-brand__tag" data-no="HMS/KS" data-pl="BHP/KS" data-en="HSE/QA">HMS/KS</span>
        </a>

        <nav class="ks-nav" aria-label="KS">
          <a href="/portal/" class:list={[{ active: active === 'portal' }]} data-no="Portal" data-pl="Portal" data-en="Portal">Portal</a>
          <a href="/ks/sjekkliste/" class:list={[{ active: active === 'checklist' }]} data-no={tri('checklist').no} data-pl={tri('checklist').pl} data-en={tri('checklist').en}>{tri('checklist').no}</a>
          <a href="/ks/avvik/" class:list={[{ active: active === 'deviation' }]} data-no={tri('deviation').no} data-pl={tri('deviation').pl} data-en={tri('deviation').en}>{tri('deviation').no}</a>
          <a href="/portal/?view=workdoc" data-no="Dokumentasjon" data-pl="Dokumentacja" data-en="Documentation">Dokumentasjon</a>
        </nav>

        <div class="ks-lang" role="group" aria-label="Språk / Language">
          <button type="button" data-ks-set="no" class="active"><svg class="ks-flag" viewBox="0 0 22 16" aria-hidden="true"><rect width="22" height="16" fill="#ba0c2f"/><rect x="6" width="4" height="16" fill="#fff"/><rect y="6" width="22" height="4" fill="#fff"/><rect x="7" width="2" height="16" fill="#00205b"/><rect y="7" width="22" height="2" fill="#00205b"/></svg>NO</button>
          <button type="button" data-ks-set="pl"><svg class="ks-flag" viewBox="0 0 22 16" aria-hidden="true"><rect width="22" height="8" fill="#fff"/><rect y="8" width="22" height="8" fill="#dc143c"/></svg>PL</button>
          <button type="button" data-ks-set="en"><svg class="ks-flag" viewBox="0 0 60 40" aria-hidden="true"><clipPath id="ujflag"><rect width="60" height="40" rx="0"/></clipPath><g clip-path="url(#ujflag)"><rect width="60" height="40" fill="#012169"/><path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="8"/><path d="M0,0 L60,40 M60,0 L0,40" stroke="#c8102e" stroke-width="4"/><rect x="25" width="10" height="40" fill="#fff"/><rect y="15" width="60" height="10" fill="#fff"/><rect x="27" width="6" height="40" fill="#c8102e"/><rect y="17" width="60" height="6" fill="#c8102e"/></g></svg>EN</button>
        </div>
      </div>
    </header>

    <main class="ks-main">
      <slot />
    </main>

    <footer class="ks-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Dekmar AS · HMS- og KS-system</span>
        <a href="/">dekmar.no →</a>
      </div>
    </footer>

    <style>
      body { background: var(--surface); }
      .ks-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--dark);
        color: #fff;
      }
      .ks-header__inner {
        display: flex;
        align-items: center;
        gap: 16px;
        min-height: 64px;
        flex-wrap: wrap;
      }
      .ks-brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #fff;
      }
      .ks-brand img {
        height: 34px;
        width: auto;
        background: #fff;
        border-radius: 6px;
        padding: 3px 6px;
      }
      .ks-brand__tag {
        font-family: var(--font-head);
        font-weight: 700;
        letter-spacing: 0.14em;
        font-size: 0.85rem;
        color: #ff8a91;
      }
      .ks-nav {
        display: flex;
        gap: 4px;
        margin-right: auto;
        flex-wrap: wrap;
      }
      .ks-nav a {
        color: #cdd2da;
        font-family: var(--font-head);
        font-weight: 600;
        font-size: 0.92rem;
        padding: 8px 11px;
        border-radius: 8px;
      }
      .ks-nav a:hover { color: #fff; text-decoration: none; background: rgba(255,255,255,0.08); }
      .ks-nav a.active { color: #fff; background: var(--brand); }
      .ks-lang {
        display: inline-flex;
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 999px;
        overflow: hidden;
      }
      .ks-lang button {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        color: #cdd2da;
        border: 0;
        padding: 7px 12px;
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 0.82rem;
        cursor: pointer;
      }
      .ks-lang button.active { background: var(--brand); color: #fff; }
      .ks-flag { width: 20px; height: 14px; border-radius: 2px; flex: 0 0 auto; box-shadow: 0 0 0 1px rgba(255,255,255,0.25); display: block; }
      .ks-main { padding-block: clamp(24px, 4vw, 44px); min-height: 60vh; }
      .ks-footer {
        border-top: 1px solid var(--line);
        padding-block: 20px;
        font-size: 0.85rem;
        color: var(--muted);
      }
      .ks-footer .container { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    </style>

    <script>
      type KsLang = 'no' | 'pl' | 'en';
      const swap = (lang: KsLang) => {
        document.documentElement.setAttribute('lang', lang === 'no' ? 'no' : lang);
        document.querySelectorAll<HTMLElement>('[data-no]').forEach((el) => {
          const v = el.getAttribute('data-' + lang);
          if (v !== null) el.textContent = v;
        });
        document.querySelectorAll<HTMLElement>('[data-no-ph]').forEach((el) => {
          const v = el.getAttribute('data-' + lang + '-ph');
          if (v !== null) el.setAttribute('placeholder', v);
        });
        document.querySelectorAll<HTMLButtonElement>('[data-ks-set]').forEach((b) => {
          b.classList.toggle('active', b.getAttribute('data-ks-set') === lang);
        });
        (window as any).ksLang = lang;
        try { localStorage.setItem('ksLang', lang); } catch (e) {}
        document.dispatchEvent(new CustomEvent('kslangchange', { detail: lang }));
      };
      let initial: KsLang = 'no';
      try {
        const s = localStorage.getItem('ksLang') as KsLang | null;
        if (s === 'no' || s === 'pl' || s === 'en') initial = s;
      } catch (e) {}
      (window as any).ksLang = initial;
      document.querySelectorAll<HTMLButtonElement>('[data-ks-set]').forEach((b) => {
        b.addEventListener('click', () => swap(b.getAttribute('data-ks-set') as KsLang));
      });
      swap(initial);
    </script>
  </body>
</html>
