---
import { navItems } from '../data/site';
import { services } from '../data/services';
import { references } from '../data/references';
import { useTranslations, localizePath, alternatePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const path = Astro.url.pathname;
// Normalisert sti uten /en-prefiks, for aktiv-markering
const basePath = path.replace(/^\/en(\/|$)/, '/');
const isActive = (href: string) =>
  href === '/' ? basePath === '/' : basePath.startsWith(href);

const L = (href: string) => localizePath(href, lang);
const otherLang: Lang = lang === 'en' ? 'nb' : 'en';
const switchHref = alternatePath(path, otherLang);
---

<header class="site-header" id="top">
  <div class="container header-inner">
    <a class="brand" href={L('/')} aria-label="Dekmar AS">
      <img src="/images/brand/dekmar-logo.png" alt="Dekmar AS" width="120" height="60" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label={t('nav.menu')}>
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label={t('nav.menu')}>
      <ul class="nav-list">
        <li><a href={L('/')} class:list={[{ active: isActive('/') }]}>{t('nav.home')}</a></li>

        <li class="has-sub">
          <a href={L('/tjenester/')} class:list={[{ active: isActive('/tjenester') }]}>
            {t('nav.services')} <span class="caret" aria-hidden="true"></span>
          </a>
          <ul class="submenu">
            {services.map((s) => (
              <li><a href={L(`/tjenester/${s.slug}/`)}>{s.title[lang]}</a></li>
            ))}
          </ul>
        </li>

        <li class="has-sub">
          <a href={L('/referanser/')} class:list={[{ active: isActive('/referanser') }]}>
            {t('nav.references')} <span class="caret" aria-hidden="true"></span>
          </a>
          <ul class="submenu">
            {references.map((r) => (
              <li><a href={L(`/referanser/${r.slug}/`)}>{r.title}</a></li>
            ))}
          </ul>
        </li>

        <li><a href={L('/samarbeidspartnere/')} class:list={[{ active: isActive('/samarbeidspartnere') }]}>{t('nav.partners')}</a></li>
        <li><a href={L('/om-oss/')} class:list={[{ active: isActive('/om-oss') }]}>{t('nav.about')}</a></li>
        <li><a href={L('/kontakt/')} class:list={[{ active: isActive('/kontakt') }]}>{t('nav.contact')}</a></li>
      </ul>

      <div class="header-actions">
        <a class="lang-switch" href={switchHref} hreflang={otherLang} aria-label={t('lang.switch')}>
          <span class="globe" aria-hidden="true">🌐</span> {t('lang.switch')}
        </a>
        <a class="btn btn--primary header-cta" href={L('/kontakt/')}>{t('cta.quote')}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 76px;
  }
  .brand img {
    height: 46px;
    width: auto;
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list > li > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink);
    padding: 10px 12px;
    border-radius: 8px;
  }
  .nav-list > li > a:hover,
  .nav-list > li > a.active {
    color: var(--brand);
    text-decoration: none;
    background: var(--surface);
  }
  .caret {
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    opacity: 0.6;
  }

  .has-sub {
    position: relative;
  }
  .submenu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 240px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow);
    padding: 8px;
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }
  .has-sub:hover .submenu,
  .has-sub:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .submenu a {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .submenu a:hover {
    background: var(--surface);
    color: var(--brand);
    text-decoration: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    white-space: nowrap;
  }
  .lang-switch:hover {
    border-color: var(--ink);
    text-decoration: none;
  }
  .globe {
    font-size: 0.95rem;
    line-height: 1;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 10px;
  }
  .nav-toggle span {
    width: 26px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 1100px) {
    .nav-toggle {
      display: flex;
    }
    .main-nav {
      position: fixed;
      inset: 76px 0 0 0;
      background: #fff;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 16px 22px 40px;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.25s ease;
      border-top: 1px solid var(--line);
    }
    .main-nav.open {
      transform: translateX(0);
    }
    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav-list > li {
      border-bottom: 1px solid var(--line);
    }
    .nav-list > li > a {
      justify-content: space-between;
      padding: 15px 4px;
      font-size: 1.05rem;
    }
    .submenu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      padding: 0 0 10px 12px;
      display: none;
    }
    .has-sub.expanded .submenu {
      display: block;
    }
    .has-sub.expanded .caret {
      transform: rotate(-135deg) translateY(2px);
    }
    .header-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      margin-top: 22px;
    }
    .lang-switch {
      justify-content: center;
    }
    .header-cta {
      justify-content: center;
    }
    body.nav-open {
      overflow: hidden;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
    document.body.classList.toggle('nav-open', !!open);
  });
  document.querySelectorAll('.has-sub > a .caret').forEach((caret) => {
    const link = caret.closest('a');
    link?.addEventListener('click', (e) => {
      if (window.matchMedia('(max-width: 1100px)').matches) {
        e.preventDefault();
        link.parentElement?.classList.toggle('expanded');
      }
    });
  });
</script>
