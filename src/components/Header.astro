---
import { site } from '../data/site';
import { services } from '../data/services';
import { references } from '../data/references';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header" id="top">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Dekmar AS – forside">
      <img src="/images/brand/dekmar-logo.png" alt="Dekmar AS" width="120" height="60" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Meny">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Hovedmeny">
      <ul class="nav-list">
        <li><a href="/" class:list={[{ active: isActive('/') }]}>Forside</a></li>

        <li class="has-sub">
          <a href="/tjenester/" class:list={[{ active: isActive('/tjenester') }]}>
            Tjenester <span class="caret" aria-hidden="true"></span>
          </a>
          <ul class="submenu">
            {services.map((s) => (
              <li><a href={`/tjenester/${s.slug}/`}>{s.title}</a></li>
            ))}
          </ul>
        </li>

        <li class="has-sub">
          <a href="/referanser/" class:list={[{ active: isActive('/referanser') }]}>
            Referanser <span class="caret" aria-hidden="true"></span>
          </a>
          <ul class="submenu">
            {references.map((r) => (
              <li><a href={`/referanser/${r.slug}/`}>{r.title}</a></li>
            ))}
          </ul>
        </li>

        <li><a href="/samarbeidspartnere/" class:list={[{ active: isActive('/samarbeidspartnere') }]}>Samarbeidspartnere</a></li>
        <li><a href="/om-oss/" class:list={[{ active: isActive('/om-oss') }]}>Om oss</a></li>
        <li><a href="/kontakt/" class:list={[{ active: isActive('/kontakt') }]}>Kontakt</a></li>
      </ul>
      <a class="btn btn--primary header-cta" href="/kontakt/">Be om tilbud</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 76px;
  }
  .brand img {
    height: 46px;
    width: auto;
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list > li > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink);
    padding: 10px 12px;
    border-radius: 8px;
  }
  .nav-list > li > a:hover,
  .nav-list > li > a.active {
    color: var(--brand);
    text-decoration: none;
    background: var(--surface);
  }
  .caret {
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    opacity: 0.6;
  }

  /* Dropdown (desktop) */
  .has-sub {
    position: relative;
  }
  .submenu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 240px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow);
    padding: 8px;
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }
  .has-sub:hover .submenu,
  .has-sub:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .submenu a {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .submenu a:hover {
    background: var(--surface);
    color: var(--brand);
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 10px;
  }
  .nav-toggle span {
    width: 26px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Mobil */
  @media (max-width: 980px) {
    .nav-toggle {
      display: flex;
    }
    .main-nav {
      position: fixed;
      inset: 76px 0 0 0;
      background: #fff;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 16px 22px 40px;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.25s ease;
      border-top: 1px solid var(--line);
    }
    .main-nav.open {
      transform: translateX(0);
    }
    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav-list > li {
      border-bottom: 1px solid var(--line);
    }
    .nav-list > li > a {
      justify-content: space-between;
      padding: 15px 4px;
      font-size: 1.05rem;
    }
    .submenu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      padding: 0 0 10px 12px;
      display: none;
    }
    .has-sub.expanded .submenu {
      display: block;
    }
    .has-sub.expanded .caret {
      transform: rotate(-135deg) translateY(2px);
    }
    .header-cta {
      margin-top: 22px;
      justify-content: center;
    }
    body.nav-open {
      overflow: hidden;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
    document.body.classList.toggle('nav-open', !!open);
  });
  // Expand/collapse submenus on mobile
  document.querySelectorAll('.has-sub > a .caret').forEach((caret) => {
    const link = caret.closest('a');
    link?.addEventListener('click', (e) => {
      if (window.matchMedia('(max-width: 980px)').matches) {
        e.preventDefault();
        link.parentElement?.classList.toggle('expanded');
      }
    });
  });
</script>
