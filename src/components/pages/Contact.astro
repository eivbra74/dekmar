---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ContactForm from '../ContactForm.astro';
import { site } from '../../data/site';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  nb: {
    eyebrow: 'Kontakt',
    title: 'Ta kontakt med oss',
    intro:
      'Vi tilbyr gratis befaring med et påfølgende uforpliktende tilbud. Fyll ut skjemaet, eller ta kontakt direkte.',
    desc: 'Ta kontakt med Dekmar AS for en gratis og uforpliktende befaring. Vi hjelper deg med tak og blikkenslagerarbeid i Oslo og Viken.',
    formHeading: 'Send oss en melding',
    contactHeading: 'Kontaktpersoner',
    general: 'Generelt',
    emailLabel: 'E-post',
    areaLabel: 'Område',
  },
  en: {
    eyebrow: 'Contact',
    title: 'Get in touch',
    intro:
      'We offer a free inspection followed by a no-obligation quote. Fill in the form, or contact us directly.',
    desc: 'Contact Dekmar AS for a free, no-obligation inspection. We help you with roofing and sheet metal work in Oslo and Viken.',
    formHeading: 'Send us a message',
    contactHeading: 'Contacts',
    general: 'General',
    emailLabel: 'Email',
    areaLabel: 'Area',
  },
}[lang];
---

<Layout lang={lang} title={copy.eyebrow} description={copy.desc}>
  <PageHero eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} />

  <section class="section">
    <div class="container contact-grid">
      <div>
        <h2>{copy.formHeading}</h2>
        <ContactForm lang={lang} />
      </div>

      <aside class="contact-info">
        <h2>{copy.contactHeading}</h2>
        <div class="info-card">
          <h3>{site.contact.name}</h3>
          <p class="role">{site.contact.role[lang]}</p>
          <p>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />
            <a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>
          </p>
        </div>
        <div class="info-card">
          <h3>{copy.general}</h3>
          <p>
            {copy.emailLabel}: <a href={`mailto:${site.email}`}>{site.email}</a><br />
            {copy.areaLabel}: {site.area}
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 44px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .contact-info h2 {
    margin-bottom: 18px;
  }
  .info-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 24px;
    margin-bottom: 18px;
  }
  .info-card h3 {
    margin: 0 0 4px;
    font-size: 1.15rem;
  }
  .info-card .role {
    color: var(--brand);
    font-weight: 600;
    margin: 0 0 10px;
  }
  .info-card p {
    margin: 0;
    line-height: 1.8;
  }
</style>
