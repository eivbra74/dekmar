---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import CTA from '../CTA.astro';
import { references } from '../../data/references';
import { useTranslations, localizePath, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (href: string) => localizePath(href, lang);

const copy = {
  nb: {
    title: 'Referanser',
    heading: 'Våre prosjekter',
    intro:
      'Vi arbeider med rehabilitering og nybygg – fra bygårder og næringsbygg til skoler, idrettshaller og kirker. Klikk deg inn på et prosjekt for å se bilder.',
    desc: 'Et utvalg av Dekmar AS sine takprosjekter – bygårder, næringsbygg, skoler, idrettshaller og kirker i Oslo-området.',
  },
  en: {
    title: 'References',
    heading: 'Our projects',
    intro:
      'We work with rehabilitation and new builds – from apartment buildings and commercial premises to schools, sports halls and churches. Click into a project to see photos.',
    desc: 'A selection of Dekmar AS roofing projects – apartment buildings, commercial premises, schools, sports halls and churches in the Oslo area.',
  },
}[lang];
---

<Layout lang={lang} title={copy.title} description={copy.desc}>
  <PageHero eyebrow={copy.title} title={copy.heading} intro={copy.intro} />

  <section class="section">
    <div class="container">
      <div class="grid grid--3 refs">
        {references.map((r) => (
          <a class="ref-card" href={L(`/referanser/${r.slug}/`)}>
            <div class="ref-card__media">
              <img src={r.images[0]} alt={r.title} loading="lazy" decoding="async" />
              <span class="ref-card__count">{r.images.length} {t('ref.images')}</span>
            </div>
            <div class="ref-card__body">
              <h3>{r.title}</h3>
              <p>{r.summary[lang]}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Layout>

<style>
  .ref-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--ink);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .ref-card:hover {
    text-decoration: none;
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: transparent;
  }
  .ref-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .ref-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .ref-card:hover .ref-card__media img {
    transform: scale(1.05);
  }
  .ref-card__count {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(15, 17, 21, 0.78);
    color: #fff;
    font-size: 0.8rem;
    font-family: var(--font-head);
    font-weight: 500;
    padding: 5px 11px;
    border-radius: 999px;
  }
  .ref-card__body {
    padding: 20px 22px 24px;
  }
  .ref-card__body h3 {
    margin: 0 0 6px;
  }
  .ref-card__body p {
    color: var(--muted);
    font-size: 0.96rem;
    margin: 0;
  }
</style>
