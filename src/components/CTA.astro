---
import { site } from '../data/site';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  text?: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const title = Astro.props.title ?? t('cta.band.title');
const text = Astro.props.text ?? t('cta.band.text');
---

<section class="section section--dark cta">
  <div class="container cta-inner">
    <div>
      <span class="eyebrow">{t('cta.band.eyebrow')}</span>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn--primary" href={localizePath('/kontakt/', lang)}>{t('cta.quote')}</a>
      <a class="btn btn--outline-light" href={`tel:${site.contact.phoneHref}`}>
        {t('cta.call')} {site.contact.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-inner {
    display: grid;
    gap: 30px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .cta-inner {
      grid-template-columns: 1.6fr 1fr;
    }
    .cta-actions {
      justify-self: end;
    }
  }
  .cta h2 {
    margin-bottom: 0.3em;
  }
  .cta .lead {
    margin-bottom: 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
