---
interface Props {
  images: string[];
  alt: string;
}
const { images, alt } = Astro.props;
---

<div class="gallery" data-gallery>
  {images.map((src, i) => (
    <button class="gallery-item" data-index={i} type="button" aria-label={`Åpne bilde ${i + 1}`}>
      <img src={src} alt={`${alt} – bilde ${i + 1}`} loading="lazy" decoding="async" />
    </button>
  ))}
</div>

<div class="lightbox" data-lightbox hidden aria-hidden="true">
  <button class="lb-close" data-lb-close aria-label="Lukk">×</button>
  <button class="lb-nav lb-prev" data-lb-prev aria-label="Forrige">‹</button>
  <img class="lb-img" data-lb-img src="" alt="" />
  <button class="lb-nav lb-next" data-lb-next aria-label="Neste">›</button>
  <span class="lb-count" data-lb-count></span>
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 640px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .gallery-item {
    padding: 0;
    border: 0;
    cursor: pointer;
    background: var(--surface);
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gallery-item:hover img {
    transform: scale(1.06);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(10, 12, 15, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lb-img {
    max-width: 92vw;
    max-height: 86vh;
    width: auto;
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
  }
  .lb-close,
  .lb-nav {
    position: absolute;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 0;
    cursor: pointer;
    border-radius: 50%;
    width: 52px;
    height: 52px;
    font-size: 30px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
  }
  .lb-close:hover,
  .lb-nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }
  .lb-close {
    top: 18px;
    right: 18px;
    font-size: 26px;
  }
  .lb-prev {
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-count {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    color: #cfd3d9;
    font-size: 0.9rem;
    font-family: var(--font-head);
  }
  @media (max-width: 640px) {
    .lb-prev {
      left: 8px;
    }
    .lb-next {
      right: 8px;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    const items = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery-item'));
    const imgs = items.map((b) => b.querySelector('img')!.getAttribute('src')!);
    const lb = gallery.parentElement!.querySelector<HTMLElement>('[data-lightbox]')!;
    if (!lb) return;
    const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = lb.querySelector<HTMLElement>('[data-lb-count]')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + imgs.length) % imgs.length;
      lbImg.src = imgs[current];
      lbImg.alt = `Bilde ${current + 1} av ${imgs.length}`;
      count.textContent = `${current + 1} / ${imgs.length}`;
    };
    const open = (i: number) => {
      show(i);
      lb.hidden = false;
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.hidden = true;
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    items.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
    lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
    lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  });
</script>
