---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/services';
---

<Layout
  title="Tjenester"
  description="Dekmar AS leverer alt innen tak og blikkenslagerarbeid – taktekking, takrenner, omlegging av tak, flate tak, membraner, snøfangere, pipebeslag og mer."
>
  <PageHero
    eyebrow="Tjenester"
    title="Alt innen tak og blikkenslagerarbeid"
    intro="Vi utfører alt innen takarbeid, takomlegging og reparasjoner samt ny taktekking. Vi har eget blikkenslagerverksted med egen serviceavdeling."
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
