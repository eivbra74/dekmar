---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title="Takk for henvendelsen" description="Takk – meldingen din er sendt.">
  <section class="section thanks">
    <div class="container">
      <div class="thanks-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="40" height="40"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5"/></svg>
      </div>
      <h1>Takk for henvendelsen!</h1>
      <p class="lead">
        Vi har mottatt meldingen din og tar kontakt så snart som mulig. Haster det, kan du ringe oss
        på <a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>.
      </p>
      <a class="btn btn--primary" href="/">Tilbake til forsiden</a>
    </div>
  </section>
</Layout>

<style>
  .thanks {
    text-align: center;
  }
  .thanks .container {
    max-width: 620px;
  }
  .thanks-icon {
    width: 76px;
    height: 76px;
    margin: 0 auto 24px;
    border-radius: 50%;
    background: rgba(204, 31, 42, 0.1);
    color: var(--brand);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
