---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---

<Layout
  title="Kontakt"
  description="Ta kontakt med Dekmar AS for en gratis og uforpliktende befaring. Vi hjelper deg med tak og blikkenslagerarbeid i Oslo og Viken."
>
  <PageHero
    eyebrow="Kontakt"
    title="Ta kontakt med oss"
    intro="Vi tilbyr gratis befaring med et påfølgende uforpliktende tilbud. Fyll ut skjemaet, eller ta kontakt direkte."
  />

  <section class="section">
    <div class="container contact-grid">
      <div>
        <h2>Send oss en melding</h2>
        <ContactForm />
      </div>

      <aside class="contact-info">
        <h2>Kontaktpersoner</h2>
        <div class="info-card">
          <h3>{site.contact.name}</h3>
          <p class="role">{site.contact.role}</p>
          <p>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />
            <a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>
          </p>
        </div>
        <div class="info-card">
          <h3>Generelt</h3>
          <p>
            E-post: <a href={`mailto:${site.email}`}>{site.email}</a><br />
            Område: {site.area}
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 44px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .contact-info h2 {
    margin-bottom: 18px;
  }
  .info-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 24px;
    margin-bottom: 18px;
  }
  .info-card h3 {
    margin: 0 0 4px;
    font-size: 1.15rem;
  }
  .info-card .role {
    color: var(--brand);
    font-weight: 600;
    margin: 0 0 10px;
  }
  .info-card p {
    margin: 0;
    line-height: 1.8;
  }
</style>
