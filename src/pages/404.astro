---
import Layout from '../layouts/Layout.astro';
---

<Layout lang="nb" title="404">
  <section class="section notfound">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>Denne siden fant vi ikke <span class="sep">·</span> Page not found</h1>
      <p class="lead">
        Siden kan ha blitt flyttet eller fjernet. <br />
        The page may have been moved or removed.
      </p>
      <div class="nf-actions">
        <a class="btn btn--primary" href="/">Til forsiden</a>
        <a class="btn btn--ghost" href="/en/">English home</a>
        <a class="btn btn--ghost" href="/kontakt/">Kontakt</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .notfound .container {
    max-width: 680px;
  }
  .sep {
    color: var(--muted);
    font-weight: 400;
    margin: 0 6px;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 26px;
  }
</style>
