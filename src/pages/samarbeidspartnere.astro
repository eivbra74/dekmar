---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';

const partners = [
  'Malermester',
  'Murmester',
  'Glassmester',
  'Elektriker',
  'Rørlegger',
  'Snekker',
  'Tømmermester',
  'Betong- og grunnarbeider',
  'Anleggsgartner',
];
---

<Layout
  title="Samarbeidspartnere"
  description="Dekmar samarbeider med de fleste typer håndverksfirmaer og kan påta seg totalentrepriser eller formidle kontakt med andre dyktige håndverkere."
>
  <PageHero eyebrow="Samarbeidspartnere" title="Vi tar hånd om hele prosjektet" />

  <section class="section">
    <div class="container narrow">
      <p class="lead">
        Dekmar samarbeider med de fleste typer håndverksfirmaer og kan påta oss totalentrepriser
        og/eller formidle kontakt med andre dyktige håndverkere.
      </p>
      <p>
        Vi samarbeider blant annet med malermester, murmester, glassmester, elektriker, rørlegger,
        snekker, tømmermestere, betong- og grunnarbeidere, anleggsgartner med flere.
      </p>

      <ul class="partner-grid">
        {partners.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .narrow {
    max-width: 760px;
  }
  .narrow .lead {
    color: var(--ink);
    font-size: 1.2rem;
  }
  .partner-grid {
    list-style: none;
    margin: 34px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .partner-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .partner-grid li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px 18px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.98rem;
  }
</style>
