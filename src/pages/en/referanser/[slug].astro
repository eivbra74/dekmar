---
import ReferenceDetail from '../../../components/pages/ReferenceDetail.astro';
import { references } from '../../../data/references';

export function getStaticPaths() {
  return references.map((reference) => ({
    params: { slug: reference.slug },
    props: { reference },
  }));
}

const { reference } = Astro.props;
---
<ReferenceDetail lang="en" reference={reference} />
