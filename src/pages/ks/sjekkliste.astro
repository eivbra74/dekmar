---
import KsLayout from '../../layouts/KsLayout.astro';
import { checklist, ksUi } from '../../data/ks';
const t = (k: string) => ksUi[k];
const d = (o: any) => ({ 'data-no': o.no, 'data-pl': o.pl, 'data-en': o.en });
const dph = (o: any) => ({ 'data-no-ph': o.no, 'data-pl-ph': o.pl, 'data-en-ph': o.en });
---

<KsLayout active="checklist" title="Sjekkliste">
  <div class="container ks-narrow">
    <h1 {...d(t('checklist'))}>{t('checklist').no}</h1>
    <p class="lead" {...d(t('ksIntro'))}>{t('ksIntro').no}</p>

    <form id="ks-form" class="ks-card-box">
      <div class="ks-meta">
        <label><span {...d(t('project'))}>{t('project').no}</span>
          <select id="p_project_sel" style="display:none"></select>
          <input id="p_project" type="text" {...dph({no:'F.eks. WTG57 Takrehabilitering', pl:'Np. WTG57 Remont dachu', en:'E.g. WTG57 Roof rehabilitation'})} /></label>
        <label><span {...d(t('address'))}>{t('address').no}</span>
          <input id="p_address" type="text" {...dph({no:'Adresse', pl:'Adres', en:'Address'})} /></label>
        <label><span {...d(t('date'))}>{t('date').no}</span>
          <input id="p_date" type="date" /></label>
        <label><span {...d(t('performedBy'))}>{t('performedBy').no}</span>
          <input id="p_by" type="text" {...dph({no:'Navn', pl:'Imię i nazwisko', en:'Name'})} /></label>
      </div>

      {checklist.map((sec) => (
        <fieldset class="ks-section">
          <legend {...d(sec.title)}>{sec.title.no}</legend>
          {sec.items.map((it) => (
            <div class="ks-item" data-sid={sec.id} data-iid={it.id}>
              <p class="ks-item__text" {...d(it.text)}>{it.text.no}</p>
              <div class="ks-item__controls">
                <div class="ks-radios">
                  <label class="ks-pill ks-pill--ok">
                    <input type="radio" name={`c_${sec.id}_${it.id}`} value="ok" />
                    <span {...d(t('ok'))}>{t('ok').no}</span>
                  </label>
                  <label class="ks-pill ks-pill--na">
                    <input type="radio" name={`c_${sec.id}_${it.id}`} value="na" />
                    <span {...d(t('na'))}>{t('na').no}</span>
                  </label>
                </div>
                <input class="ks-note" id={`n_${sec.id}_${it.id}`} type="text" {...dph(t('notePlaceholder'))} />
              </div>
            </div>
          ))}
        </fieldset>
      ))}

      <div class="ks-actions">
        <button type="button" id="ks-pdf" class="btn btn--primary" {...d(t('downloadPdf'))}>{t('downloadPdf').no}</button>
        <button type="button" id="ks-reset" class="btn btn--ghost" {...d(t('reset'))}>{t('reset').no}</button>
        <span id="ks-status" class="ks-savenote" aria-live="polite"></span>
      </div>
    </form>
  </div>

  <script type="application/json" id="ks-data" set:html={JSON.stringify({ checklist, ui: ksUi })} />
</KsLayout>

<style>
  .ks-narrow { max-width: 820px; }
  .ks-card-box { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(18px, 3vw, 30px); margin-top: 20px; }
  .ks-meta { display: grid; gap: 14px; grid-template-columns: 1fr; margin-bottom: 26px; }
  @media (min-width: 620px) { .ks-meta { grid-template-columns: 1fr 1fr; } }
  .ks-meta label { display: flex; flex-direction: column; gap: 6px; font-family: var(--font-head); font-weight: 600; font-size: 0.9rem; }
  .ks-meta input, .ks-meta select { font: inherit; padding: 11px 13px; border: 1px solid var(--line); border-radius: 9px; background: #fff; }
  .ks-section { border: 0; border-top: 2px solid var(--line); padding: 20px 0 4px; margin: 0; }
  .ks-section legend { font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; color: var(--brand); padding: 0; }
  .ks-item { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .ks-item:last-child { border-bottom: 0; }
  .ks-item__text { margin: 0 0 10px; font-weight: 500; }
  .ks-item__controls { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .ks-radios { display: inline-flex; gap: 8px; }
  .ks-pill { position: relative; }
  .ks-pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .ks-pill span {
    display: inline-block; padding: 8px 16px; border-radius: 999px;
    border: 1.5px solid var(--line); font-family: var(--font-head); font-weight: 600; font-size: 0.9rem; cursor: pointer;
  }
  .ks-pill--ok input:checked + span { background: #12855222; border-color: #128552; color: #0c6b42; }
  .ks-pill--na input:checked + span { background: var(--surface); border-color: var(--muted); color: var(--muted); }
  .ks-note { flex: 1; min-width: 160px; font: inherit; padding: 9px 12px; border: 1px solid var(--line); border-radius: 9px; }
  .ks-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 24px; }
  .ks-savenote { color: var(--muted); font-size: 0.88rem; }
</style>

<script>
  import { jsPDF } from 'jspdf';
  import { supabase } from '../../lib/ksSupabase';

  const dataEl = document.getElementById('ks-data');
  const KS = JSON.parse(dataEl!.textContent || '{}');
  const form = document.getElementById('ks-form') as HTMLFormElement;
  const status = document.getElementById('ks-status')!;
  const STORE = 'ks-checklist-v1';
  const lang = () => (window as any).ksLang || 'no';
  const tr = (k: string) => (KS.ui[k] ? KS.ui[k][lang()] : k);

  // ---- Lagre / laste (localStorage) ----
  const save = () => {
    const data: Record<string, string> = {};
    form.querySelectorAll<HTMLInputElement>('input').forEach((el) => {
      if (el.type === 'radio') { if (el.checked) data[el.name] = el.value; }
      else data[el.id] = el.value;
    });
    try { localStorage.setItem(STORE, JSON.stringify(data)); } catch (e) {}
    status.textContent = tr('saved');
    setTimeout(() => (status.textContent = ''), 1500);
  };
  const load = () => {
    let data: Record<string, string> = {};
    try { data = JSON.parse(localStorage.getItem(STORE) || '{}'); } catch (e) {}
    Object.entries(data).forEach(([k, v]) => {
      const radios = form.querySelectorAll<HTMLInputElement>(`input[name="${k}"]`);
      if (radios.length) { radios.forEach((r) => (r.checked = r.value === v)); }
      else { const el = document.getElementById(k) as HTMLInputElement | null; if (el) el.value = v; }
    });
  };
  form.addEventListener('input', save);
  document.getElementById('ks-reset')!.addEventListener('click', () => {
    if (!confirm(lang() === 'pl' ? 'Wyczyścić formularz?' : lang() === 'en' ? 'Clear the form?' : 'Nullstille skjemaet?')) return;
    form.reset();
    try { localStorage.removeItem(STORE); } catch (e) {}
  });

  // ---- PDF ----
  document.getElementById('ks-pdf')!.addEventListener('click', () => {
    const L = lang();
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    const pageW = 210, margin = 15, maxW = pageW - margin * 2;
    let y = margin;
    const line = (txt: string, size = 10, style = 'normal', gap = 5) => {
      doc.setFont('helvetica', style); doc.setFontSize(size);
      const parts = doc.splitTextToSize(txt, maxW);
      parts.forEach((p: string) => {
        if (y > 282) { doc.addPage(); y = margin; }
        doc.text(p, margin, y); y += gap;
      });
    };
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value || '';

    doc.setFillColor(20, 23, 28); doc.rect(0, 0, pageW, 22, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('helvetica', 'bold'); doc.setFontSize(15);
    doc.text('Dekmar AS', margin, 10);
    doc.setFontSize(11); doc.setFont('helvetica', 'normal');
    doc.text(tr('checklist') + ' – ' + tr('ksTitle'), margin, 16.5);
    doc.setTextColor(20, 23, 28); y = 30;

    line(`${tr('project')}: ${val('p_project')}`, 10, 'bold', 5.5);
    line(`${tr('address')}: ${val('p_address')}    ${tr('date')}: ${val('p_date')}`, 10, 'normal', 5.5);
    line(`${tr('performedBy')}: ${val('p_by')}`, 10, 'normal', 7);

    KS.checklist.forEach((sec: any) => {
      y += 2; doc.setDrawColor(204, 31, 42); doc.setLineWidth(0.5);
      if (y > 275) { doc.addPage(); y = margin; }
      doc.line(margin, y, margin + maxW, y); y += 5;
      line(sec.title[L], 12, 'bold', 6);
      sec.items.forEach((it: any) => {
        const sel = form.querySelector<HTMLInputElement>(`input[name="c_${sec.id}_${it.id}"]:checked`);
        const mark = sel ? (sel.value === 'ok' ? '[OK]' : '[' + tr('na') + ']') : '[  ]';
        const note = val(`n_${sec.id}_${it.id}`);
        line(`${mark}  ${it.text[L]}${note ? '  — ' + note : ''}`, 10, 'normal', 5);
      });
    });

    y += 8; if (y > 275) { doc.addPage(); y = margin; }
    doc.setDrawColor(220); doc.line(margin, y, margin + maxW, y); y += 6;
    line(tr('toContractor'), 9, 'italic', 5);

    const fn = `Dekmar_${tr('checklist')}_${val('p_project') || 'prosjekt'}`.replace(/[^a-z0-9]+/gi, '_');
    doc.save(fn + '.pdf');
  });

  // ---- Aktive prosjekter som nedtrekksmeny (deler oekt med portalen; fritekst som fallback) ----
  async function initProjectPicker() {
    const sel = document.getElementById('p_project_sel') as HTMLSelectElement | null;
    const inp = document.getElementById('p_project') as HTMLInputElement | null;
    if (!sel || !inp) return;
    let projects: any[] = [];
    try { const { data } = await supabase.from('projects').select('id,name,status').or('status.is.null,status.neq.delivered').order('name'); projects = data || []; } catch (_e) { projects = []; }
    if (!projects.length) { sel.style.display = 'none'; inp.style.display = ''; return; }
    const L = lang();
    const chooseLbl = L === 'pl' ? 'Wybierz projekt…' : L === 'en' ? 'Choose project…' : 'Velg prosjekt…';
    const otherLbl = L === 'pl' ? 'Inny (wpisz)…' : L === 'en' ? 'Other (type)…' : 'Annet (skriv selv)…';
    const opt = (v: string, label: string) => { const o = document.createElement('option'); o.value = v; o.textContent = label; return o; };
    sel.innerHTML = '';
    sel.appendChild(opt('', chooseLbl));
    projects.forEach((pr: any) => sel.appendChild(opt(pr.name, pr.name)));
    sel.appendChild(opt('__other', otherLbl));
    sel.style.display = '';
    const cur = inp.value.trim();
    if (cur && projects.some((pr: any) => pr.name === cur)) { sel.value = cur; inp.style.display = 'none'; }
    else if (cur) { sel.value = '__other'; inp.style.display = ''; }
    else { sel.value = ''; inp.style.display = 'none'; }
    sel.addEventListener('change', () => {
      if (sel.value === '__other') { inp.style.display = ''; inp.value = ''; inp.focus(); }
      else { inp.value = sel.value; inp.style.display = 'none'; }
      save();
    });
  }

  load();
  initProjectPicker();
</script>
