        const msg = document.getElementById('sha-msg')!;
        if (error) { msg.textContent = error.message; return; } msg.textContent = p('added'); renderShaPlan(projectId);
      });
      document.getElementById('sha-pdf')!.addEventListener('click', () => { sync(); makeShaPdf(d, pr, rev); });
    };
    draw();
  }

  // Gjoer en ferdig jsPDF om til base64 (uten data:-prefiks) for e-postvedlegg
  function pdfToBase64(doc: any): string { try { return (doc.output('datauristring') || '').split(',')[1] || ''; } catch (_e) { return ''; } }

  // Felles modal: last ned PDF-en ELLER send den paa e-post til HE/prosjekteier.
  // Alle makeXxxPdf-funksjonene ruter sitt sluttresultat gjennom denne.
  function deliverPdf(doc: any, filename: string, subjectPreset: string, opts: any = {}): Promise<void> {
    return new Promise((resolve) => {
      const ov = document.createElement('div');
      ov.className = 'pdf-ov';
      ov.innerHTML =
        `<div class="pdf-modal" role="dialog" aria-modal="true">` +
        `<div class="pdf-modal-hd"><h3>${esc(p('pdfReady'))}</h3><button class="pdf-modal-x" id="pm-x" aria-label="${esc(p('close'))}">×</button></div>` +
        `<div class="pdf-modal-bd">` +
        `<div class="pdf-modal-file">${esc(filename)}</div>` +
        `<button class="btn btn--ghost" id="pm-dl">${esc(p('downloadPdf'))}</button>` +
        `<div class="pdf-modal-sep">${esc(opts.sendLabel || p('orSendEmail'))}</div>` +
        `<div class="pdf-field"><label for="pm-to">${esc(p('emailTo'))}</label><input id="pm-to" type="email" placeholder="navn@firma.no"><span class="hint">${esc(p('emailToHint'))}</span></div>` +
        `<div class="pdf-field"><label for="pm-cc">${esc(p('emailCc'))}</label><input id="pm-cc" type="text"></div>` +
        `<div class="pdf-field"><label for="pm-sub">${esc(p('emailSubject'))}</label><input id="pm-sub" type="text"></div>` +
        `<div class="pdf-field"><label for="pm-msg">${esc(p('emailMessage'))}</label><textarea id="pm-msg"></textarea></div>` +
        `<div class="pdf-modal-msg" id="pm-st"></div>` +
        `<button class="btn btn--primary" id="pm-send">${esc(p('emailSend'))}</button>` +
        `</div></div>`;
      document.body.appendChild(ov);
      const q = (id: string) => ov.querySelector('#' + id) as HTMLInputElement;
      (q('pm-sub') as HTMLInputElement).value = subjectPreset || '';
      (q('pm-msg') as HTMLTextAreaElement).value = opts.messagePreset || p('emailDefaultMsg');
      if (opts.toPreset) (q('pm-to') as HTMLInputElement).value = opts.toPreset;
      const close = () => { ov.remove(); resolve(); };
      q('pm-x').addEventListener('click', close);
      ov.addEventListener('click', (e) => { if (e.target === ov) close(); });
      q('pm-dl').addEventListener('click', () => { try { doc.save(filename); } catch (_e) { /* ignore */ } });
      q('pm-send').addEventListener('click', async () => {
        const st = ov.querySelector('#pm-st') as HTMLElement;
        const to = (q('pm-to') as HTMLInputElement).value.trim();
        if (!to) { st.className = 'pdf-modal-msg err'; st.textContent = p('emailNeedTo'); return; }
        const btn = q('pm-send') as HTMLButtonElement; btn.disabled = true;
        st.className = 'pdf-modal-msg'; st.textContent = p('emailSending');
        try {
          const { data, error } = await supabase.functions.invoke('send-report', {
            body: {
              to, cc: (q('pm-cc') as HTMLInputElement).value.trim(),
              subject: (q('pm-sub') as HTMLInputElement).value.trim() || subjectPreset,
              message: (q('pm-msg') as HTMLTextAreaElement).value,
              pdfBase64: pdfToBase64(doc), pdfFilename: filename,
            },
          });
          let errMsg = error ? (error.message || 'error') : ((data && (data as any).error) || '');
          if (error && (error as any).context && typeof (error as any).context.json === 'function') {
            try { const b = await (error as any).context.json(); if (b && b.error) errMsg = b.error; } catch (_e) { /* ignore */ }
          }
          if (errMsg) { st.className = 'pdf-modal-msg err'; st.textContent = errMsg; btn.disabled = false; return; }
          st.className = 'pdf-modal-msg ok'; st.textContent = p('emailSent');
          setTimeout(close, 1300);
        } catch (e: any) { st.className = 'pdf-modal-msg err'; st.textContent = (e && e.message) || String(e); btn.disabled = false; }
      });
    });
  }

  async function makeShaPdf(d: any, pr: any, rev: number) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    await ensurePdfFont(doc);
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    const line = (txt: string, size = 10, style = 'normal', gap = 5, color: number[] = [20, 23, 28]) => {
      doc.setFont('DejaVu', style as any); doc.setFontSize(size); doc.setTextColor(color[0], color[1], color[2]);
      doc.splitTextToSize(txt || '', maxW).forEach((ln: string) => { if (y > 283) { doc.addPage(); y = margin; } doc.text(ln, margin, y); y += gap; });
    };
    const hd = (t: string) => { y += 3; if (y > 275) { doc.addPage(); y = margin; } doc.setDrawColor(204, 31, 42); doc.setLineWidth(0.5); doc.line(margin, y, margin + maxW, y); y += 5; line(t, 12, 'bold', 6); };
    doc.setFillColor(20, 23, 28); doc.rect(0, 0, pageW, 24, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('DejaVu', 'bold'); doc.setFontSize(16); doc.text('Dekmar AS', margin, 11);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(11); doc.text('SHA-plan – plan for sikkerhet, helse og arbeidsmiljø', margin, 18);
    y = 32;
    line(`${pr?.name || ''}`, 13, 'bold', 6);
    line([pr?.address, pr?.client].filter(Boolean).join(' · '), 10, 'normal', 6, [90, 96, 104]);
    line(`${p('revLabel')} ${rev}    ${fmt(new Date().toISOString())}`, 9.5, 'normal', 6, [90, 96, 104]);
    if (d.description) { hd(p('shaProjectDesc')); line(d.description, 10, 'normal', 5); }
    hd(p('shaOrg'));
    (d.roles || []).forEach((r: any) => { if (r.role || r.company || r.contact) line(`${r.role}: ${[r.company, r.contact].filter(Boolean).join(' – ')}`, 10, 'normal', 5); });
    hd(p('shaProgress'));
    (d.milestones || []).forEach((m: any) => line(`${m.name}: ${m.date || '—'}`, 10, 'normal', 5));
    hd(p('shaSpecificT'));
    (d.specific || []).forEach((s: any, i: number) => {
      line(`${i + 1}. ${s.activity || ''}`, 10.5, 'bold', 5.5);
      if (s.risk) line(`${p('colRisk')}: ${s.risk}`, 9.5, 'normal', 4.6, [90, 96, 104]);
      if (s.measure) line(`${p('colMeasure')}: ${s.measure}`, 10, 'normal', 5);
      if (s.responsible) line(`${p('colResponsible')}: ${s.responsible}`, 9.5, 'normal', 5, [90, 96, 104]);
      y += 1.5;
    });
    hd(p('shaPreventiveT'));
    (d.preventive || []).forEach((v: any, i: number) => line(`${i + 1}. ${v.measure || ''}${v.responsible ? '  (' + v.responsible + ')' : ''}`, 10, 'normal', 5));
    await deliverPdf(doc, `Dekmar_SHA-plan_${(pr?.name || '')}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `SHA-plan – ${pr?.name || ''}`);
  }

  // downscale image File -> {blob, dataUrl}
  function shrink(file: File): Promise<{ blob: Blob; dataUrl: string }> {
    return new Promise((res) => {
      const img = new Image(); const url = URL.createObjectURL(file);
      img.onload = () => {
        const max = 1400; let { width: w, height: h } = img;
        if (w > max || h > max) { const r = Math.min(max / w, max / h); w = Math.round(w * r); h = Math.round(h * r); }
        const c = document.createElement('canvas'); c.width = w; c.height = h;
        c.getContext('2d')!.drawImage(img, 0, 0, w, h);
        URL.revokeObjectURL(url);
        c.toBlob((b) => res({ blob: b!, dataUrl: c.toDataURL('image/jpeg', 0.72) }), 'image/jpeg', 0.72);
      };
      img.onerror = () => { URL.revokeObjectURL(url); res({ blob: file, dataUrl: '' }); };
      img.src = url;
    });
  }

  function setupDeviationForm(projectId: string, existing: any[]) {
    const pending: { blob: Blob; dataUrl: string }[] = [];
    const thumbs = document.getElementById('d-thumbs')!;
    const input = document.getElementById('d-photos') as HTMLInputElement;
    const msg = document.getElementById('d-status-msg')!;
    // forhåndsfyll avviksmelder med innlogget bruker
    const repEl = document.getElementById('d-reporter') as HTMLInputElement | null;
    if (repEl && !repEl.value) currentEmailSafe().then((e) => { if (e && !repEl.value) repEl.value = e; });
    input?.addEventListener('change', async () => {
      for (const f of Array.from(input.files || [])) { const s = await shrink(f); pending.push(s); }
      input.value = '';
      thumbs.innerHTML = pending.map((x) => `<div class="p-thumb"><img src="${x.dataUrl}"></div>`).join('');
    });
    document.getElementById('d-save')!.addEventListener('click', async () => {
      const val = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() || null;
      const btn = document.getElementById('d-save') as HTMLButtonElement;
      btn.disabled = true; msg.textContent = p('saving');
      const { data: u } = await supabase.auth.getUser();
      const statusVal = (document.getElementById('d-status') as HTMLSelectElement).value;
      const { data: dev, error } = await supabase.from('deviations').insert({
        project_id: projectId, number: val('d-no'), dev_date: val('d-date'),
        location: val('d-loc'), description: val('d-desc'), cause: val('d-cause'),
        correction: val('d-corr'), verification: val('d-verif'), responsible: val('d-resp'),
        reporter: val('d-reporter'), improvement: val('d-improve'), preventive: val('d-prevent'),
        reporter_informed: val('d-informed'),
        category: (document.getElementById('d-cat') as HTMLSelectElement).value || null,
        severity: (document.getElementById('d-sev') as HTMLSelectElement).value || null,
        due_date: val('d-due'), status: statusVal,
        closed_at: statusVal === 'closed' ? new Date().toISOString() : null,
        created_by: u.user?.id,
      }).select().single();
      if (error) { alert(error.message); btn.disabled = false; msg.textContent = ''; return; }
      if (pending.length) {
        msg.textContent = p('uploading');
        for (const ph of pending) {
          const path = `${projectId}/${dev.id}/${crypto.randomUUID()}.jpg`;
          const up = await supabase.storage.from(KS_PHOTO_BUCKET).upload(path, ph.blob, { contentType: 'image/jpeg' });
          if (!up.error) await supabase.from('photos').insert({ project_id: projectId, deviation_id: dev.id, storage_path: path, created_by: u.user?.id });
        }
      }
      openProject(projectId);
    });

    // Klikk på et eksisterende avvik → lag PDF
    root.querySelectorAll('.p-item[data-dev]').forEach((el) =>
      el.addEventListener('click', () => {
        const d = existing.find((x) => x.id === (el as HTMLElement).dataset.dev);
        if (d) makeDeviationPdf(d);
      }));
  }

  // Bygg inn en Unicode-font (DejaVu Sans) i PDF-ene så æøå og polske tegn (ł/ś/ż osv.) vises riktig.
  let PDF_FONT_CACHE: { reg: string; bold: string } | null = null;
  async function ensurePdfFont(doc: any) {
    try {
      if (!PDF_FONT_CACHE) {
        const toB64 = (buf: ArrayBuffer) => {
          const bytes = new Uint8Array(buf); let bin = '';
          for (let i = 0; i < bytes.length; i += 0x8000) bin += String.fromCharCode.apply(null, Array.from(bytes.subarray(i, i + 0x8000)) as any);
          return btoa(bin);
        };
        const [r, b] = await Promise.all([
          fetch('/fonts/DejaVuSans.ttf').then((x) => x.arrayBuffer()),
          fetch('/fonts/DejaVuSans-Bold.ttf').then((x) => x.arrayBuffer()),
        ]);
        PDF_FONT_CACHE = { reg: toB64(r), bold: toB64(b) };
      }
      doc.addFileToVFS('DejaVuSans.ttf', PDF_FONT_CACHE.reg);
      doc.addFont('DejaVuSans.ttf', 'DejaVu', 'normal');
      doc.addFileToVFS('DejaVuSans-Bold.ttf', PDF_FONT_CACHE.bold);
      doc.addFont('DejaVuSans-Bold.ttf', 'DejaVu', 'bold');
      doc.setFont('DejaVu', 'normal');
    } catch (_e) { /* faller tilbake til standardfont */ }
  }

  async function makeDeviationPdf(d: any) {
    // hent bilder (signerte URL-er) og konverter til dataURL
    const { data: phRows } = await supabase.from('photos').select('*').eq('deviation_id', d.id);
    const imgs: string[] = [];
    for (const ph of phRows || []) {
      const { data: signed } = await supabase.storage.from(KS_PHOTO_BUCKET).createSignedUrl(ph.storage_path, 120);
      if (signed?.signedUrl) {
        try {
          const blob = await (await fetch(signed.signedUrl)).blob();
          imgs.push(await new Promise<string>((r) => { const fr = new FileReader(); fr.onload = () => r(fr.result as string); fr.readAsDataURL(blob); }));
        } catch (e) {}
      }
    }
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    await ensurePdfFont(doc);
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    const block = (label: string, txt: string) => {
      if (!txt) return;
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(9.5); doc.setTextColor(120);
      if (y > 275) { doc.addPage(); y = margin; }
      doc.text(label.toUpperCase(), margin, y); y += 4.5;
      doc.setFont('DejaVu', 'normal'); doc.setFontSize(10.5); doc.setTextColor(20, 23, 28);
      doc.splitTextToSize(txt, maxW).forEach((ln: string) => { if (y > 282) { doc.addPage(); y = margin; } doc.text(ln, margin, y); y += 5; }); y += 3;
    };
    doc.setFillColor(20, 23, 28); doc.rect(0, 0, pageW, 24, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('DejaVu', 'bold'); doc.setFontSize(16); doc.text('Dekmar AS', margin, 11);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(11); doc.text(t('deviation') + ' – ' + t('handoverTitle'), margin, 18);
    doc.setTextColor(20, 23, 28); y = 32;
    const stTxt = devStatusLabel(d.status);
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(11);
    doc.text(`${t('devNo')}: ${d.number || '—'}    ${t('date')}: ${d.dev_date || '—'}    ${t('status')}: ${stTxt}`, margin, y); y += 6;
    const meta2 = [d.category ? `${p('devCategory')}: ${devCatLabel(d.category)}` : '', d.severity ? `${p('severity')}: ${devSeverityLabel(d.severity)}` : '', d.due_date ? `${p('dueDate')}: ${d.due_date}` : ''].filter(Boolean).join('    ');
    if (meta2) { doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.text(meta2, margin, y); y += 6; }
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(8.5); doc.setTextColor(120); doc.text('Iht. Internkontrollforskriften § 5', margin, y); y += 6; doc.setTextColor(20, 23, 28);
    const sec = (title: string) => { if (y > 270) { doc.addPage(); y = margin; } y += 1; doc.setDrawColor(204, 31, 42); doc.setLineWidth(0.4); doc.line(margin, y, margin + maxW, y); y += 5; doc.setFont('DejaVu', 'bold'); doc.setFontSize(10.5); doc.setTextColor(204, 31, 42); doc.text(title, margin, y); y += 6; doc.setTextColor(20, 23, 28); };
    sec(p('devSecReporter'));
    block(p('devReporter'), d.reporter); block(t('location'), d.location); block(t('description'), d.description);
    block(t('correction'), d.correction); block(p('devImprovement'), d.improvement);
    sec(p('devSecHandler'));
    block(t('responsible'), d.responsible); block(t('cause'), d.cause);
    block(p('devPreventive'), d.preventive); block(t('verification'), d.verification);
    if (d.reporter_informed) block(p('devReporterInformed'), d.reporter_informed);
    if (d.closed_at) block(p('devClosedDate'), fmt(d.closed_at));
    if (imgs.length) {
      if (y > 250) { doc.addPage(); y = margin; }
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(9.5); doc.setTextColor(120); doc.text(t('photos').toUpperCase(), margin, y); y += 5; doc.setTextColor(20, 23, 28);
      const colW = (maxW - 6) / 2, rowH = colW * 0.72; let col = 0;
      imgs.forEach((src) => {
        if (y + rowH > 285) { doc.addPage(); y = margin; col = 0; }
        const x = margin + col * (colW + 6);
        try { doc.addImage(src, 'JPEG', x, y, colW, rowH); } catch (e) {}
        doc.setDrawColor(220); doc.rect(x, y, colW, rowH);
        if (col === 1) { y += rowH + 6; col = 0; } else col = 1;
      });
    }
    await deliverPdf(doc, `Dekmar_Avvik_${(d.number || 'nr')}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `Avviksrapport ${d.number || ''} – ${CURRENT_PROJECT?.name || ''}`.trim());
  }

