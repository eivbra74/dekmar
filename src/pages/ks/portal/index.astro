        <tbody id="d-body"></tbody></table></div>`;
    document.getElementById('d-back')!.addEventListener('click', renderProjects);
    document.getElementById('doc-save')!.addEventListener('click', async () => {
      const fileInp = document.getElementById('doc-file') as HTMLInputElement;
      const file = fileInp.files?.[0];
      const msg = document.getElementById('doc-msg')!;
      if (!file) { msg.textContent = p('file') + '?'; return; }
      const btn = document.getElementById('doc-save') as HTMLButtonElement; btn.disabled = true; msg.textContent = p('uploading');
      const { data: u } = await supabase.auth.getUser();
      const safe = file.name.replace(/[^a-z0-9._-]+/gi, '_');
      const path = `docs/${crypto.randomUUID()}_${safe}`;
      const up = await supabase.storage.from('ks-docs').upload(path, file, { contentType: file.type || 'application/octet-stream' });
      if (up.error) { alert(up.error.message); btn.disabled = false; msg.textContent = ''; return; }
      const { error } = await supabase.from('documents').insert({
        title: (document.getElementById('doc-title') as HTMLInputElement).value.trim() || file.name,
        category: (document.getElementById('doc-cat') as HTMLSelectElement).value,
        project_id: (document.getElementById('doc-proj') as HTMLSelectElement).value || null,
        file_name: file.name, mime: file.type, file_size: file.size, storage_path: path, uploaded_by: u.user?.id,
      });
      if (error) { alert(error.message); btn.disabled = false; msg.textContent = ''; return; }
      renderDocuments();
    });
    const draw = () => {
      const q = (document.getElementById('d-search') as HTMLInputElement).value.toLowerCase();
      const cat = (document.getElementById('d-cat') as HTMLSelectElement).value;
      const sort = (document.getElementById('d-sort') as HTMLSelectElement).value;
      let list = ((window as any).__docs as any[])
        .filter((r) => !cat || r.category === cat)
        .filter((r) => { const hay = `${r.title || ''} ${r.projects?.name || ''} ${catLabel(r.category)}`.toLowerCase(); return !q || hay.includes(q); });
      list = list.slice().sort((a, b) => {
        if (sort === 'dnew') return b.created_at.localeCompare(a.created_at);
        if (sort === 'dold') return a.created_at.localeCompare(b.created_at);
        if (sort === 'title') return (a.title || '').localeCompare(b.title || '');
        return 0;
      });
      const tbody = document.getElementById('d-body')!;
      tbody.innerHTML = list.length ? list.map((r) => `
        <tr data-doc="${esc(r.id)}">
          <td>${esc(fmt(r.created_at))}</td><td>${esc(r.title)}</td><td>${esc(catLabel(r.category))}</td>
          <td>${esc(r.projects?.name || '—')}</td><td>${esc((window as any).__docNames[r.uploaded_by] || '')}</td>
          <td><span class="p-muted">${esc(p('download'))} ↓</span></td>
        </tr>`).join('') : `<tr><td colspan="6" class="p-muted">${esc(((window as any).__docs as any[]).length ? p('noResults') : p('noDocuments'))}</td></tr>`;
      tbody.querySelectorAll('tr[data-doc]').forEach((tr) => tr.addEventListener('click', async () => {
        const r = ((window as any).__docs as any[]).find((x) => x.id === (tr as HTMLElement).dataset.doc);
        if (!r) return;
        const { data: signed } = await supabase.storage.from('ks-docs').createSignedUrl(r.storage_path, 120, { download: r.file_name || true });
        if (signed?.signedUrl) window.open(signed.signedUrl, '_blank');
      }));
    };
    ['d-search', 'd-cat', 'd-sort'].forEach((id) => document.getElementById(id)!.addEventListener('input', draw));
    draw();
  }

  // ================= Pristilbud + kunderegister =================
  const nok = (n: number) => (isFinite(n) ? n : 0).toLocaleString('nb-NO', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  const numv = (v: any) => { const n = parseFloat(String(v).replace(/\s/g, '').replace(',', '.')); return isFinite(n) ? n : 0; };
  const qStatusLabel = (s: string) => (({ draft: p('qStatusDraft'), sent: p('qStatusSent'), accepted: p('qStatusAccepted'), declined: p('qStatusDeclined') } as any)[s] || s);

  async function seedQuoteElements() {
    try {
      if (!QUOTE_ELEMENTS_SEEDED) {
        const { data: existing } = await supabase.from('quote_elements').select('slug');
        const have = new Set((existing || []).map((x: any) => x.slug));
        const missing = STD_QUOTE_ELEMENTS.filter((e: any) => !have.has(e.slug));
        if (missing.length) await supabase.from('quote_elements').insert(missing.map((e: any) => ({ category: e.category, spec: e.spec, unit: e.unit, price: e.price, slug: e.slug, sort: e.sort, is_standard: true })));
        QUOTE_ELEMENTS_SEEDED = true;
      }
    } catch (_e) { /* ignore */ }
    const { data } = await supabase.from('quote_elements').select('*').order('sort').order('category');
    QUOTE_ELEMENTS = data && data.length ? data : STD_QUOTE_ELEMENTS;
  }

  let LOGO_CACHE: string | null = null;
  async function ensureLogo(): Promise<string> {
    if (LOGO_CACHE !== null) return LOGO_CACHE;
    try {
      const blob = await (await fetch('/dekmar-logo.png')).blob();
      LOGO_CACHE = await new Promise<string>((r) => { const fr = new FileReader(); fr.onload = () => r(fr.result as string); fr.readAsDataURL(blob); });
    } catch (_e) { LOGO_CACHE = ''; }
    return LOGO_CACHE;
  }

