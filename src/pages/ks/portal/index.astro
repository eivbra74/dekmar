---
import KsLayout from '../../../layouts/KsLayout.astro';
import { ksUi, checklist, safetyRound } from '../../../data/ks';
import { standardTemplates } from '../../../data/ksTemplates';
import { standardArticles } from '../../../data/ksArticles';
import { standardFdv } from '../../../data/ksFdv';
import { shaRoles, shaMilestones, shaSpecific, shaPreventive } from '../../../data/ksSha';
import { handbooks } from '../../../data/ksHandbooks';
import { standardQuoteElements, standardTerms, quoteLetter } from '../../../data/ksQuote';
import { standardMaterials } from '../../../data/ksCalc';
import { hseFormTypes } from '../../../data/ksForms';
---

<KsLayout active="portal" title="Portal">
  <div class="container">
    <div id="portal-root" class="portal-root">
      <p class="portal-loading">Laster …</p>
    </div>
  </div>
  <script type="application/json" id="ks-data" set:html={JSON.stringify({ ui: ksUi, checklist, safetyRound, standardTemplates, standardArticles, standardFdv, sha: { roles: shaRoles, milestones: shaMilestones, specific: shaSpecific, preventive: shaPreventive }, quoteElements: standardQuoteElements, quoteTerms: standardTerms, quoteLetter, materials: standardMaterials, hseFormTypes })} />
  <script type="application/json" id="ks-handbooks" set:html={JSON.stringify(handbooks)} />
</KsLayout>

<style is:global>
  .portal-root { max-width: 1180px; margin-inline: auto; }
  .portal-loading { color: var(--muted); }
  /* App-skall */
  .app { display: grid; grid-template-columns: 236px minmax(0,1fr); gap: 28px; align-items: start; }
  .app-scrim { display: none; }
  .app-side { position: sticky; top: 84px; align-self: start; background: var(--dark); color: #e8ebf0; border-radius: 16px; padding: 16px 12px; display: flex; flex-direction: column; gap: 4px; max-height: calc(100vh - 104px); overflow: auto; }
  .app-brand { display: flex; align-items: center; gap: 10px; padding: 6px 10px 16px; }
  .app-brand-mark { font-family: var(--font-head); font-weight: 800; letter-spacing: .12em; color: #ff8a91; font-size: .78rem; border: 1.5px solid #ff8a9155; border-radius: 6px; padding: 3px 7px; }
  .app-brand-name { font-family: var(--font-head); font-weight: 700; font-size: 1.05rem; color: #fff; }
  .app-nav { display: flex; flex-direction: column; gap: 2px; }
  .app-nav-item { display: flex; align-items: center; gap: 11px; width: 100%; text-align: left; background: transparent; border: 0; color: #c7cdd7; font: inherit; font-family: var(--font-head); font-weight: 600; font-size: .94rem; padding: 10px 12px; border-radius: 10px; cursor: pointer; transition: background .15s, color .15s; }
  .app-nav-item:hover { background: rgba(255,255,255,.07); color: #fff; }
  .app-nav-item.is-active { background: var(--brand); color: #fff; }
  .app-nav-ic { display: inline-flex; width: 20px; height: 20px; flex: 0 0 20px; }
  .app-nav-ic svg { width: 100%; height: 100%; }
  .app-side-foot { margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.1); display: flex; flex-direction: column; gap: 6px; }
  .app-user { font-size: .8rem; color: #9aa2af; padding: 0 12px; word-break: break-all; }
  .app-logout { display: flex; align-items: center; gap: 11px; background: transparent; border: 0; color: #c7cdd7; font: inherit; font-family: var(--font-head); font-weight: 600; font-size: .92rem; padding: 10px 12px; border-radius: 10px; cursor: pointer; }
  .app-logout:hover { background: rgba(255,255,255,.07); color: #fff; }
  .app-body { min-width: 0; }
  .app-topbar { display: none; }
  .app-main { min-width: 0; }
  .p-subhead { font-family: var(--font-head); font-weight: 700; font-size: .9rem; margin: 18px 0 8px; padding-top: 12px; border-top: 1px solid var(--line); color: var(--ink); }
  /* PDF-lever / send-modal */
  .pdf-ov { position: fixed; inset: 0; z-index: 200; background: rgba(10,12,16,.55); display: flex; align-items: center; justify-content: center; padding: 20px; }
  .pdf-modal { background: #fff; border-radius: 16px; width: 100%; max-width: 520px; max-height: calc(100vh - 40px); overflow: auto; box-shadow: 0 24px 60px rgba(10,12,16,.3); }
  .pdf-modal-hd { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 20px; border-bottom: 1px solid var(--line); }
  .pdf-modal-hd h3 { margin: 0; font-family: var(--font-head); font-size: 1.12rem; }
  .pdf-modal-x { background: transparent; border: 0; font-size: 1.5rem; line-height: 1; color: var(--muted); cursor: pointer; padding: 0 4px; }
  .pdf-modal-bd { padding: 18px 20px; display: flex; flex-direction: column; gap: 14px; }
  .pdf-modal-file { font-size: .86rem; color: var(--muted); word-break: break-all; }
  .pdf-modal-sep { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: .82rem; }
  .pdf-modal-sep::before, .pdf-modal-sep::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .pdf-field { display: flex; flex-direction: column; gap: 5px; }
  .pdf-field label { font-family: var(--font-head); font-weight: 600; font-size: .84rem; }
  .pdf-field input, .pdf-field textarea { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 9px 11px; font: inherit; box-sizing: border-box; }
  .pdf-field textarea { min-height: 78px; resize: vertical; }
  .pdf-field .hint { font-size: .76rem; color: var(--muted); }
  .pdf-modal-msg { font-size: .86rem; min-height: 1.2em; }
  .pdf-modal-msg.ok { color: #1a7f37; }
  .pdf-modal-msg.err { color: var(--brand); }
  @media (max-width: 860px) {
    .app { display: block; }
    .app-topbar { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
    .app-burger { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border: 1px solid var(--line); border-radius: 10px; background: #fff; cursor: pointer; color: var(--ink); }
    .app-burger svg { width: 22px; height: 22px; }
    .app-topbar-title { font-family: var(--font-head); font-weight: 800; font-size: 1.15rem; }
    .app-side { position: fixed; top: 0; left: 0; bottom: 0; z-index: 60; width: 272px; border-radius: 0; max-height: none; transform: translateX(-100%); transition: transform .22s ease; }
    .app-scrim { position: fixed; inset: 0; background: rgba(10,12,16,.5); z-index: 55; opacity: 0; pointer-events: none; transition: opacity .22s; }
    .app[data-drawer="open"] .app-side { transform: translateX(0); }
    .app[data-drawer="open"] .app-scrim { display: block; opacity: 1; pointer-events: auto; }
  }
  /* Oversikt */
  .dash-hero { margin-bottom: 22px; }
  .dash-hero h1 { margin: 0 0 4px; }
  .dash-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin-bottom: 24px; }
  .dash-stat { text-align: left; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; cursor: pointer; transition: border-color .15s, transform .15s; }
  .dash-stat:hover { border-color: var(--ink); transform: translateY(-1px); }
  .dash-stat-n { display: block; font-family: var(--font-head); font-weight: 800; font-size: 2rem; line-height: 1; }
  .dash-stat-l { display: block; margin-top: 6px; color: var(--muted); font-size: .85rem; }
  .dash-stat.is-alert .dash-stat-n { color: var(--brand-dark); }
  .dash-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(258px,1fr)); gap: 14px; }
  .dash-card { display: flex; align-items: flex-start; gap: 14px; text-align: left; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 18px; cursor: pointer; transition: border-color .15s, box-shadow .15s, transform .15s; }
  .dash-card:hover { border-color: var(--ink); box-shadow: 0 6px 20px rgba(20,23,28,.07); transform: translateY(-2px); }
  .dash-card-ic { display: inline-flex; width: 40px; height: 40px; flex: 0 0 40px; align-items: center; justify-content: center; border-radius: 12px; background: var(--surface); color: var(--brand); }
  .dash-card-ic svg { width: 22px; height: 22px; }
  .dash-card-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .dash-card-title { font-family: var(--font-head); font-weight: 700; font-size: 1.02rem; }
  .dash-card-badge { display: inline-block; margin-left: 4px; background: var(--brand); color: #fff; font-size: .72rem; font-weight: 700; border-radius: 999px; padding: 1px 8px; vertical-align: middle; }
  .dash-card-desc { color: var(--muted); font-size: .88rem; line-height: 1.45; }
  .dash-card-go { color: var(--muted); display: inline-flex; width: 18px; height: 18px; align-self: center; }
  .dash-card-go svg { width: 100%; height: 100%; }
  .p-go { color: var(--muted); display: inline-flex; width: 18px; height: 18px; }
  .p-go svg { width: 100%; height: 100%; }
  .p-searchbar { position: relative; margin: 4px 0 16px; }
  .p-searchbar-ic { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: var(--muted); pointer-events: none; }
  .p-searchbar-ic svg { width: 100%; height: 100%; }
  .p-searchbar input { width: 100%; font: inherit; padding: 11px 14px 11px 42px; border: 1px solid var(--line); border-radius: 10px; background: #fff; }
  .p-searchbar input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgba(20,23,28,.08); }
  @media (max-width: 560px) { .dash-stats { gap: 8px; } .dash-stat { padding: 12px; } .dash-stat-n { font-size: 1.5rem; } }
  .p-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(18px,3vw,28px); }
  .p-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }
  .p-head h1 { margin: 0; }
  .p-user { display: flex; align-items: center; gap: 12px; font-size: 0.9rem; color: var(--muted); }
  .p-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; font-family: var(--font-head); font-weight: 600; font-size: 0.9rem; }
  .p-field input, .p-field textarea, .p-field select { font: inherit; font-weight: 400; padding: 11px 13px; border: 1px solid var(--line); border-radius: 9px; width: 100%; }
  .p-grid2 { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
  @media (max-width: 560px){ .p-grid2 { grid-template-columns: 1fr; } }
  .p-list { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .p-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; background: #fff; cursor: pointer; }
  .p-item:hover { border-color: var(--ink); }
  .p-item h3 { margin: 0 0 2px; font-size: 1.05rem; }
  .p-item p { margin: 0; color: var(--muted); font-size: 0.88rem; }
  .p-badge { font-family: var(--font-head); font-weight: 700; font-size: 0.72rem; padding: 4px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.04em; }
  .p-badge.open { background: #cc1f2a18; color: var(--brand-dark); }
  .p-badge.closed { background: #12855222; color: #0c6b42; }
  .p-badge.progress { background: #b4690e22; color: #8a4b00; }
  .p-stats { display: grid; grid-template-columns: repeat(auto-fit,minmax(120px,1fr)); gap: 12px; margin-top: 12px; }
  .p-stat { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 16px; text-align: center; }
  .p-stat-n { display: block; font-family: var(--font-head); font-weight: 800; font-size: 1.9rem; line-height: 1; }
  .p-stat-l { display: block; margin-top: 6px; font-size: 0.82rem; color: var(--muted); }
  .p-stat.open .p-stat-n { color: var(--brand-dark); }
  .p-stat.progress .p-stat-n { color: #8a4b00; }
  .p-stat.closed .p-stat-n { color: #0c6b42; }
  .p-catrow { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid var(--line); }
  .p-catrow:last-child { border-bottom: 0; }
  .hb-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(280px,1fr)); gap: 14px; }
  .hb-card { display: flex; align-items: center; gap: 14px; text-align: left; background: var(--dark); color: #eef1f5; border: 0; border-radius: 14px; padding: 18px; cursor: pointer; transition: transform .15s, box-shadow .15s; }
  .hb-card:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(20,23,28,.18); }
  .hb-ic { display: inline-flex; width: 40px; height: 40px; flex: 0 0 40px; align-items: center; justify-content: center; border-radius: 11px; background: rgba(255,255,255,.1); color: #ff8a91; }
  .hb-ic svg { width: 22px; height: 22px; }
  .hb-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .hb-title { font-family: var(--font-head); font-weight: 700; font-size: 1rem; }
  .hb-meta { font-size: .8rem; color: #aab2bd; word-break: break-all; }
  .hb-go { font-family: var(--font-head); font-weight: 700; font-size: .82rem; color: #ff8a91; white-space: nowrap; }
  .hb-review { background: #12855218; color: #0c6b42; border: 1px solid #12855244; border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; font-size: .9rem; }
  .hb-review.overdue { background: #cc1f2a14; color: var(--brand-dark); border-color: #cc1f2a44; font-weight: 600; }
  .hb-chap { background: #fff; border: 1px solid var(--line); border-radius: 10px; margin-bottom: 8px; }
  .hb-chap > summary { cursor: pointer; padding: 14px 16px; font-family: var(--font-head); font-weight: 700; font-size: 1.02rem; list-style: none; }
  .hb-chap > summary::-webkit-details-marker { display: none; }
  .hb-chap > summary::before { content: '›'; display: inline-block; margin-right: 10px; color: var(--muted); transition: transform .15s; }
  .hb-chap[open] > summary::before { transform: rotate(90deg); }
  .hb-chap .p-article { padding: 0 18px 16px; }
  .p-article { line-height: 1.65; }
  .p-article h3 { font-size: 1.1rem; margin: 18px 0 6px; }
  .p-article p { margin: 0 0 12px; }
  .p-article ul { margin: 0 0 12px; padding-left: 20px; }
  .p-article li { margin-bottom: 5px; }
  .p-muted { color: var(--muted); font-size: 0.92rem; }
  .p-err { color: var(--brand-dark); font-size: 0.9rem; margin: 8px 0 0; }
  .p-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .p-thumbs { display: grid; grid-template-columns: repeat(auto-fill,minmax(84px,1fr)); gap: 8px; margin-top: 10px; }
  .p-thumb { aspect-ratio: 1; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); position: relative; }
  .p-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .p-section { margin-top: 30px; }
  .p-section > h2 { font-size: 1.25rem; }
  details.p-new { border: 1px dashed var(--line); border-radius: 10px; padding: 14px 16px; margin-top: 14px; }
  details.p-new summary { cursor: pointer; font-family: var(--font-head); font-weight: 700; color: var(--brand); }
  details.p-new[open] summary { margin-bottom: 14px; }
  .p-login { max-width: 400px; margin: 6vh auto 0; }
  /* Skjema-avkryssing (sjekkliste/vernerunde) */
  .p-cl-sec { border: 0; border-top: 2px solid var(--line); padding: 14px 0 2px; margin: 0; }
  .p-cl-sec legend { font-family: var(--font-head); font-weight: 700; color: var(--brand); padding: 0; font-size: 1rem; }
  .p-cl-item { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .p-cl-item:last-child { border-bottom: 0; }
  .p-cl-text { margin: 0 0 8px; font-weight: 500; }
  .ks-radios { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .ks-pill { position: relative; }
  .ks-pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .ks-pill span { display: inline-block; padding: 7px 15px; border-radius: 999px; border: 1.5px solid var(--line); font-family: var(--font-head); font-weight: 600; font-size: 0.88rem; cursor: pointer; }
  .ks-pill--ok input:checked + span { background: #12855222; border-color: #128552; color: #0c6b42; }
  .ks-pill--na input:checked + span { background: var(--surface); border-color: var(--muted); color: var(--muted); }
  .ks-pill--dev input:checked + span { background: #cc1f2a18; border-color: var(--brand); color: var(--brand-dark); }
  .p-cl-note { flex: 1; min-width: 150px; font: inherit; padding: 8px 11px; border: 1px solid var(--line); border-radius: 8px; }
  /* Maler */
  .p-tpl { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin-bottom: 14px; }
  .p-tpl-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .p-tpl-head h3 { margin: 0; }
  .p-tpl-cats-label { margin: 12px 0 6px; font-weight: 600; font-size: 0.85rem; font-family: var(--font-head); }
  .p-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .p-chip { background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 4px 10px; font-size: 0.8rem; }
  .p-sm { padding: 6px 12px; font-size: 0.82rem; }
  .p-grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 8px; }
  .p-grid3 input { font: inherit; padding: 9px 11px; border: 1px solid var(--line); border-radius: 8px; width: 100%; }
  @media (max-width: 560px) { .p-grid3 { grid-template-columns: 1fr; } }
  .p-grid-inline { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
  .p-grid-inline input { flex: 1; }
  .p-tpl-edit-sec { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; margin: 10px 0; }
  /* Stoffkartotek + jobbdokumentasjon */
  .p-checks { display: grid; grid-template-columns: repeat(auto-fill,minmax(190px,1fr)); gap: 6px 14px; margin-bottom: 14px; }
  .p-check { display: flex; align-items: center; gap: 7px; font-size: 0.9rem; font-weight: 400; }
  .p-check input { width: auto; }
  .p-jd-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(150px,1fr)); gap: 12px; margin-top: 14px; }
  .p-jd-photo { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: #fff; display: flex; flex-direction: column; }
  .p-jd-photo img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .p-jd-cap { padding: 8px 10px; font-size: 0.82rem; color: var(--muted); flex: 1; }
  .p-jd-photo .btn { margin: 0 10px 10px; }
  /* Arkiv */
  .p-filters { display: flex; gap: 10px; flex-wrap: wrap; margin: 18px 0; }
  .p-filters input, .p-filters select { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; }
  .p-filters #a-search { flex: 1; min-width: 200px; }
  .p-tablewrap { overflow-x: auto; }
  .p-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .p-table th, .p-table td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line); font-size: 0.94rem; white-space: nowrap; }
  .p-table th { font-family: var(--font-head); font-weight: 700; background: var(--surface); }
  .p-table tbody tr[data-form] { cursor: pointer; }
  .p-table tbody tr[data-form]:hover { background: var(--surface); }
  .p-table tbody tr[data-q], .p-table tbody tr[data-doc] { cursor: pointer; }
  .p-table tbody tr[data-q]:hover { background: var(--surface); }
  .q-badge { display: inline-block; padding: 3px 9px; border-radius: 999px; font-size: .78rem; font-weight: 700; font-family: var(--font-head); }
  .q-draft { background: #eceef1; color: #5a606c; }
  .q-sent { background: #e7f0fb; color: #1a5fb4; }
  .q-accepted { background: #e4f4e8; color: #1a7f37; }
  .q-declined { background: #fdeaec; color: var(--brand); }
  .p-badge.is-done { background: #e4f4e8; color: #1a7f37; font-size: .72rem; padding: 2px 8px; border-radius: 999px; vertical-align: middle; }
  /* Tilbudslinjer */
  .ql-table { width: 100%; border-collapse: collapse; margin: 8px 0; }
  .ql-table th { text-align: left; font-family: var(--font-head); font-size: .78rem; color: var(--muted); font-weight: 700; padding: 4px 6px; }
  .ql-table td { padding: 3px 4px; vertical-align: top; }
  .ql-table input { width: 100%; border: 1px solid var(--line); border-radius: 8px; padding: 7px 8px; font: inherit; box-sizing: border-box; }
  .ql-spec { min-width: 220px; }
  .ql-num { width: 92px; }
  .ql-sum { text-align: right; white-space: nowrap; padding-top: 12px; font-variant-numeric: tabular-nums; }
  .ql-del { background: transparent; border: 0; color: var(--muted); cursor: pointer; font-size: 1.1rem; padding: 6px; }
  .ql-del:hover { color: var(--brand); }
  .ql-totals { margin: 10px 0; display: flex; flex-direction: column; gap: 3px; align-items: flex-end; font-variant-numeric: tabular-nums; }
  .ql-totals .grand { font-size: 1.1rem; font-weight: 800; font-family: var(--font-head); }
  .q-term { display: flex; gap: 9px; align-items: flex-start; padding: 6px 0; border-bottom: 1px solid var(--line); }
  .q-term textarea { flex: 1; border: 1px solid var(--line); border-radius: 8px; padding: 7px 9px; font: inherit; min-height: 40px; resize: vertical; }
  .q-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .p-logo { height: 40px; width: auto; }
  .calc-tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--line); margin: 6px 0 18px; flex-wrap: wrap; }
  .calc-tab { background: transparent; border: 0; border-bottom: 2.5px solid transparent; color: var(--muted); font: inherit; font-family: var(--font-head); font-weight: 600; padding: 9px 12px; cursor: pointer; }
  .calc-tab.is-active { color: var(--ink); border-bottom-color: var(--brand); }
