  async function makeChemicalsPdf(rows: any[]) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    await ensurePdfFont(doc);
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    doc.setFillColor(20, 23, 28); doc.rect(0, 0, pageW, 22, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('DejaVu', 'bold'); doc.setFontSize(15); doc.text('Dekmar AS', margin, 10);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(11); doc.text(`${p('chemicals')} – ${CURRENT_PROJECT?.name || ''}`, margin, 16.5);
    doc.setTextColor(20, 23, 28); y = 30;
    rows.forEach((c: any) => {
      if (y > 265) { doc.addPage(); y = margin; }
      doc.setDrawColor(204, 31, 42); doc.line(margin, y, margin + maxW, y); y += 5;
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(11); doc.text(`${c.name}${c.signal_word ? ' (' + c.signal_word + ')' : ''}`, margin, y); y += 5;
      doc.setFont('DejaVu', 'normal'); doc.setFontSize(9.5);
      const meta = [c.supplier, c.use_area, c.quantity, c.location].filter(Boolean).join('  ·  ');
      if (meta) { doc.text(meta, margin, y); y += 5; }
      const haz = (c.hazards || '').split(',').filter(Boolean).map((h: string) => ghsLabel(h)).join(', ');
      if (haz) { doc.text(`${p('hazardsLabel')}: ${haz}`, margin, y); y += 5; }
      if (c.notes) { doc.splitTextToSize(c.notes, maxW).forEach((ln: string) => { if (y > 285) { doc.addPage(); y = margin; } doc.text(ln, margin, y); y += 4.5; }); }
      y += 2;
    });
    await deliverPdf(doc, `Dekmar_Stoffkartotek_${CURRENT_PROJECT?.name || ''}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `Stoffkartotek – ${CURRENT_PROJECT?.name || ''}`);
  }

