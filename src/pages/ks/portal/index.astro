        <div><h1>${esc(p('templatesTitle'))}</h1><p class="p-muted">${esc(p('standardTemplatesLabel'))}</p></div>
        <div class="p-user"><button class="btn btn--primary" id="tpl-new">${esc(p('newTemplate'))}</button><button class="btn btn--ghost" id="tpl-back">${esc(p('back'))}</button></div>
      </div>
      ${TEMPLATES.map(card).join('') || `<p class="p-muted">${esc(p('noTemplatesYet'))}</p>`}`;
