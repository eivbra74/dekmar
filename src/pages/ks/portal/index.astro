        </div>
        <label class="p-field">${esc(p('forProject'))}<select id="doc-proj"><option value="">${esc(p('common'))}</option>${projOpts}</select></label>
        <button class="btn btn--primary" id="doc-save" type="button">${esc(p('save'))}</button>
        <span class="p-muted" id="doc-msg" style="margin-left:10px"></span>
      </details>
      <div class="p-filters">
