  async function createOrdersFromCalc(state: any, PROJ: any[]) {
    const mats = state.lines.filter((l: any) => l.type === 'material' && (l.spec || '').trim());
    if (!mats.length) { const m = document.getElementById('ce-msg'); if (m) m.textContent = p('noMaterials'); return; }
    const bySupplier: Record<string, any[]> = {};
    mats.forEach((l: any) => { const s = l.supplier || '—'; (bySupplier[s] = bySupplier[s] || []).push({ name: l.spec, article_no: l.article_no || '', unit: l.unit || '', qty: numv(l.qty) }); });
    const { data: u } = await supabase.auth.getUser();
    const year = new Date().getFullYear();
    for (const sup of Object.keys(bySupplier)) {
      const { data: mx } = await supabase.from('purchase_orders').select('number').like('number', `B-${year}-%`).order('number', { ascending: false }).limit(1);
      let seq = 1; if (mx && mx[0] && mx[0].number) { const mm = String(mx[0].number).match(/B-\d+-(\d+)/); if (mm) seq = (+mm[1]) + 1; }
      const number = `B-${year}-${String(seq).padStart(3, '0')}`;
      await supabase.from('purchase_orders').insert({ number, supplier: sup, project_id: state.project_id || null, calc_id: state.id || null, items: bySupplier[sup], status: 'draft', created_by: u.user?.id });
    }
    CALC_TAB = 'orders'; renderCalc();
  }

