  async function duplicateTemplate(tp: any) {
    if (!tp) return;
    const { data: u } = await supabase.auth.getUser();
    await supabase.from('templates').insert({
      slug: null, name: `${tp.name} ${p('copySuffix')}`, kind: tp.kind, description: tp.description,
      is_standard: false, sections: tp.sections, sort: (tp.sort || 0) + 1, created_by: u.user?.id,
    });
    await loadTemplates(); renderTemplates();
  }

  // Enkel mal-editor. Egne maler lagres med samme tekst i alle tre språk.
  function renderTemplateEditor(tp: any) {
    redraw = () => renderTemplateEditor(tp);
    const isNew = !tp;
    const model = tp ? JSON.parse(JSON.stringify(tp)) : { name: '', kind: 'verneround', description: '', sections: [] };
    const secHtml = (s: any, si: number) => `
      <fieldset class="p-cl-sec p-tpl-edit-sec" data-si="${si}">
        <div class="p-grid-inline">
          <input class="te-sec-title" data-si="${si}" type="text" placeholder="${esc(p('sectionTitleLabel'))}" value="${esc(s.title?.[lang()] || s.title?.no || '')}">
          <button type="button" class="btn btn--ghost p-sm te-sec-del" data-si="${si}">${esc(p('removeLabel'))}</button>
        </div>
        <div class="te-items">
          ${(s.items || []).map((it: any, ii: number) => `
            <div class="p-grid-inline te-item-row" data-si="${si}" data-ii="${ii}">
              <input class="te-item-text" data-si="${si}" data-ii="${ii}" type="text" placeholder="${esc(p('itemTextLabel'))}" value="${esc(it.text?.[lang()] || it.text?.no || '')}">
              <button type="button" class="btn btn--ghost p-sm te-item-del" data-si="${si}" data-ii="${ii}">${esc(p('removeLabel'))}</button>
            </div>`).join('')}
        </div>
        <button type="button" class="btn btn--ghost p-sm te-item-add" data-si="${si}">${esc(p('addItem'))}</button>
      </fieldset>`;
    const draw = () => {
      root.innerHTML = `
        <div class="p-head">
          <h1>${esc(isNew ? p('newTemplate').replace('+ ', '') : p('edit'))}</h1>
          <div class="p-user"><button class="btn btn--ghost" id="te-back">${esc(p('back'))}</button></div>
        </div>
        <div class="p-card">
          <div class="p-grid2">
            <label class="p-field">${esc(p('templateName'))}<input id="te-name" type="text" value="${esc(model.name)}"></label>
            <label class="p-field">${esc(p('templateKind'))}
              <select id="te-kind">
                <option value="verneround"${model.kind === 'verneround' ? ' selected' : ''}>${esc(p('kindVerneround'))}</option>
                <option value="checklist"${model.kind === 'checklist' ? ' selected' : ''}>${esc(p('kindChecklist'))}</option>
              </select>
            </label>
          </div>
          <label class="p-field">${esc(p('descriptionLabel'))}<textarea id="te-desc" rows="2">${esc(model.description || '')}</textarea></label>
          <div id="te-secs">${model.sections.map(secHtml).join('')}</div>
          <button type="button" class="btn btn--ghost" id="te-add-sec">${esc(p('addSection'))}</button>
          <div style="margin-top:16px"><button class="btn btn--primary" id="te-save" type="button">${esc(p('save'))}</button>
          <span class="p-muted" id="te-msg" style="margin-left:10px"></span></div>
        </div>`;
      // sync current inputs into model before re-render
      const sync = () => {
        model.name = (document.getElementById('te-name') as HTMLInputElement).value;
        model.kind = (document.getElementById('te-kind') as HTMLSelectElement).value;
        model.description = (document.getElementById('te-desc') as HTMLTextAreaElement).value;
        root.querySelectorAll<HTMLInputElement>('.te-sec-title').forEach((el) => {
          const si = +el.dataset.si!; if (model.sections[si]) model.sections[si]._t = el.value;
        });
        root.querySelectorAll<HTMLInputElement>('.te-item-text').forEach((el) => {
          const si = +el.dataset.si!, ii = +el.dataset.ii!; if (model.sections[si]?.items[ii]) model.sections[si].items[ii]._t = el.value;
        });
      };
      document.getElementById('te-back')!.addEventListener('click', renderTemplates);
      document.getElementById('te-add-sec')!.addEventListener('click', () => { sync(); model.sections.push({ id: 's' + Date.now().toString(36), title: {}, items: [] }); applyPending(); draw(); });
      root.querySelectorAll<HTMLElement>('.te-sec-del').forEach((b) => b.addEventListener('click', () => { sync(); model.sections.splice(+b.dataset.si!, 1); applyPending(); draw(); }));
      root.querySelectorAll<HTMLElement>('.te-item-add').forEach((b) => b.addEventListener('click', () => { sync(); model.sections[+b.dataset.si!].items.push({ id: 'i' + Date.now().toString(36), text: {} }); applyPending(); draw(); }));
      root.querySelectorAll<HTMLElement>('.te-item-del').forEach((b) => b.addEventListener('click', () => { sync(); model.sections[+b.dataset.si!].items.splice(+b.dataset.ii!, 1); applyPending(); draw(); }));
      document.getElementById('te-save')!.addEventListener('click', async () => { sync(); applyPending(); await saveTemplate(); });
    };
    // flytt _t (redigert tekst) inn i {no,pl,en} for hver seksjon/punkt
    const applyPending = () => {
      model.sections.forEach((s: any) => {
        if (s._t !== undefined) { const v = s._t; s.title = { no: v, pl: v, en: v }; delete s._t; if (!s.id) s.id = 's' + Math.random().toString(36).slice(2, 8); }
        (s.items || []).forEach((it: any) => { if (it._t !== undefined) { const v = it._t; it.text = { no: v, pl: v, en: v }; delete it._t; if (!it.id) it.id = 'i' + Math.random().toString(36).slice(2, 8); } });
      });
    };
    const saveTemplate = async () => {
      const msg = document.getElementById('te-msg')!;
      if (!model.name.trim()) { msg.textContent = p('nameRequired'); return; }
      const { data: u } = await supabase.auth.getUser();
      const payload: any = { name: model.name.trim(), kind: model.kind, description: model.description || null, sections: model.sections, is_standard: false };
      let error;
      if (isNew) { ({ error } = await supabase.from('templates').insert({ ...payload, slug: null, created_by: u.user?.id })); }
      else { ({ error } = await supabase.from('templates').update(payload).eq('id', model.id)); }
      if (error) { msg.textContent = error.message; return; }
      await loadTemplates(); renderTemplates();
    };
    draw();
  }

  // ---------- Arkiv (alle lagrede sjekklister/vernerunder) ----------
  async function renderArchive() {
    redraw = renderArchive;
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const { data: rows } = await supabase.from('checklists').select('*, projects(name)').order('created_at', { ascending: false });
    (window as any).__arch = rows || [];
    root.innerHTML = `
      <div class="p-head">
        <h1>${esc(p('archive'))}</h1>
        <div class="p-user"><button class="btn btn--ghost" id="a-back">${esc(p('back'))}</button></div>
      </div>
      <div class="p-filters">
        <input id="a-search" type="search" placeholder="${esc(p('search'))}">
        <select id="a-type"><option value="">${esc(p('typeAll'))}</option><option value="checklist">${esc(t('checklist'))}</option><option value="verneround">${esc(t('verneround'))}</option></select>
        <select id="a-sort"><option value="dnew">${esc(p('dateNewest'))}</option><option value="dold">${esc(p('dateOldest'))}</option><option value="proj">${esc(p('byProject'))}</option><option value="perf">${esc(p('byPerformer'))}</option></select>
      </div>
      <div class="p-tablewrap"><table class="p-table">
        <thead><tr><th>${esc(p('colDate'))}</th><th>${esc(p('colProject'))}</th><th>${esc(p('colType'))}</th><th>${esc(p('colPerformer'))}</th><th></th></tr></thead>
        <tbody id="a-body"></tbody>
      </table></div>`;
    document.getElementById('a-back')!.addEventListener('click', renderProjects);
    const draw = () => {
      const q = (document.getElementById('a-search') as HTMLInputElement).value.toLowerCase();
      const ty = (document.getElementById('a-type') as HTMLSelectElement).value;
      const sort = (document.getElementById('a-sort') as HTMLSelectElement).value;
      let list = ((window as any).__arch as any[])
        .filter((r) => !ty || r.type === ty)
        .filter((r) => { const hay = `${r.projects?.name || ''} ${r.performed_by || ''} ${r.title || ''}`.toLowerCase(); return !q || hay.includes(q); });
      const key = (r: any) => r.performed_date || r.created_at;
      list = list.slice().sort((a, b) => {
        if (sort === 'dnew') return key(b).localeCompare(key(a));
        if (sort === 'dold') return key(a).localeCompare(key(b));
        if (sort === 'proj') return (a.projects?.name || '').localeCompare(b.projects?.name || '');
        if (sort === 'perf') return (a.performed_by || '').localeCompare(b.performed_by || '');
        return 0;
      });
      const tbody = document.getElementById('a-body')!;
      tbody.innerHTML = list.length ? list.map((r) => `
        <tr data-form="${esc(r.id)}">
          <td>${esc(r.performed_date || fmt(r.created_at))}</td>
          <td>${esc(r.projects?.name || '')}</td>
          <td>${esc(r.type === 'verneround' ? t('verneround') : t('checklist'))}</td>
          <td>${esc(r.performed_by || '')}</td>
          <td><span class="p-muted">PDF ›</span></td>
        </tr>`).join('') : `<tr><td colspan="5" class="p-muted">${esc(p('noResults'))}</td></tr>`;
      tbody.querySelectorAll('tr[data-form]').forEach((tr) =>
        tr.addEventListener('click', () => {
          const r = ((window as any).__arch as any[]).find((x) => x.id === (tr as HTMLElement).dataset.form);
          if (r) { const items = r.sections && r.sections.length ? r.sections : (r.type === 'verneround' ? SAFETYROUND : CHECKLIST); makeFormPdf(r, items, r.type === 'verneround' ? t('verneround') : t('checklist'), r.projects?.name); }
        }));
    };
    ['a-search', 'a-type', 'a-sort'].forEach((id) => document.getElementById(id)!.addEventListener('input', draw));
    draw();
  }

  // ---------- Ansatte / invitasjon ----------
  async function renderTeam() {
    redraw = renderTeam;
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const { data: profs } = await supabase.from('profiles').select('id, full_name, created_at').order('created_at');
    const rows = (profs || []).map((pr: any) => `
      <li class="p-item" style="cursor:default"><div><h3>${esc(pr.full_name || '—')}</h3><p>${esc(p('createdAt'))} ${esc(fmt(pr.created_at))}</p></div></li>`).join('');
    root.innerHTML = `
      <div class="p-head"><h1>${esc(p('team'))}</h1>
        <div class="p-user"><button class="btn btn--ghost" id="t-back">${esc(p('back'))}</button></div></div>
      <div class="p-card">
        <h2 style="margin-top:0">${esc(p('invite'))}</h2>
        <form id="inv">
          <label class="p-field">${esc(p('inviteEmail'))}<input id="inv-email" type="email" required></label>
          <button class="btn btn--primary" type="submit">${esc(p('sendInvite'))}</button>
          <span class="p-muted" id="inv-msg" style="margin-left:10px"></span>
        </form>
      </div>
      <div class="p-section"><h2>${esc(p('members'))}</h2>${rows ? `<ul class="p-list">${rows}</ul>` : ''}</div>`;
    document.getElementById('t-back')!.addEventListener('click', renderProjects);
    (document.getElementById('inv') as HTMLFormElement).addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('inv-email') as HTMLInputElement).value.trim();
      const msg = document.getElementById('inv-msg')!;
      const btn = (e.target as HTMLFormElement).querySelector('button')!; btn.setAttribute('disabled', 'true'); msg.textContent = '…';
      const { data, error } = await supabase.functions.invoke('invite-user', { body: { email } });
      btn.removeAttribute('disabled');
      if (error || (data && data.error)) {
        // supabase-js gir en generisk feilmelding; hent den faktiske teksten fra svarkroppen
        let detail = data?.error || error?.message || 'Feil';
        try { const body = await (error as any)?.context?.json?.(); if (body?.error) detail = body.error; } catch (_e) { /* ignore */ }
        if (/already.*registered/i.test(detail)) detail = p('alreadyMember');
        msg.textContent = detail;
      }
      else { msg.textContent = p('inviteSent') + ' ' + email; (document.getElementById('inv-email') as HTMLInputElement).value = ''; }
    });
  }

  // ---------- Dokumentbibliotek ----------
  async function renderDocuments() {
    redraw = renderDocuments;
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const [docsRes, projRes, profRes] = await Promise.all([
      supabase.from('documents').select('*, projects(name)').order('created_at', { ascending: false }),
      supabase.from('projects').select('id,name').order('name'),
      supabase.from('profiles').select('id,full_name'),
    ]);
    const docs = docsRes.data || [];
    (window as any).__docs = docs;
    const nameById: Record<string, string> = {};
    (profRes.data || []).forEach((pr: any) => { nameById[pr.id] = pr.full_name; });
    (window as any).__docNames = nameById;
    const projOpts = (projRes.data || []).map((pr: any) => `<option value="${esc(pr.id)}">${esc(pr.name)}</option>`).join('');
    const catOpts = DOCCATS.map((c) => `<option value="${esc(c.v)}">${esc((c as any)[lang()])}</option>`).join('');
    root.innerHTML = `
      <div class="p-head"><h1>${esc(p('documents'))}</h1>
        <div class="p-user"><button class="btn btn--ghost" id="d-back">${esc(p('back'))}</button></div></div>
      <details class="p-new"><summary>${esc(p('newDocument'))}</summary>
        <label class="p-field">${esc(p('file'))}<input id="doc-file" type="file"></label>
        <div class="p-grid2">
          <label class="p-field">${esc(p('docTitle'))}<input id="doc-title" type="text"></label>
          <label class="p-field">${esc(p('category'))}<select id="doc-cat">${catOpts}</select></label>
        </div>
        <label class="p-field">${esc(p('forProject'))}<select id="doc-proj"><option value="">${esc(p('common'))}</option>${projOpts}</select></label>
        <button class="btn btn--primary" id="doc-save" type="button">${esc(p('save'))}</button>
        <span class="p-muted" id="doc-msg" style="margin-left:10px"></span>
      </details>
      <div class="p-filters">
        <input id="d-search" type="search" placeholder="${esc(p('search'))}">
        <select id="d-cat"><option value="">${esc(p('allCategories'))}</option>${catOpts}</select>
        <select id="d-sort"><option value="dnew">${esc(p('dateNewest'))}</option><option value="dold">${esc(p('dateOldest'))}</option><option value="title">${esc(p('colTitle'))}</option></select>
      </div>
      <div class="p-tablewrap"><table class="p-table">
        <thead><tr><th>${esc(p('colDate'))}</th><th>${esc(p('colTitle'))}</th><th>${esc(p('colCategory'))}</th><th>${esc(p('colProject'))}</th><th>${esc(p('uploadedBy'))}</th><th></th></tr></thead>
        <tbody id="d-body"></tbody></table></div>`;
    document.getElementById('d-back')!.addEventListener('click', renderProjects);
    document.getElementById('doc-save')!.addEventListener('click', async () => {
      const fileInp = document.getElementById('doc-file') as HTMLInputElement;
      const file = fileInp.files?.[0];
      const msg = document.getElementById('doc-msg')!;
      if (!file) { msg.textContent = p('file') + '?'; return; }
      const btn = document.getElementById('doc-save') as HTMLButtonElement; btn.disabled = true; msg.textContent = p('uploading');
      const { data: u } = await supabase.auth.getUser();
      const safe = file.name.replace(/[^a-z0-9._-]+/gi, '_');
      const path = `docs/${crypto.randomUUID()}_${safe}`;
      const up = await supabase.storage.from('ks-docs').upload(path, file, { contentType: file.type || 'application/octet-stream' });
      if (up.error) { alert(up.error.message); btn.disabled = false; msg.textContent = ''; return; }
      const { error } = await supabase.from('documents').insert({
        title: (document.getElementById('doc-title') as HTMLInputElement).value.trim() || file.name,
        category: (document.getElementById('doc-cat') as HTMLSelectElement).value,
        project_id: (document.getElementById('doc-proj') as HTMLSelectElement).value || null,
        file_name: file.name, mime: file.type, file_size: file.size, storage_path: path, uploaded_by: u.user?.id,
      });
      if (error) { alert(error.message); btn.disabled = false; msg.textContent = ''; return; }
      renderDocuments();
    });
    const draw = () => {
      const q = (document.getElementById('d-search') as HTMLInputElement).value.toLowerCase();
      const cat = (document.getElementById('d-cat') as HTMLSelectElement).value;
      const sort = (document.getElementById('d-sort') as HTMLSelectElement).value;
      let list = ((window as any).__docs as any[])
        .filter((r) => !cat || r.category === cat)
        .filter((r) => { const hay = `${r.title || ''} ${r.projects?.name || ''} ${catLabel(r.category)}`.toLowerCase(); return !q || hay.includes(q); });
      list = list.slice().sort((a, b) => {
        if (sort === 'dnew') return b.created_at.localeCompare(a.created_at);
        if (sort === 'dold') return a.created_at.localeCompare(b.created_at);
        if (sort === 'title') return (a.title || '').localeCompare(b.title || '');
        return 0;
      });
      const tbody = document.getElementById('d-body')!;
      tbody.innerHTML = list.length ? list.map((r) => `
        <tr data-doc="${esc(r.id)}">
          <td>${esc(fmt(r.created_at))}</td><td>${esc(r.title)}</td><td>${esc(catLabel(r.category))}</td>
          <td>${esc(r.projects?.name || '—')}</td><td>${esc((window as any).__docNames[r.uploaded_by] || '')}</td>
          <td><span class="p-muted">${esc(p('download'))} ↓</span></td>
        </tr>`).join('') : `<tr><td colspan="6" class="p-muted">${esc(((window as any).__docs as any[]).length ? p('noResults') : p('noDocuments'))}</td></tr>`;
      tbody.querySelectorAll('tr[data-doc]').forEach((tr) => tr.addEventListener('click', async () => {
        const r = ((window as any).__docs as any[]).find((x) => x.id === (tr as HTMLElement).dataset.doc);
        if (!r) return;
        const { data: signed } = await supabase.storage.from('ks-docs').createSignedUrl(r.storage_path, 120, { download: r.file_name || true });
        if (signed?.signedUrl) window.open(signed.signedUrl, '_blank');
      }));
    };
    ['d-search', 'd-cat', 'd-sort'].forEach((id) => document.getElementById(id)!.addEventListener('input', draw));
    draw();
  }

  route();
</script>
