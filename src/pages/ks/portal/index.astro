  // ---------- Projects ----------
  async function renderProjects() {
    redraw = renderProjects;
    await ensureShell('projects');
    root.innerHTML = `<p class="portal-loading">${esc(t('generating') || '…')}</p>`;
    const { data: projects, error } = await supabase.from('projects').select('*').order('created_at', { ascending: false });
    const all = projects || [];
    const activeAll = all.filter((pr: any) => pr.status !== 'delivered');
    const archivedAll = all.filter((pr: any) => pr.status === 'delivered');
    const rowHtml = (pr: any) => `
      <li class="p-item" data-id="${esc(pr.id)}">
        <div><h3>${esc(pr.name)}${pr.status === 'delivered' ? ` <span class="p-badge is-done">${esc(p('deliveredBadge'))}</span>` : ''}</h3><p>${esc([pr.address, pr.client].filter(Boolean).join(' · '))}</p></div>
        <span class="p-go">${ICONS.chevron}</span>
      </li>`;
    root.innerHTML = `
      <div class="p-head"><h1>${esc(p('projects'))}</h1></div>
      ${error ? `<p class="p-err">${esc(error.message)}</p>` : ''}
      ${all.length ? `<div class="p-searchbar"><span class="p-searchbar-ic">${ICONS.search}</span><input id="pl-search" type="search" placeholder="${esc(p('searchProjects'))}" autocomplete="off"></div>` : ''}
      <ul class="p-list" id="pl-list">${activeAll.map(rowHtml).join('') || `<p class="p-muted">${esc(p('noProjects'))}</p>`}</ul>
      ${archivedAll.length ? `<details class="p-new" id="pl-archwrap"><summary>${esc(p('archivedProjects'))} (${archivedAll.length})</summary><ul class="p-list" id="pl-arch">${archivedAll.map(rowHtml).join('')}</ul></details>` : ''}
      <details class="p-new">
        <summary>${esc(p('newProject'))}</summary>
        <form id="np">
          <label class="p-field">${esc(p('projName'))}<input id="np-name" type="text" required></label>
          <div class="p-grid2">
            <label class="p-field">${esc(t('address'))}<input id="np-addr" type="text"></label>
            <label class="p-field">${esc(p('client'))}<input id="np-client" type="text"></label>
          </div>
          <button class="btn btn--primary" type="submit">${esc(p('create'))}</button>
        </form>
      </details>`;
    const listEl = document.getElementById('pl-list')!;
    const archEl = document.getElementById('pl-arch');
    const bind = (el: Element) => el.querySelectorAll('.p-item').forEach((li) => li.addEventListener('click', () => openProject((li as HTMLElement).dataset.id!)));
    const paintList = (q: string) => {
      const term = q.trim().toLowerCase();
      const flt = (arr: any[]) => term ? arr.filter((pr: any) => [pr.name, pr.address, pr.client].filter(Boolean).join(' ').toLowerCase().includes(term)) : arr;
      const shownA = flt(activeAll);
      listEl.innerHTML = shownA.length ? shownA.map(rowHtml).join('') : `<li class="p-muted" style="list-style:none;padding:8px 2px">${esc(p('noResults'))}</li>`;
      bind(listEl);
      if (archEl) { const shownB = flt(archivedAll); archEl.innerHTML = shownB.map(rowHtml).join('') || `<li class="p-muted" style="list-style:none;padding:8px 2px">${esc(p('noArchived'))}</li>`; bind(archEl); }
    };
    paintList('');
    const searchEl = document.getElementById('pl-search') as HTMLInputElement | null;
    if (searchEl) searchEl.addEventListener('input', () => paintList(searchEl.value));
    (document.getElementById('np') as HTMLFormElement).addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('np-name') as HTMLInputElement).value.trim();
      if (!name) return;
      const { data: u } = await supabase.auth.getUser();
      const { error } = await supabase.from('projects').insert({
        name,
        address: (document.getElementById('np-addr') as HTMLInputElement).value.trim() || null,
        client: (document.getElementById('np-client') as HTMLInputElement).value.trim() || null,
        created_by: u.user?.id,
      });
      if (error) alert(error.message); else renderProjects();
    });
  }

  // ---------- Project detail ----------
  async function openProject(id: string) {
    redraw = () => openProject(id);
    await ensureShell('projects');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const { data: pr } = await supabase.from('projects').select('*').eq('id', id).single();
    CURRENT_PROJECT = pr;
    const { data: devs } = await supabase.from('deviations').select('*').eq('project_id', id).order('created_at', { ascending: false });
    await ensureDevConfig();
    const devRows = (devs || []).map((d: any) => `
