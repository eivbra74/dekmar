      document.getElementById('sha-addsp')!.addEventListener('click', () => { sync(); d.specific.push({ activity: '', risk: '', measure: '', responsible: '' }); draw(); });
      document.getElementById('sha-addpv')!.addEventListener('click', () => { sync(); d.preventive.push({ measure: '', responsible: '' }); draw(); });
      root.querySelectorAll<HTMLElement>('[data-spdel]').forEach((b) => b.addEventListener('click', () => { sync(); d.specific.splice(+b.dataset.spdel!, 1); draw(); }));
      root.querySelectorAll<HTMLElement>('[data-pvdel]').forEach((b) => b.addEventListener('click', () => { sync(); d.preventive.splice(+b.dataset.pvdel!, 1); draw(); }));
      document.getElementById('sha-save')!.addEventListener('click', async () => {
        sync(); const { data: u } = await supabase.auth.getUser();
