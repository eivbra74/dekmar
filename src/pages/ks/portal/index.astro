  async function makeJobDocPdf(projectId: string) {
    const { data: rows } = await supabase.from('photos').select('*').eq('project_id', projectId).is('deviation_id', null).order('created_at');
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    await ensurePdfFont(doc);
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    doc.setFillColor(20, 23, 28); doc.rect(0, 0, pageW, 24, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('DejaVu', 'bold'); doc.setFontSize(16); doc.text('Dekmar AS', margin, 11);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(11); doc.text(`${p('jobdoc')} – ${CURRENT_PROJECT?.name || ''}`, margin, 18);
    doc.setTextColor(20, 23, 28); y = 32;
    const phaseName = (ph: string) => ph === 'before' ? p('phaseBefore') : ph === 'during' ? p('phaseDuring') : ph === 'after' ? p('phaseAfter') : '';
    const colW = (maxW - 6) / 2, rowH = colW * 0.72; let col = 0;
    for (const ph of rows || []) {
      const { data: signed } = await supabase.storage.from(KS_PHOTO_BUCKET).createSignedUrl(ph.storage_path, 300);
      if (!signed?.signedUrl) continue;
      let dataUrl = '';
      try { const blob = await (await fetch(signed.signedUrl)).blob(); dataUrl = await new Promise<string>((r) => { const fr = new FileReader(); fr.onload = () => r(fr.result as string); fr.readAsDataURL(blob); }); } catch (e) { continue; }
      if (y + rowH + 8 > 285) { doc.addPage(); y = margin; col = 0; }
      const x = margin + col * (colW + 6);
      try { doc.addImage(dataUrl, 'JPEG', x, y, colW, rowH); } catch (e) {}
      doc.setDrawColor(220); doc.rect(x, y, colW, rowH);
      const cap = `${ph.phase ? '[' + phaseName(ph.phase) + '] ' : ''}${ph.caption || ''}`;
      if (cap.trim()) { doc.setFontSize(8); doc.setTextColor(80); doc.text(doc.splitTextToSize(cap, colW), x, y + rowH + 3.5); doc.setTextColor(20, 23, 28); }
      if (col === 1) { y += rowH + 12; col = 0; } else col = 1;
    }
    await deliverPdf(doc, `Dekmar_Sluttdokumentasjon_${CURRENT_PROJECT?.name || ''}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `Sluttdokumentasjon – ${CURRENT_PROJECT?.name || ''}`);
  }

