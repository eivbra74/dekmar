  async function renderShaPlan(projectId: string) {
    redraw = () => renderShaPlan(projectId);
    await ensureShell('projects');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const { data: pr } = await supabase.from('projects').select('*').eq('id', projectId).single();
    CURRENT_PROJECT = pr;
    const { data: existing } = await supabase.from('sha_plans').select('*').eq('project_id', projectId).maybeSingle();
    const clone = (x: any) => JSON.parse(JSON.stringify(x));
    const d: any = existing?.data || {
      description: '', roles: clone(STD_SHA.roles), milestones: clone(STD_SHA.milestones),
      specific: clone(STD_SHA.specific), preventive: clone(STD_SHA.preventive),
    };
    const rev = existing?.rev ?? 0;
    const sync = () => {
      d.description = (document.getElementById('sha-desc') as HTMLTextAreaElement)?.value || '';
      root.querySelectorAll<HTMLInputElement>('[data-role]').forEach((el) => { const i = +el.dataset.role!; const f = el.dataset.f!; if (d.roles[i]) d.roles[i][f] = el.value; });
      root.querySelectorAll<HTMLInputElement>('[data-ms]').forEach((el) => { const i = +el.dataset.ms!; if (d.milestones[i]) d.milestones[i].date = el.value; });
      root.querySelectorAll<HTMLElement>('[data-sp]').forEach((el) => { const i = +el.dataset.sp!; const f = el.dataset.f!; if (d.specific[i]) d.specific[i][f] = (el as HTMLInputElement).value; });
      root.querySelectorAll<HTMLElement>('[data-pv]').forEach((el) => { const i = +el.dataset.pv!; const f = el.dataset.f!; if (d.preventive[i]) d.preventive[i][f] = (el as HTMLInputElement).value; });
