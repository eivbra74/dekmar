  function parseTable(txt: string): string[][] {
    const lines = txt.replace(/\r/g, '').split('\n').filter((l) => l.trim());
    return lines.map((l) => (l.indexOf('\t') >= 0 ? l.split('\t') : l.indexOf(';') >= 0 ? l.split(';') : l.split(',')).map((c) => c.replace(/^"|"$/g, '').trim()));
  }
  function previewImport() {
    const txt = (document.getElementById('imp-txt') as HTMLTextAreaElement).value;
    IMPORT_ROWS = parseTable(txt);
    const out = document.getElementById('imp-out')!;
    if (!IMPORT_ROWS.length) { out.innerHTML = `<p class="p-muted">—</p>`; return; }
    const cols = IMPORT_ROWS[0].length;
    const roleSel = (i: number) => `<select data-role="${i}"><option value="ignore">–</option><option value="name"${i === 0 ? ' selected' : ''}>${esc(p('matName'))}</option><option value="cost"${i === 1 ? ' selected' : ''}>${esc(p('matCost'))}</option><option value="unit"${i === 2 ? ' selected' : ''}>${esc(p('matUnit'))}</option><option value="supplier"${i === 3 ? ' selected' : ''}>${esc(p('matSupplier'))}</option><option value="art">${esc(p('matArtNo'))}</option></select>`;
    out.innerHTML = `
      <p class="p-muted" style="margin:8px 0 4px">${IMPORT_ROWS.length} ${esc(p('rowsFound'))}</p>
      <div class="p-tablewrap"><table class="p-table"><thead><tr>${Array.from({ length: cols }, (_x, i) => `<th>${roleSel(i)}</th>`).join('')}</tr></thead><tbody>
        ${IMPORT_ROWS.slice(0, 8).map((r) => `<tr>${Array.from({ length: cols }, (_x, i) => `<td>${esc(r[i] || '')}</td>`).join('')}</tr>`).join('')}
      </tbody></table></div>
      <label class="p-field" style="margin-top:6px"><span style="font-size:.85rem"><input type="checkbox" id="imp-hdr"> Første rad er overskrift</span></label>
      <button class="btn btn--primary" id="imp-apply" type="button" style="margin-top:6px">${esc(p('importApply'))}</button>
      <span class="p-muted" id="imp-msg" style="margin-left:8px"></span>`;
    document.getElementById('imp-apply')!.addEventListener('click', applyImport);
  }
  async function applyImport() {
    const roles: Record<number, string> = {};
    document.querySelectorAll('#imp-out [data-role]').forEach((s) => { roles[+(s as HTMLElement).dataset.role!] = (s as HTMLSelectElement).value; });
    const nameCol = Object.keys(roles).find((k) => roles[+k] === 'name'); const costCol = Object.keys(roles).find((k) => roles[+k] === 'cost');
    const unitCol = Object.keys(roles).find((k) => roles[+k] === 'unit'); const supCol = Object.keys(roles).find((k) => roles[+k] === 'supplier'); const artCol = Object.keys(roles).find((k) => roles[+k] === 'art');
    const msg = document.getElementById('imp-msg')!;
    if (nameCol == null || costCol == null) { msg.textContent = p('matName') + ' + ' + p('matCost'); return; }
    const hdr = (document.getElementById('imp-hdr') as HTMLInputElement)?.checked;
    const rows = hdr ? IMPORT_ROWS.slice(1) : IMPORT_ROWS;
    const byArt: Record<string, any> = {}; const byName: Record<string, any> = {};
    MATERIALS.forEach((m: any) => { if (m.article_no) byArt[String(m.article_no).toLowerCase()] = m; byName[(m.name || '').toLowerCase()] = m; });
    let upd = 0, ins = 0; const { data: u } = await supabase.auth.getUser();
    for (const r of rows) {
      const name = (r[+nameCol] || '').trim(); const cost = numv(r[+costCol]); if (!name || !cost) continue;
      const art = artCol != null ? (r[+artCol] || '').trim() : ''; const unit = unitCol != null ? (r[+unitCol] || '').trim() : ''; const sup = supCol != null ? (r[+supCol] || '').trim() : '';
      const match = (art && byArt[art.toLowerCase()]) || byName[name.toLowerCase()];
      if (match) { const patch: any = { cost_price: cost }; if (unit) patch.unit = unit; if (sup) patch.supplier = sup; if (art) patch.article_no = art; await supabase.from('calc_materials').update(patch).eq('id', match.id); upd++; }
      else { await supabase.from('calc_materials').insert({ name, cost_price: cost, unit: unit || null, supplier: sup || null, article_no: art || null, slug: 'm-' + Date.now() + '-' + ins, created_by: u.user?.id }); ins++; }
    }
    MATERIALS_SEEDED = true; msg.textContent = `${upd} oppdatert, ${ins} ny`; setTimeout(() => renderCalc(), 900);
  }

  async function editMaterial(m: any) {
    if (!m) return; redraw = () => editMaterial(m); await ensureShell('calc');
    root.innerHTML = `
      <div class="p-head"><h1>${esc(m.name)}</h1><div class="p-user"><button class="btn btn--ghost" id="em-back">${esc(p('calc'))}</button></div></div>
      <div class="p-grid2"><label class="p-field">${esc(p('matName'))}<input id="em-name" value="${esc(m.name || '')}"></label><label class="p-field">${esc(p('matSupplier'))}<input id="em-sup" value="${esc(m.supplier || '')}"></label></div>
      <div class="p-grid2"><label class="p-field">${esc(p('matArtNo'))}<input id="em-art" value="${esc(m.article_no || '')}"></label><label class="p-field">${esc(p('matUnit'))}<input id="em-unit" value="${esc(m.unit || '')}"></label></div>
      <div class="p-grid2"><label class="p-field">${esc(p('matCost'))}<input id="em-cost" inputmode="decimal" value="${esc(m.cost_price != null ? String(m.cost_price) : '')}"></label><label class="p-field">${esc(p('matOrderEmail'))}<input id="em-oemail" type="email" value="${esc(m.order_email || '')}"></label></div>
      <div class="q-actions"><button class="btn btn--primary" id="em-save">${esc(p('save'))}</button><button class="btn btn--ghost" id="em-del">${esc(p('removeLabel') || 'Slett')}</button></div>`;
    document.getElementById('em-back')!.addEventListener('click', renderCalc);
    document.getElementById('em-save')!.addEventListener('click', async () => {
      const v = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
      await supabase.from('calc_materials').update({ name: v('em-name'), supplier: v('em-sup') || null, article_no: v('em-art') || null, unit: v('em-unit') || null, cost_price: v('em-cost') ? numv(v('em-cost')) : null, order_email: v('em-oemail') || null }).eq('id', m.id);
      MATERIALS_SEEDED = true; renderCalc();
    });
    document.getElementById('em-del')!.addEventListener('click', async () => { if (!confirm(m.name)) return; await supabase.from('calc_materials').delete().eq('id', m.id); MATERIALS_SEEDED = true; renderCalc(); });
  }

  // ---------- Fane: Bestillingslister ----------
  async function renderOrdersTab() {
    const { data } = await supabase.from('purchase_orders').select('*, projects(name)').order('created_at', { ascending: false });
    const O = data || []; const box = cb(); if (!box) return;
    box.innerHTML = `
      <div class="p-tablewrap"><table class="p-table"><thead><tr><th>${esc(p('orderNo'))}</th><th>${esc(p('colDate'))}</th><th>${esc(p('matSupplier'))}</th><th>${esc(p('colProject'))}</th><th>${esc(t('status'))}</th></tr></thead><tbody id="o-body">
        ${O.length ? O.map((o: any) => `<tr data-o="${esc(o.id)}"><td>${esc(o.number || '—')}</td><td>${esc(fmt(o.created_at))}</td><td>${esc(o.supplier || '')}</td><td>${esc(o.projects?.name || '—')}</td><td><span class="q-badge q-${o.status === 'sent' ? 'sent' : 'draft'}">${esc(o.status === 'sent' ? p('qStatusSent') : p('qStatusDraft'))}</span></td></tr>`).join('') : `<tr><td colspan="5" class="p-muted">${esc(p('noOrders'))}</td></tr>`}
      </tbody></table></div>`;
    box.querySelectorAll('#o-body [data-o]').forEach((tr) => tr.addEventListener('click', () => renderOrder(O.find((x: any) => x.id === (tr as HTMLElement).dataset.o))));
  }

  async function renderOrder(o: any) {
    if (!o) return; redraw = () => renderOrder(o); await ensureShell('calc');
    await seedMaterials();
    const supMat = MATERIALS.find((m: any) => (m.supplier || '') === (o.supplier || '') && m.order_email);
    const state: any = { items: (o.items || []).map((x: any) => ({ ...x })), note: o.note || '', order_email: o.order_email || (supMat ? supMat.order_email : '') };
    root.innerHTML = `
      <div class="p-head"><h1>${esc(p('tabOrders'))} · ${esc(o.number || '')}</h1><div class="p-user"><button class="btn btn--ghost" id="o-back">${esc(p('calc'))}</button></div></div>
      <p><strong>${esc(p('matSupplier'))}:</strong> ${esc(o.supplier || '')}</p>
      <div class="p-tablewrap"><table class="ql-table"><thead><tr><th class="ql-spec">${esc(p('matName'))}</th><th>${esc(p('matArtNo'))}</th><th>${esc(p('matUnit'))}</th><th>${esc(p('colQty'))}</th><th></th></tr></thead><tbody id="o-items"></tbody></table></div>
      <div class="p-grid2"><label class="p-field">${esc(p('matOrderEmail'))}<input id="o-email" type="email" value="${esc(state.order_email)}"></label></div>
      <label class="p-field">${esc(p('orderNote'))}<textarea id="o-note" rows="2">${esc(state.note)}</textarea></label>
      <div class="q-actions"><button class="btn btn--primary" id="o-save">${esc(p('save'))}</button><button class="btn btn--ghost" id="o-send">${esc(p('sendToSupplier'))}</button><button class="btn btn--ghost" id="o-del">${esc(p('removeLabel') || 'Slett')}</button></div>`;
    const drawItems = () => {
      const tb = document.getElementById('o-items')!;
      tb.innerHTML = state.items.map((it: any, i: number) => `<tr><td class="ql-spec"><input data-i="${i}" data-f="name" value="${esc(it.name || '')}"></td><td><input data-i="${i}" data-f="article_no" value="${esc(it.article_no || '')}" style="width:90px"></td><td><input data-i="${i}" data-f="unit" value="${esc(it.unit || '')}" style="width:52px"></td><td><input data-i="${i}" data-f="qty" value="${esc(String(it.qty ?? ''))}" style="width:64px" inputmode="decimal"></td><td><button class="ql-del" data-del="${i}" type="button">✕</button></td></tr>`).join('') || `<tr><td colspan="5" class="p-muted">—</td></tr>`;
      tb.querySelectorAll('input[data-i]').forEach((inp) => inp.addEventListener('input', (e) => { const el = e.target as HTMLInputElement; state.items[+el.dataset.i!][el.dataset.f!] = el.value; }));
      tb.querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', (e) => { state.items.splice(+(e.target as HTMLElement).dataset.del!, 1); drawItems(); }));
    };
    const collect = () => ({ items: state.items.map((it: any) => ({ name: it.name, article_no: it.article_no, unit: it.unit, qty: numv(it.qty) })), note: (document.getElementById('o-note') as HTMLTextAreaElement).value, order_email: (document.getElementById('o-email') as HTMLInputElement).value.trim() });
    document.getElementById('o-back')!.addEventListener('click', renderCalc);
    document.getElementById('o-save')!.addEventListener('click', async () => { await supabase.from('purchase_orders').update(collect()).eq('id', o.id); renderCalc(); });
    document.getElementById('o-del')!.addEventListener('click', async () => { if (!confirm(o.number || '')) return; await supabase.from('purchase_orders').delete().eq('id', o.id); renderCalc(); });
    document.getElementById('o-send')!.addEventListener('click', async () => {
      const c = collect(); await supabase.from('purchase_orders').update({ ...c, status: 'sent', sent_at: new Date().toISOString() }).eq('id', o.id);
      const doc = await makeOrderPdf({ number: o.number, supplier: o.supplier, items: c.items, note: c.note });
      await deliverPdf(doc, `Dekmar_Bestilling_${(o.number || '')}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `Bestilling ${o.number || ''} – Dekmar AS`, { sendLabel: p('sendToSupplier'), toPreset: c.order_email, messagePreset: 'Hei,\n\nVennligst se vedlagte bestilling fra Dekmar AS. Ta kontakt ved spørsmål om leveringstid.\n\nMed vennlig hilsen\nDekmar AS' });
    });
    drawItems();
  }

  async function makeCalcPdf(d: any) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' }); await ensurePdfFont(doc); const logo = await ensureLogo();
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    if (logo) { try { doc.addImage(logo, 'PNG', margin, y, 20, 20); } catch (_e) { /* */ } }
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(15); doc.setTextColor(20, 23, 28); doc.text('Kalkyle', margin + 26, y + 8);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 96, 104); doc.text('Oslo ' + fmt(new Date().toISOString()), pageW - margin, y + 6, { align: 'right' } as any);
    y += 26; doc.setTextColor(20, 23, 28);
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(12); doc.text((d.name || '') + (d.projectName ? '  ·  ' + d.projectName : ''), margin, y); y += 8;
    const cx = { spec: margin, unit: margin + 96, qty: margin + 112, cost: margin + 132, sale: margin + maxW };
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(8.5); doc.setTextColor(90, 96, 104);
    doc.text(p('colSpec'), cx.spec, y); doc.text(p('colUnit'), cx.unit, y); doc.text(p('colQty'), cx.qty, y); doc.text(p('colCost'), cx.cost, y); doc.text(p('colSale'), cx.sale, y, { align: 'right' } as any);
    y += 2; doc.setDrawColor(210); doc.line(margin, y, margin + maxW, y); y += 4; doc.setTextColor(20, 23, 28);
    let cost = 0, sale = 0;
    d.lines.forEach((l: any) => {
      const s = numv(l.qty) * numv(l.cost) * (1 + numv(l.markup) / 100); cost += numv(l.qty) * numv(l.cost); sale += s;
      const sl = doc.splitTextToSize(l.spec || '', 92); const rowH = Math.max(sl.length * 4.2, 6);
      if (y + rowH > 280) { doc.addPage(); y = margin; }
      doc.setFont('DejaVu', 'normal'); doc.setFontSize(9);
      sl.forEach((x: string, k: number) => doc.text(x, cx.spec, y + k * 4.2));
      doc.text(String(l.unit || ''), cx.unit, y); doc.text(nok(numv(l.qty)), cx.qty, y); doc.text(nok(numv(l.cost)), cx.cost, y); doc.text(nok(s), cx.sale, y, { align: 'right' } as any);
      y += rowH + 2;
    });
    y += 2; doc.setDrawColor(20, 23, 28); doc.line(margin + 96, y, margin + maxW, y); y += 6;
    const rt = (l: string, v: string, b = false) => { doc.setFont('DejaVu', b ? 'bold' : 'normal'); doc.setFontSize(b ? 11 : 10); doc.text(l, margin + 98, y); doc.text(v, cx.sale, y, { align: 'right' } as any); y += 6; };
    rt(p('sumCost'), 'kr ' + nok(cost)); rt(p('coverage'), 'kr ' + nok(sale - cost)); rt(p('sumSale'), 'kr ' + nok(sale), true);
    await deliverPdf(doc, `Dekmar_Kalkyle_${(d.name || '')}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `Kalkyle – ${d.name || ''}`);
  }

  async function makeOrderPdf(d: any) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' }); await ensurePdfFont(doc); const logo = await ensureLogo(); const co = QUOTE_LETTER.company || {};
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    if (logo) { try { doc.addImage(logo, 'PNG', margin, y, 20, 20); } catch (_e) { /* */ } }
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(15); doc.setTextColor(20, 23, 28); doc.text('Bestilling', margin + 26, y + 8);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 96, 104);
    doc.text('Oslo ' + fmt(new Date().toISOString()), pageW - margin, y + 6, { align: 'right' } as any);
    if (d.number) doc.text('Bestillingsnr ' + d.number, pageW - margin, y + 11, { align: 'right' } as any);
    y += 26; doc.setTextColor(20, 23, 28);
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(11); doc.text('Leverandør: ' + (d.supplier || ''), margin, y); y += 8;
    const cx = { name: margin, art: margin + 104, unit: margin + 140, qty: margin + maxW };
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(8.5); doc.setTextColor(90, 96, 104);
    doc.text(p('matName'), cx.name, y); doc.text(p('matArtNo'), cx.art, y); doc.text(p('matUnit'), cx.unit, y); doc.text(p('colQty'), cx.qty, y, { align: 'right' } as any);
    y += 2; doc.setDrawColor(210); doc.line(margin, y, margin + maxW, y); y += 4; doc.setTextColor(20, 23, 28);
    d.items.forEach((it: any) => {
      const sl = doc.splitTextToSize(it.name || '', 88); const rowH = Math.max(sl.length * 4.2, 6);
      if (y + rowH > 280) { doc.addPage(); y = margin; }
      doc.setFont('DejaVu', 'normal'); doc.setFontSize(9);
      sl.forEach((x: string, k: number) => doc.text(x, cx.name, y + k * 4.2));
      doc.text(String(it.article_no || ''), cx.art, y); doc.text(String(it.unit || ''), cx.unit, y); doc.text(nok(numv(it.qty)), cx.qty, y, { align: 'right' } as any);
      y += rowH + 2;
    });
    if (d.note) { y += 4; doc.setFont('DejaVu', 'bold'); doc.setFontSize(9.5); doc.text(p('orderNote') + ':', margin, y); y += 5; doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.splitTextToSize(d.note, maxW).forEach((x: string) => { doc.text(x, margin, y); y += 5; }); }
    y += 6; doc.setFont('DejaVu', 'normal'); doc.setFontSize(9.5); doc.text('Leveringsadresse avtales. Bestilt av ' + (co.name || 'Dekmar AS') + ', ' + (co.address || '') + '.', margin, y);
    return doc;
  }

  route();
</script>
