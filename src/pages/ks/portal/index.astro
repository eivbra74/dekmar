        ${card('quotes', 'quote', p('quotes'), p('cardQuotesDesc'))}
        ${card('calc', 'calc', p('calc'), p('cardCalcDesc'))}
        ${card('inspections', 'inspect', p('inspections'), p('cardInspectDesc'))}
        ${card('customers', 'customer', p('customers'), p('cardCustomersDesc'))}
        ${card('deviations', 'deviation', p('deviationCenter'), p('cardDeviationsDesc'), nDev ? String(nDev) : '')}
        ${card('articles', 'handbook', p('hmsHandbook'), p('cardHandbookDesc'))}
        ${card('documents', 'documents', p('documents'), p('cardDocumentsDesc'))}
        ${card('templates', 'templates', p('manageTemplates'), p('cardTemplatesDesc'))}
        ${card('archive', 'archive', p('archive'), p('cardArchiveDesc'))}
        ${card('team', 'team', p('team'), p('cardTeamDesc'))}
