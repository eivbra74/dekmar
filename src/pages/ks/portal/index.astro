  async function renderForms(kind: string, projectId: string) {
    const secEl = document.getElementById(kind === 'checklist' ? 'sec-checklist' : 'sec-verneround')!;
    const heading = kind === 'checklist' ? t('checklists') : t('vernerounds');
    const newLabel = kind === 'checklist' ? p('newChecklist') : p('newVerneround');
    const noLabel = kind === 'checklist' ? p('noChecklists') : p('noVernerounds');
    const tpls = templatesOf(kind);
    const { data: rows } = await supabase.from('checklists').select('*').eq('project_id', projectId).eq('type', kind).order('created_at', { ascending: false });
    const list = (rows || []).map((c: any) => `
      <li class="p-item" data-form="${esc(c.id)}">
        <div><h3>${esc(c.title || heading)}</h3><p>${esc([c.performed_by, c.performed_date].filter(Boolean).join(' · '))}${c.performed_by || c.performed_date ? ' · ' : ''}${esc(p('createdAt'))} ${esc(fmt(c.created_at))}</p></div>
        <span class="p-muted">PDF ›</span>
      </li>`).join('');
    const tplOpts = tpls.map((tp: any) => `<option value="${esc(tp.id)}">${esc(tp.name)}${tp.is_standard ? '' : ' *'}</option>`).join('');
    secEl.innerHTML = `
      <h2>${esc(heading)}</h2>
      ${list ? `<ul class="p-list">${list}</ul>` : `<p class="p-muted">${esc(noLabel)}</p>`}
      <details class="p-new"><summary>${esc(newLabel)}</summary>
        ${tpls.length ? `
        <label class="p-field">${esc(p('chooseTemplate'))}
          <select class="f-tpl"><option value="">${esc(p('chooseTemplate'))}…</option>${tplOpts}</select>
        </label>
        <div class="p-grid2">
          <label class="p-field">${esc(p('checklistTitle'))}<input class="f-title" type="text"></label>
          <label class="p-field">${esc(t('performedBy'))}<input class="f-by" type="text"></label>
        </div>
        <label class="p-field">${esc(t('date'))}<input class="f-date" type="date"></label>
        <div class="f-body"></div>
        <button class="btn btn--primary f-save" type="button" disabled>${esc(p('save'))}</button>
        <span class="p-muted f-msg" style="margin-left:10px"></span>`
        : `<p class="p-muted">${esc(p('noTemplatesYet'))}</p>`}
      </details>`;
    secEl.querySelectorAll('.p-item[data-form]').forEach((el) =>
      el.addEventListener('click', () => {
        const c = (rows || []).find((x: any) => x.id === (el as HTMLElement).dataset.form);
        if (c) makeFormPdf(c, c.sections && c.sections.length ? c.sections : staticFallback(kind), heading, CURRENT_PROJECT?.name);
      }));
    if (!tpls.length) return;
    let chosen: any = null;
    const tplSel = secEl.querySelector('.f-tpl') as HTMLSelectElement;
    const body = secEl.querySelector('.f-body') as HTMLElement;
    const saveBtn = secEl.querySelector('.f-save') as HTMLButtonElement;
    const titleInp = secEl.querySelector('.f-title') as HTMLInputElement;
    tplSel.addEventListener('change', () => {
      chosen = tpls.find((x: any) => x.id === tplSel.value) || null;
      body.innerHTML = chosen ? buildFormBody(chosen.sections) : '';
      saveBtn.disabled = !chosen;
      if (chosen && !titleInp.value.trim()) titleInp.value = chosen.name;
    });
    saveBtn.addEventListener('click', async () => {
      if (!chosen) return;
      const answers: Record<string, string> = {};
      secEl.querySelectorAll<HTMLInputElement>('input[type=radio]:checked').forEach((r) => { answers[r.name] = r.value; });
      secEl.querySelectorAll<HTMLInputElement>('input[data-note]').forEach((n) => { if (n.value.trim()) answers[n.dataset.note!] = n.value.trim(); });
      const { data: u } = await supabase.auth.getUser();
      saveBtn.disabled = true; (secEl.querySelector('.f-msg') as HTMLElement).textContent = p('saving');
      const { error } = await supabase.from('checklists').insert({
        project_id: projectId, type: kind, template_id: chosen.id, sections: chosen.sections,
        title: titleInp.value.trim() || chosen.name,
        performed_by: (secEl.querySelector('.f-by') as HTMLInputElement).value.trim() || null,
        performed_date: (secEl.querySelector('.f-date') as HTMLInputElement).value || null,
        lang: lang(), answers, created_by: u.user?.id,
      });
      if (error) { alert(error.message); saveBtn.disabled = false; (secEl.querySelector('.f-msg') as HTMLElement).textContent = ''; return; }
      renderForms(kind, projectId);
    });
  }

  async function makeFormPdf(rec: any, items: any[], titleLabel: string, projectName?: string) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    await ensurePdfFont(doc);
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    const line = (txt: string, size = 10, style = 'normal', gap = 5) => {
      doc.setFont('DejaVu', style as any); doc.setFontSize(size);
      doc.splitTextToSize(txt, maxW).forEach((pp: string) => { if (y > 282) { doc.addPage(); y = margin; } doc.text(pp, margin, y); y += gap; });
    };
    doc.setFillColor(20, 23, 28); doc.rect(0, 0, pageW, 22, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('DejaVu', 'bold'); doc.setFontSize(15); doc.text('Dekmar AS', margin, 10);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(11); doc.text(titleLabel, margin, 16.5); doc.setTextColor(20, 23, 28); y = 30;
    line(`${t('project')}: ${projectName || ''}`, 10, 'bold', 5.5);
    line(`${t('performedBy')}: ${rec.performed_by || ''}    ${t('date')}: ${rec.performed_date || fmt(rec.created_at)}`, 10, 'normal', 7);
    const A = rec.answers || {};
    items.forEach((sn: any) => {
      y += 2; if (y > 275) { doc.addPage(); y = margin; }
      doc.setDrawColor(204, 31, 42); doc.setLineWidth(0.5); doc.line(margin, y, margin + maxW, y); y += 5;
      line(sn.title[lang()] || sn.title.no || '', 12, 'bold', 6);
      sn.items.forEach((it: any) => {
        const sel = A['f_' + sn.id + '_' + it.id];
        const mark = sel ? (sel === 'ok' ? '[OK]' : sel === 'avvik' ? '[' + p('deviationMark') + ']' : '[' + t('na') + ']') : '[  ]';
        const note = A['n_' + sn.id + '_' + it.id] || '';
        line(`${mark}  ${(it.text[lang()] || it.text.no || '')}${note ? '  — ' + note : ''}`, 10, 'normal', 5);
      });
    });
    await deliverPdf(doc, `Dekmar_${titleLabel}_${projectName || ''}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `${titleLabel} – ${projectName || ''}`);
  }

  // ---------- Maladministrasjon (maler) ----------
  const kindLabel = (k: string) => (k === 'verneround' ? p('kindVerneround') : p('kindChecklist'));
  async function renderTemplates() {
