    const draw = () => {
      const roleRows = d.roles.map((r: any, i: number) => `
        <div class="p-grid3">
          <input value="${esc(r.role)}" data-role="${i}" data-f="role" placeholder="${esc(p('colRole'))}">
          <input value="${esc(r.company || '')}" data-role="${i}" data-f="company" placeholder="${esc(p('colCompany'))}">
