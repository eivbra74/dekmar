---
import KsLayout from '../../../layouts/KsLayout.astro';
import { ksUi, checklist, safetyRound } from '../../../data/ks';
import { standardTemplates } from '../../../data/ksTemplates';
---

<KsLayout active="portal" title="Portal">
  <div class="container">
    <div id="portal-root" class="portal-root">
      <p class="portal-loading">Laster …</p>
    </div>
  </div>
  <script type="application/json" id="ks-data" set:html={JSON.stringify({ ui: ksUi, checklist, safetyRound, standardTemplates })} />
</KsLayout>

<style>
  .portal-root { max-width: 900px; margin-inline: auto; }
  .portal-loading { color: var(--muted); }
  .p-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(18px,3vw,28px); }
  .p-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }
  .p-head h1 { margin: 0; }
  .p-user { display: flex; align-items: center; gap: 12px; font-size: 0.9rem; color: var(--muted); }
  .p-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; font-family: var(--font-head); font-weight: 600; font-size: 0.9rem; }
  .p-field input, .p-field textarea, .p-field select { font: inherit; font-weight: 400; padding: 11px 13px; border: 1px solid var(--line); border-radius: 9px; width: 100%; }
  .p-grid2 { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
  @media (max-width: 560px){ .p-grid2 { grid-template-columns: 1fr; } }
  .p-list { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .p-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; background: #fff; cursor: pointer; }
  .p-item:hover { border-color: var(--ink); }
  .p-item h3 { margin: 0 0 2px; font-size: 1.05rem; }
  .p-item p { margin: 0; color: var(--muted); font-size: 0.88rem; }
  .p-badge { font-family: var(--font-head); font-weight: 700; font-size: 0.72rem; padding: 4px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.04em; }
  .p-badge.open { background: #cc1f2a18; color: var(--brand-dark); }
  .p-badge.closed { background: #12855222; color: #0c6b42; }
  .p-muted { color: var(--muted); font-size: 0.92rem; }
  .p-err { color: var(--brand-dark); font-size: 0.9rem; margin: 8px 0 0; }
  .p-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .p-thumbs { display: grid; grid-template-columns: repeat(auto-fill,minmax(84px,1fr)); gap: 8px; margin-top: 10px; }
  .p-thumb { aspect-ratio: 1; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); position: relative; }
  .p-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .p-section { margin-top: 30px; }
  .p-section > h2 { font-size: 1.25rem; }
  details.p-new { border: 1px dashed var(--line); border-radius: 10px; padding: 14px 16px; margin-top: 14px; }
  details.p-new summary { cursor: pointer; font-family: var(--font-head); font-weight: 700; color: var(--brand); }
  details.p-new[open] summary { margin-bottom: 14px; }
  .p-login { max-width: 400px; margin: 6vh auto 0; }
  /* Skjema-avkryssing (sjekkliste/vernerunde) */
  .p-cl-sec { border: 0; border-top: 2px solid var(--line); padding: 14px 0 2px; margin: 0; }
  .p-cl-sec legend { font-family: var(--font-head); font-weight: 700; color: var(--brand); padding: 0; font-size: 1rem; }
  .p-cl-item { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .p-cl-item:last-child { border-bottom: 0; }
  .p-cl-text { margin: 0 0 8px; font-weight: 500; }
  .ks-radios { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .ks-pill { position: relative; }
  .ks-pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .ks-pill span { display: inline-block; padding: 7px 15px; border-radius: 999px; border: 1.5px solid var(--line); font-family: var(--font-head); font-weight: 600; font-size: 0.88rem; cursor: pointer; }
  .ks-pill--ok input:checked + span { background: #12855222; border-color: #128552; color: #0c6b42; }
  .ks-pill--na input:checked + span { background: var(--surface); border-color: var(--muted); color: var(--muted); }
  .ks-pill--dev input:checked + span { background: #cc1f2a18; border-color: var(--brand); color: var(--brand-dark); }
  .p-cl-note { flex: 1; min-width: 150px; font: inherit; padding: 8px 11px; border: 1px solid var(--line); border-radius: 8px; }
  /* Maler */
  .p-tpl { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin-bottom: 14px; }
  .p-tpl-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .p-tpl-head h3 { margin: 0; }
  .p-tpl-cats-label { margin: 12px 0 6px; font-weight: 600; font-size: 0.85rem; font-family: var(--font-head); }
  .p-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .p-chip { background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 4px 10px; font-size: 0.8rem; }
  .p-sm { padding: 6px 12px; font-size: 0.82rem; }
  .p-grid-inline { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
  .p-grid-inline input { flex: 1; }
  .p-tpl-edit-sec { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; margin: 10px 0; }
  /* Arkiv */
  .p-filters { display: flex; gap: 10px; flex-wrap: wrap; margin: 18px 0; }
  .p-filters input, .p-filters select { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; }
  .p-filters #a-search { flex: 1; min-width: 200px; }
  .p-tablewrap { overflow-x: auto; }
  .p-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .p-table th, .p-table td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line); font-size: 0.94rem; white-space: nowrap; }
  .p-table th { font-family: var(--font-head); font-weight: 700; background: var(--surface); }
  .p-table tbody tr[data-form] { cursor: pointer; }
  .p-table tbody tr[data-form]:hover { background: var(--surface); }
</style>

<script>
  import { supabase, KS_PHOTO_BUCKET } from '../../../lib/ksSupabase';
  import { jsPDF } from 'jspdf';

  const KSD = JSON.parse(document.getElementById('ks-data')!.textContent || '{}');
  const UI = KSD.ui || {};
  const CHECKLIST = KSD.checklist || [];
  const SAFETYROUND = KSD.safetyRound || [];
  const STD_TEMPLATES = KSD.standardTemplates || [];
  let TEMPLATES: any[] = [];
  let TEMPLATES_SEEDED = false;
  let CURRENT_PROJECT: any = null;
  const lang = () => (window as any).ksLang || 'no';
  const t = (k: string) => (UI[k] ? UI[k][lang()] : k); // delte KS-felt
  const P: Record<string, any> = {
