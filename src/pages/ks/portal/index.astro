  // ---------- App-skall (sidemeny + hovedområde) ----------
  async function currentEmailSafe() { try { const { data } = await supabase.auth.getUser(); return data.user?.email || ''; } catch { return ''; } }
  function buildShell() {
    PORTAL.innerHTML = `
      <div class="app" data-drawer="closed">
        <div class="app-scrim" id="app-scrim"></div>
        <aside class="app-side" id="app-side">
          <div class="app-brand"><span class="app-brand-mark">HMS/KS</span><span class="app-brand-name">Dekmar</span></div>
          <nav class="app-nav" id="app-nav"></nav>
          <div class="app-side-foot">
            <div class="app-user" id="app-user"></div>
            <button class="app-logout" id="app-logout"><span class="app-nav-ic">${ICONS.logout}</span><span></span></button>
          </div>
        </aside>
        <div class="app-body">
          <header class="app-topbar">
            <button class="app-burger" id="app-burger" aria-label="Meny">${ICONS.menu}</button>
            <span class="app-topbar-title" id="app-topbar-title"></span>
          </header>
          <main class="app-main" id="pmain"></main>
        </div>
      </div>`;
    SHELL_BUILT = true;
    root = document.getElementById('pmain')!;
    const side = document.getElementById('app-side')!;
    const app = PORTAL.querySelector('.app') as HTMLElement;
    const closeDrawer = () => app.setAttribute('data-drawer', 'closed');
    document.getElementById('app-burger')!.addEventListener('click', () => app.setAttribute('data-drawer', app.getAttribute('data-drawer') === 'open' ? 'closed' : 'open'));
    document.getElementById('app-scrim')!.addEventListener('click', closeDrawer);
    document.getElementById('app-logout')!.addEventListener('click', () => supabase.auth.signOut());
    side.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('.app-nav-item')) closeDrawer(); });
    paintShellChrome();
  }
  function paintShellChrome() {
    if (!SHELL_BUILT) return;
    const nav = document.getElementById('app-nav'); if (!nav) return;
    nav.innerHTML = NAV.map((n) => `<button class="app-nav-item${n.id === ACTIVE_NAV ? ' is-active' : ''}" data-nav="${n.id}"><span class="app-nav-ic">${ICONS[n.icon]}</span><span class="app-nav-label">${esc(n.label())}</span></button>`).join('');
    nav.querySelectorAll<HTMLElement>('[data-nav]').forEach((b) => b.addEventListener('click', () => { const n = NAV.find((x) => x.id === b.dataset.nav); if (n) { ACTIVE_NAV = n.id; paintShellChrome(); n.run(); } }));
    const logoutLabel = document.querySelector('#app-logout span:last-child'); if (logoutLabel) logoutLabel.textContent = p('signOut');
    const title = document.getElementById('app-topbar-title'); if (title) { const n = NAV.find((x) => x.id === ACTIVE_NAV); title.textContent = n ? n.label() : ''; }
  }
  async function ensureShell(navId?: string) {
    if (!SHELL_BUILT) buildShell();
    if (navId) ACTIVE_NAV = navId;
    paintShellChrome();
    const ue = document.getElementById('app-user'); if (ue && !ue.textContent) ue.textContent = await currentEmailSafe();
  }
  function teardownShell() { SHELL_BUILT = false; root = PORTAL; PORTAL.innerHTML = ''; }

  // ---------- Maler (templates) ----------
  async function ensureTemplates() {
    if (!TEMPLATES_SEEDED) {
      // upsert standardmaler på slug slik at innholdsendringer propagerer (standardmaler er ikke redigerbare i UI, kun «Dupliser»)
      const { data: u } = await supabase.auth.getUser();
      await supabase.from('templates').upsert(STD_TEMPLATES.map((t: any) => ({
        slug: t.slug, name: t.name, kind: t.kind, description: t.description || null,
        is_standard: true, sections: t.sections, sort: t.sort || 0, created_by: u.user?.id,
      })), { onConflict: 'slug' });
      TEMPLATES_SEEDED = true;
    }
    await loadTemplates();
  }
  async function loadTemplates() {
    const { data } = await supabase.from('templates').select('*').order('sort').order('name');
    TEMPLATES = data || [];
  }
  const templatesOf = (kind: string) => TEMPLATES.filter((t: any) => t.kind === kind);

  // ---------- HMS-artikler ----------
  // Standardartikler lagres trespråklig som JSON i tekstkolonnene (title/summary/body/category)
  async function ensureArticles() {
    if (!ARTICLES_SEEDED) {
      // upsert på slug for å oppgradere eksisterende (tidl. kun norsk) til trespråklig
      await supabase.from('articles').upsert(STD_ARTICLES.map((a: any) => ({
        slug: a.slug, title: JSON.stringify(a.title), category: JSON.stringify(a.category),
        summary: JSON.stringify(a.summary), body: JSON.stringify(a.body),
        sort: a.sort || 0, is_standard: true, updated_at: new Date().toISOString(),
      })), { onConflict: 'slug' });
      ARTICLES_SEEDED = true;
    }
    const { data } = await supabase.from('articles').select('*').order('sort').order('title');
    ARTICLES = data || [];
  }
  // Les et artikkelfelt: parse trespråklig JSON hvis det finnes, ellers ren tekst
  function artText(a: any, field: string): string {
    const raw = a?.[field];
    if (raw == null) return '';
    if (typeof raw === 'object') return raw[lang()] || raw.no || '';
    if (typeof raw === 'string' && raw.startsWith('{')) {
      try { const o = JSON.parse(raw); if (o && (o.no || o.pl || o.en)) return o[lang()] || o.no || ''; } catch (_e) { /* ren tekst */ }
    }
    return raw;
  }
  // ---------- FDV-arkiv (produktbibliotek) ----------
  async function ensureFdv() {
    if (!FDV_SEEDED) {
      // insert kun manglende (behold brukerens redigeringer, f.eks. tillagte SDS-lenker)
      const { data: existing } = await supabase.from('fdv_products').select('slug');
      const have = new Set((existing || []).map((x: any) => x.slug).filter(Boolean));
      const missing = STD_FDV.filter((f: any) => !have.has(f.slug));
      if (missing.length) {
        await supabase.from('fdv_products').insert(missing.map((f: any) => ({
          slug: f.slug, name: f.name, supplier: f.supplier || null, category: f.category || null,
          use_area: f.use_area || null, is_chemical: !!f.is_chemical, hazards: f.hazards || null,
          signal_word: f.signal_word || null, unit: f.unit || null, notes: f.notes || null,
          is_standard: true, sort: f.sort || 0,
        })));
      }
      FDV_SEEDED = true;
    }
    const { data } = await supabase.from('fdv_products').select('*').order('category').order('sort').order('name');
    FDV = data || [];
  }

  function artTri(a: any, field: string): any {
    const raw = a?.[field];
    if (raw && typeof raw === 'object') return { no: raw.no || '', pl: raw.pl || '', en: raw.en || '' };
    if (typeof raw === 'string' && raw.startsWith('{')) { try { const o = JSON.parse(raw); if (o && (o.no || o.pl || o.en)) return o; } catch (_e) { /* */ } }
    const v = raw || ''; return { no: v, pl: v, en: v };
  }

  // ---------- Avvik-konfig (kategorier + ansvarlige) ----------
  async function ensureDevConfig() {
    if (!DEV_SEEDED) {
      const { data: cats } = await supabase.from('deviation_categories').select('id').limit(1);
      if (!cats || !cats.length) {
        await supabase.from('deviation_categories').insert(STD_DEV_CATS.map((name, i) => ({ name, sort: i, is_standard: true })));
      }
      DEV_SEEDED = true;
    }
    const [{ data: c }, { data: r }] = await Promise.all([
      supabase.from('deviation_categories').select('*').order('sort').order('name'),
      supabase.from('deviation_responsibles').select('*').order('sort').order('name'),
    ]);
    DEV_CATS = c || []; DEV_RESP = r || [];
  }
  // Oversettelse av standard avvikskategorier (lagret navn = norsk; vises på gjeldende språk)
  const DEV_CAT_I18N: Record<string, { no: string; pl: string; en: string }> = {
    'HMS': { no: 'HMS', pl: 'BHP', en: 'HSE' },
    'Kvalitet': { no: 'Kvalitet', pl: 'Jakość', en: 'Quality' },
    'Fremdrift': { no: 'Fremdrift', pl: 'Postęp', en: 'Progress' },
    'Materiell / leveranse': { no: 'Materiell / leveranse', pl: 'Materiały / dostawa', en: 'Materials / delivery' },
    'Skade / ulykke': { no: 'Skade / ulykke', pl: 'Uraz / wypadek', en: 'Injury / accident' },
    'Nestenulykke': { no: 'Nestenulykke', pl: 'Sytuacja o mały włos', en: 'Near miss' },
    'Miljø': { no: 'Miljø', pl: 'Środowisko', en: 'Environment' },
    'Annet': { no: 'Annet', pl: 'Inne', en: 'Other' },
  };
  const devCatLabel = (name: string) => { const m = DEV_CAT_I18N[name]; return m ? m[lang()] : (name || ''); };
  const devSeverityLabel = (s: string) => s === 'hoy' ? p('sevHigh') : s === 'middels' ? p('sevMed') : s === 'lav' ? p('sevLow') : '';
  const devStatusLabel = (s: string) => s === 'closed' ? t('statusClosed') : s === 'in_progress' ? p('statusInProgress') : t('statusOpen');
  const devStatusClass = (s: string) => s === 'closed' ? 'closed' : s === 'in_progress' ? 'progress' : 'open';

  // ---------- Auth routing ----------
  async function route() {
    if (new URLSearchParams(location.search).get('setpw') === '1') { renderSetPassword(); return; }
    const { data } = await supabase.auth.getSession();
    if (data.session) { if (ACTIVE_NAV === 'dashboard') renderDashboard(); else { const n = NAV.find((x) => x.id === ACTIVE_NAV); (n ? n.run : renderDashboard)(); } }
    else renderLogin();
  }
  supabase.auth.onAuthStateChange(() => route());

  // Inviterte ansatte lander her med ?setpw=1 og en aktiv invitasjons-sesjon
  function renderSetPassword() {
    redraw = renderSetPassword;
    teardownShell();
    root.innerHTML = `
      <div class="p-card p-login">
        <h1>${esc(p('setPwTitle'))}</h1>
        <p class="p-muted">${esc(p('setPwIntro'))}</p>
        <form id="pwf" style="margin-top:16px">
          <label class="p-field">${esc(p('newPassword'))}<input id="pwf-pass" type="password" autocomplete="new-password" required></label>
          <button class="btn btn--primary" type="submit">${esc(p('savePassword'))}</button>
          <p class="p-err" id="pwf-err" hidden></p>
        </form>
      </div>`;
    const f = document.getElementById('pwf') as HTMLFormElement;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('pwf-err')!; err.hidden = true;
      const pass = (document.getElementById('pwf-pass') as HTMLInputElement).value;
      if (pass.length < 8) { err.textContent = p('pwTooShort'); err.hidden = false; return; }
      const btn = f.querySelector('button')!; btn.setAttribute('disabled', 'true');
      const { error } = await supabase.auth.updateUser({ password: pass });
      if (error) { err.textContent = error.message; err.hidden = false; btn.removeAttribute('disabled'); return; }
      history.replaceState(null, '', '/ks/portal/');
      renderProjects();
    });
  }

  // ---------- Login ----------
  function renderLogin() {
    redraw = renderLogin;
    teardownShell();
    root.innerHTML = `
      <div class="p-card p-login">
        <h1>${esc(p('loginTitle'))}</h1>
        <p class="p-muted">${esc(p('loginIntro'))}</p>
        <form id="lf" style="margin-top:16px">
          <label class="p-field">${esc(p('email'))}<input id="lf-email" type="email" autocomplete="email" required></label>
          <label class="p-field">${esc(p('password'))}<input id="lf-pass" type="password" autocomplete="current-password" required></label>
          <button class="btn btn--primary" type="submit">${esc(p('signIn'))}</button>
          <p class="p-err" id="lf-err" hidden></p>
        </form>
      </div>`;
    const f = document.getElementById('lf') as HTMLFormElement;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('lf-err')!;
      err.hidden = true;
      const email = (document.getElementById('lf-email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('lf-pass') as HTMLInputElement).value;
      const btn = f.querySelector('button')!; btn.setAttribute('disabled', 'true');
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      btn.removeAttribute('disabled');
      if (error) { err.textContent = p('loginErr'); err.hidden = false; }
    });
  }

  async function currentEmail() {
    const { data } = await supabase.auth.getUser();
    return data.user?.email || '';
  }

  // ---------- Oversikt (dashboard) ----------
  async function renderDashboard() {
    redraw = renderDashboard;
    await ensureShell('dashboard');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const [projC, devC, docC] = await Promise.all([
      supabase.from('projects').select('id', { count: 'exact', head: true }).eq('status', 'active'),
      supabase.from('deviations').select('id', { count: 'exact', head: true }).neq('status', 'closed'),
      supabase.from('documents').select('id', { count: 'exact', head: true }),
    ]);
    const nProj = projC.count ?? 0, nDev = devC.count ?? 0, nDoc = docC.count ?? 0;
