    const card = (nav: string, icon: string, title: string, desc: string, badge?: string) => `
      <button class="dash-card" data-go="${nav}">
        <span class="dash-card-ic">${ICONS[icon]}</span>
        <span class="dash-card-body"><span class="dash-card-title">${esc(title)}${badge ? ` <span class="dash-card-badge">${esc(badge)}</span>` : ''}</span><span class="dash-card-desc">${esc(desc)}</span></span>
        <span class="dash-card-go">${ICONS.chevron}</span>
      </button>`;
    root.innerHTML = `
      <div class="dash-hero">
        <h1>${esc(p('overview'))}</h1>
