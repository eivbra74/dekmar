  // ---------- Tilbudseditor ----------
  async function renderQuoteEditor(q: any, CUST: any[], PROJ: any[]) {
    redraw = () => renderQuoteEditor(q, CUST, PROJ);
    await ensureShell('quotes');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    await seedQuoteElements();
    const isNew = !q;
    const sig0 = (QUOTE_LETTER.signatories && QUOTE_LETTER.signatories[0]) || {};
    const state: any = {
      id: q?.id || null,
      number: q?.number || '',
      customer_id: q?.customer_id || '',
      project_id: q?.project_id || '',
      title: q?.title || '',
      address: q?.address || '',
      intro: q?.intro || QUOTE_LETTER.intro || '',
      start_note: q?.start_note || '',
      valid_days: q?.valid_days ?? (QUOTE_LETTER.validDaysDefault || 30),
      hourly_rate: q?.hourly_rate ?? (QUOTE_LETTER.hourlyDefault || 850),
      vat_rate: q?.vat_rate ?? (QUOTE_LETTER.vatDefault || 25),
      status: q?.status || 'draft',
      signatory: q?.signatory || sig0.name || '',
      lines: (q?.lines && q.lines.length ? q.lines : []).map((l: any) => ({ ...l })),
      terms: null as any,
    };
    // Terms-modell: {text,on}. Ny = standard; eksisterende = lagrede (alle on) + standard som ikke finnes (av).
    const resolveRate = (txt: string) => txt.replace('{rate}', nok(numv(state.hourly_rate)));
    if (q?.terms && q.terms.length) {
      state.terms = q.terms.map((tx: string) => ({ text: tx, on: true }));
    } else {
      state.terms = STD_QUOTE_TERMS.map((tm: any) => ({ text: resolveRate(tm.text), on: !!tm.on }));
    }
    const custOpts = CUST.map((c: any) => `<option value="${esc(c.id)}"${c.id === state.customer_id ? ' selected' : ''}>${esc(c.name)}</option>`).join('');
    const projOpts = PROJ.map((pr: any) => `<option value="${esc(pr.id)}"${pr.id === state.project_id ? ' selected' : ''}>${esc(pr.name)}</option>`).join('');
    const sigOpts = (QUOTE_LETTER.signatories || []).map((s: any) => `<option value="${esc(s.name)}"${s.name === state.signatory ? ' selected' : ''}>${esc(s.name)}</option>`).join('');
    const libOpts = (() => {
      const byCat: Record<string, any[]> = {};
      QUOTE_ELEMENTS.forEach((e: any) => { (byCat[e.category] = byCat[e.category] || []).push(e); });
      return Object.keys(byCat).map((cat) => `<optgroup label="${esc(cat)}">${byCat[cat].map((e: any) => `<option value="${esc(e.slug)}">${esc(e.spec)} (${esc(e.unit)})</option>`).join('')}</optgroup>`).join('');
    })();
    root.innerHTML = `
      <div class="p-head"><h1>${esc(p('newQuote'))}${state.number ? ' · ' + esc(state.number) : ''}</h1><div class="p-user"><button class="btn btn--ghost" id="q-back">${esc(p('quotes'))}</button></div></div>
      <div class="p-grid2">
        <label class="p-field">${esc(p('selectCustomer'))}<select id="q-cust"><option value="">—</option>${custOpts}</select></label>
        <label class="p-field">${esc(p('selectProject'))}<select id="q-proj"><option value="">—</option>${projOpts}</select></label>
      </div>
      <label class="p-field">${esc(p('quoteSubject'))} <span class="p-muted" style="font-weight:400">(f.eks. «Takomlegg og blikkenslagerarbeider på Akersgata 38»)</span><input id="q-title" type="text" value="${esc(state.title)}"></label>
      <div class="p-grid2">
        <label class="p-field">${esc(p('quoteAddress'))}<input id="q-address" type="text" value="${esc(state.address)}"></label>
        <label class="p-field">${esc(p('quoteSignatory'))}<select id="q-sig">${sigOpts}</select></label>
      </div>
      <label class="p-field">${esc(p('quoteIntro'))}<textarea id="q-intro" rows="3">${esc(state.intro)}</textarea></label>
      <label class="p-field">${esc(p('quoteStartNote'))}<input id="q-start" type="text" value="${esc(state.start_note)}" placeholder="Vi har kapasitet til å påbegynne arbeidene …. Vi beregner å bruke ca … uker."></label>
      <div class="p-grid2">
        <label class="p-field">${esc(p('quoteValidDays'))}<input id="q-valid" type="number" value="${esc(String(state.valid_days))}"></label>
        <label class="p-field">${esc(p('quoteHourly'))}<input id="q-hourly" type="number" value="${esc(String(state.hourly_rate))}"></label>
      </div>
      <p class="p-subhead">${esc(p('quoteLinesLabel'))}</p>
      <div class="p-grid2" style="align-items:end">
        <label class="p-field">${esc(p('addFromLibrary'))}<select id="q-lib"><option value="">—</option>${libOpts}</select></label>
        <div><button class="btn btn--ghost" id="q-addblank" type="button">${esc(p('addLine'))}</button></div>
      </div>
      <div class="p-tablewrap"><table class="ql-table"><thead><tr><th class="ql-spec">${esc(p('colSpec'))}</th><th>${esc(p('colUnit'))}</th><th>${esc(p('colQty'))}</th><th>${esc(p('colUnitPrice'))}</th><th style="text-align:right">${esc(p('colSum'))}</th><th></th></tr></thead><tbody id="q-lines"></tbody></table></div>
      <div class="ql-totals" id="q-totals"></div>
      <p class="p-subhead">${esc(p('quoteTermsLabel'))}</p>
      <div id="q-terms"></div>
      <button class="btn btn--ghost" id="q-addterm" type="button" style="margin-top:8px">${esc(p('addTerm'))}</button>
      <div class="q-actions">
        <button class="btn btn--primary" id="q-save" type="button">${esc(p('save'))}</button>
        <button class="btn btn--ghost" id="q-pdf" type="button">${esc(p('quotePreviewSend'))}</button>
        <select id="q-status">${['draft', 'sent', 'accepted', 'declined'].map((s) => `<option value="${s}"${s === state.status ? ' selected' : ''}>${esc(qStatusLabel(s))}</option>`).join('')}</select>
        ${state.id ? `<button class="btn btn--ghost" id="q-del" type="button">${esc(p('removeLabel') || 'Slett')}</button>` : ''}
        <span class="p-muted" id="q-msg"></span>
      </div>`;
    // sync helpers
    const g = (id: string) => document.getElementById(id) as HTMLInputElement;
    const readTop = () => {
      state.customer_id = g('q-cust').value || null; state.project_id = g('q-proj').value || null;
      state.title = g('q-title').value.trim(); state.address = g('q-address').value.trim();
      state.intro = (g('q-intro') as any).value; state.start_note = g('q-start').value.trim();
      state.valid_days = numv(g('q-valid').value); state.hourly_rate = numv(g('q-hourly').value);
      state.signatory = g('q-sig').value; state.status = g('q-status').value;
    };
    const drawLines = () => {
      const tb = document.getElementById('q-lines')!;
      tb.innerHTML = state.lines.map((l: any, i: number) => `
        <tr>
          <td class="ql-spec"><input data-i="${i}" data-f="spec" value="${esc(l.spec || '')}"></td>
          <td><input class="ql-num" data-i="${i}" data-f="unit" value="${esc(l.unit || '')}" style="width:56px"></td>
          <td><input class="ql-num" data-i="${i}" data-f="qty" value="${esc(String(l.qty ?? ''))}" style="width:70px" inputmode="decimal"></td>
          <td><input class="ql-num" data-i="${i}" data-f="price" value="${esc(String(l.price ?? ''))}" style="width:90px" inputmode="decimal"></td>
          <td class="ql-sum">${esc(nok(numv(l.qty) * numv(l.price)))}</td>
          <td><button class="ql-del" data-del="${i}" type="button" title="Slett">✕</button></td>
        </tr>`).join('') || `<tr><td colspan="6" class="p-muted">—</td></tr>`;
      tb.querySelectorAll('input[data-i]').forEach((inp) => inp.addEventListener('input', (e) => {
        const el = e.target as HTMLInputElement; const i = +el.dataset.i!; const f = el.dataset.f!;
        state.lines[i][f] = (f === 'qty' || f === 'price') ? el.value : el.value;
        if (f === 'qty' || f === 'price') { drawTotals(); const cell = el.closest('tr')!.querySelector('.ql-sum')!; cell.textContent = nok(numv(state.lines[i].qty) * numv(state.lines[i].price)); }
      }));
      tb.querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', (e) => { state.lines.splice(+(e.target as HTMLElement).dataset.del!, 1); drawLines(); drawTotals(); }));
    };
    const drawTotals = () => {
      const ex = state.lines.reduce((s: number, l: any) => s + numv(l.qty) * numv(l.price), 0);
      const vat = ex * numv(state.vat_rate) / 100; const inc = ex + vat;
      document.getElementById('q-totals')!.innerHTML = `
        <div>${esc(p('sumExVat'))}: <strong>kr ${esc(nok(ex))}</strong></div>
        <div>${esc(p('vatLabel'))} ${esc(nok(numv(state.vat_rate)))} %: kr ${esc(nok(vat))}</div>
        <div class="grand">${esc(p('sumIncVat'))}: kr ${esc(nok(inc))}</div>`;
    };
    const drawTerms = () => {
      const box = document.getElementById('q-terms')!;
      box.innerHTML = state.terms.map((tm: any, i: number) => `
        <div class="q-term"><input type="checkbox" data-ton="${i}"${tm.on ? ' checked' : ''}><textarea data-ttx="${i}" rows="2">${esc(tm.text)}</textarea></div>`).join('');
      box.querySelectorAll('[data-ton]').forEach((c) => c.addEventListener('change', (e) => { state.terms[(+(e.target as HTMLElement).dataset.ton!)].on = (e.target as HTMLInputElement).checked; }));
      box.querySelectorAll('[data-ttx]').forEach((tx) => tx.addEventListener('input', (e) => { state.terms[(+(e.target as HTMLElement).dataset.ttx!)].text = (e.target as HTMLTextAreaElement).value; }));
    };
    document.getElementById('q-back')!.addEventListener('click', renderQuotes);
    g('q-lib').addEventListener('change', (e) => {
      const slug = (e.target as HTMLSelectElement).value; if (!slug) return;
      const el = QUOTE_ELEMENTS.find((x: any) => x.slug === slug); if (el) state.lines.push({ spec: el.spec, unit: el.unit, qty: 1, price: el.price });
      (e.target as HTMLSelectElement).value = ''; drawLines(); drawTotals();
    });
    document.getElementById('q-addblank')!.addEventListener('click', () => { state.lines.push({ spec: '', unit: '', qty: '', price: '' }); drawLines(); });
    document.getElementById('q-addterm')!.addEventListener('click', () => { state.terms.push({ text: '', on: true }); drawTerms(); });
    g('q-hourly').addEventListener('input', () => { /* timerate endres i lagrede standard-forbehold kun ved ny */ });
    const collectForSave = () => {
      readTop();
      return {
        customer_id: state.customer_id || null, project_id: state.project_id || null,
        title: state.title || null, address: state.address || null, intro: state.intro || null, start_note: state.start_note || null,
        valid_days: state.valid_days, hourly_rate: state.hourly_rate, vat_rate: state.vat_rate,
        signatory: state.signatory || null, status: state.status,
        lines: state.lines.filter((l: any) => (l.spec || '').trim()).map((l: any) => ({ spec: l.spec, unit: l.unit, qty: numv(l.qty), price: numv(l.price) })),
        terms: state.terms.filter((tm: any) => tm.on && (tm.text || '').trim()).map((tm: any) => tm.text.trim()),
      };
    };
    const doSave = async () => {
      const msg = document.getElementById('q-msg')!; msg.textContent = p('saving');
      const payload: any = collectForSave();
      const { data: u } = await supabase.auth.getUser();
      // tildel løpenummer hvis mangler
      if (!state.number) {
        const year = new Date().getFullYear();
        const { data: mx } = await supabase.from('quotes').select('seq').eq('year', year).order('seq', { ascending: false }).limit(1);
        const seq = ((mx && mx[0] && mx[0].seq) || 0) + 1;
        state.number = `${year}-${String(seq).padStart(3, '0')}`; payload.year = year; payload.seq = seq; payload.number = state.number;
      }
      if (payload.status === 'sent') payload.sent_at = new Date().toISOString();
      let res;
      if (state.id) { res = await supabase.from('quotes').update(payload).eq('id', state.id).select().single(); }
      else { payload.created_by = u.user?.id; res = await supabase.from('quotes').insert(payload).select().single(); }
      if (res.error) { msg.textContent = res.error.message; return null; }
      state.id = res.data.id; state.number = res.data.number || state.number;
      msg.textContent = p('savedShort') + (state.number ? ' ' + state.number : '');
      return res.data;
    };
    document.getElementById('q-save')!.addEventListener('click', doSave);
    const qdel = document.getElementById('q-del'); if (qdel) qdel.addEventListener('click', async () => { if (!confirm(state.number || '')) return; await supabase.from('quotes').delete().eq('id', state.id); renderQuotes(); });
    document.getElementById('q-pdf')!.addEventListener('click', async () => {
      await doSave();
      const cust = CUST.find((c: any) => c.id === state.customer_id) || {};
      const proj = PROJ.find((pr: any) => pr.id === state.project_id) || {};
      const sig = (QUOTE_LETTER.signatories || []).find((s: any) => s.name === state.signatory) || (QUOTE_LETTER.signatories || [])[0] || {};
      await makeQuotePdf({
        number: state.number, dateISO: new Date().toISOString(), customer: cust, projectName: proj.name || state.title || '',
        address: state.address || proj.address || '', title: state.title || '', intro: state.intro || '', startNote: state.start_note || '',
        terms: state.terms.filter((tm: any) => tm.on && (tm.text || '').trim()).map((tm: any) => tm.text.trim()),
        lines: state.lines.filter((l: any) => (l.spec || '').trim()), vat: numv(state.vat_rate), validDays: numv(state.valid_days), sig,
      });
    });
    drawLines(); drawTotals(); drawTerms();
  }

  async function makeQuotePdf(d: any) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    await ensurePdfFont(doc);
    const logo = await ensureLogo();
    const co = QUOTE_LETTER.company || {};
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    const line = (txt: string, size = 10, style = 'normal', gap = 5, color: number[] = [20, 23, 28]) => {
      doc.setFont('DejaVu', style as any); doc.setFontSize(size); doc.setTextColor(color[0], color[1], color[2]);
      doc.splitTextToSize(txt || '', maxW).forEach((ln: string) => { if (y > 275) { doc.addPage(); y = margin; } doc.text(ln, margin, y); y += gap; });
    };
    // topp: logo + dato
    if (logo) { try { doc.addImage(logo, 'PNG', margin, y, 22, 22); } catch (_e) { /* ignore */ } }
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 96, 104);
    doc.text('Oslo ' + fmt(d.dateISO), pageW - margin, y + 4, { align: 'right' } as any);
    if (d.number) doc.text('Tilbudsnr ' + d.number, pageW - margin, y + 9, { align: 'right' } as any);
    y += 28;
    // kunde
    doc.setTextColor(20, 23, 28);
    line(d.customer.name || '', 11, 'bold', 5.5);
    if (d.customer.address) line(d.customer.address, 10, 'normal', 5, [90, 96, 104]);
    if (d.customer.contact || d.customer.email || d.customer.phone) line([d.customer.contact, d.customer.email, d.customer.phone].filter(Boolean).join('  '), 9.5, 'normal', 6, [90, 96, 104]);
    y += 2;
    line('Pristilbud – ' + (d.title || ''), 13, 'bold', 7);
    line(d.intro, 10, 'normal', 5); y += 1;
    // total
    const ex = d.lines.reduce((s: number, l: any) => s + numv(l.qty) * numv(l.price), 0);
    const vat = ex * d.vat / 100; const inc = ex + vat;
    line('Total pris som beskrevet i vedlegg:', 10, 'normal', 5);
    line('•  kr ' + nok(ex) + ',- eks. mva.', 11, 'bold', 7);
    if (d.startNote) { line(d.startNote, 10, 'normal', 5); y += 1; }
    // forbehold
    (d.terms || []).forEach((tx: string) => line('•  ' + tx, 9.5, 'normal', 4.8));
    y += 2;
    line(QUOTE_LETTER.guarantee || '', 10, 'normal', 5);
    line((QUOTE_LETTER.validityLine || '').replace('{days}', String(d.validDays || 30)), 10, 'normal', 6);
    y += 2; line('Mvh.', 10, 'normal', 5); line('for ' + (co.name || 'Dekmar AS'), 10, 'normal', 5);
    line(d.sig.name || '', 10, 'bold', 4.8); line(d.sig.title || '', 9.5, 'normal', 4.6, [90, 96, 104]);
    if (d.sig.phone) line('Tlf: ' + d.sig.phone, 9.5, 'normal', 4.6, [90, 96, 104]);
    if (d.sig.email) line('e-post: ' + d.sig.email, 9.5, 'normal', 5, [90, 96, 104]);
    // footer
    doc.setDrawColor(220); doc.setLineWidth(0.3); doc.line(margin, 285, margin + maxW, 285);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(8); doc.setTextColor(120);
    doc.text(`${co.name}, ${co.address} · Tlf ${co.phone} · ${co.web}`, pageW / 2, 289, { align: 'center' } as any);
    doc.text(`Orgnr ${co.orgno} · Bank ${co.bank} · Startbank ID ${co.startbank}`, pageW / 2, 293, { align: 'center' } as any);
    // side 2: postliste
    doc.addPage(); y = margin;
    doc.setFillColor(20, 23, 28); doc.rect(0, 0, pageW, 20, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('DejaVu', 'bold'); doc.setFontSize(13); doc.text('Dekmar AS', margin, 9);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.text('Vedlegg – spesifiserte poster', margin, 15);
    doc.setTextColor(20, 23, 28); y = 28;
    line('PROSJEKT: ' + (d.projectName || d.title || ''), 11, 'bold', 7);
    // kolonner
    const cx = { post: margin, spec: margin + 16, unit: margin + 108, qty: margin + 124, price: margin + 146, sum: margin + maxW };
    const header = () => {
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(8.5); doc.setTextColor(90, 96, 104);
      doc.text('Postnr', cx.post, y); doc.text('Spesifikasjon', cx.spec, y); doc.text('Enh', cx.unit, y);
      doc.text('Mengde', cx.qty, y); doc.text('Pris', cx.price, y); doc.text('Sum', cx.sum, y, { align: 'right' } as any);
      y += 2; doc.setDrawColor(210); doc.line(margin, y, margin + maxW, y); y += 4; doc.setTextColor(20, 23, 28);
    };
    header();
    d.lines.forEach((l: any, i: number) => {
      const specLines = doc.splitTextToSize(l.spec || '', 88);
      const rowH = Math.max(specLines.length * 4.2, 6);
      if (y + rowH > 280) { doc.addPage(); y = margin; header(); }
      const post = '01.' + String(i + 1).padStart(2, '0');
      doc.setFont('DejaVu', 'normal'); doc.setFontSize(9);
      doc.text(post, cx.post, y);
      specLines.forEach((sl: string, k: number) => doc.text(sl, cx.spec, y + k * 4.2));
      doc.text(String(l.unit || ''), cx.unit, y);
      doc.text(nok(numv(l.qty)), cx.qty, y);
      doc.text(nok(numv(l.price)), cx.price, y);
      doc.text(nok(numv(l.qty) * numv(l.price)), cx.sum, y, { align: 'right' } as any);
      y += rowH + 2;
    });
    y += 2; doc.setDrawColor(20, 23, 28); doc.setLineWidth(0.4); doc.line(margin + 110, y, margin + maxW, y); y += 6;
    const rt = (label: string, val: string, bold = false) => { doc.setFont('DejaVu', bold ? 'bold' : 'normal'); doc.setFontSize(bold ? 11 : 10); doc.text(label, margin + 112, y); doc.text(val, cx.sum, y, { align: 'right' } as any); y += 6; };
    rt('Sum eks. mva.', 'kr ' + nok(ex));
    rt('MVA ' + nok(d.vat) + ' %', 'kr ' + nok(vat));
    rt('Sum inkl. mva.', 'kr ' + nok(inc), true);
    await deliverPdf(doc, `Dekmar_Tilbud_${(d.number || '')}_${(d.customer.name || '')}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `Pristilbud ${d.number || ''} – ${d.title || ''}`.trim());
  }

  // ================= Befaring =================
  async function renderInspections() {
    redraw = renderInspections; await ensureShell('inspections');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const [iRes, cRes, pRes] = await Promise.all([
      supabase.from('inspections').select('*, customers(name), projects(name)').order('created_at', { ascending: false }),
      supabase.from('customers').select('*').order('name'),
      supabase.from('projects').select('id,name,address,client').order('name'),
    ]);
    const I = iRes.data || []; const CUST = cRes.data || []; const PROJ = pRes.data || [];
    root.innerHTML = `
      <div class="p-head"><h1>${esc(p('inspections'))}</h1><div class="p-user"><button class="btn btn--primary" id="i-new">${esc(p('newInspection'))}</button></div></div>
      <div class="p-searchbar"><span class="p-searchbar-ic">${ICONS.search}</span><input id="i-search" type="search" placeholder="${esc(p('searchInspections'))}" autocomplete="off"></div>
      <ul class="p-list" id="i-list"></ul>`;
    document.getElementById('i-new')!.addEventListener('click', () => renderInspectionEditor(null, CUST, PROJ));
    const paint = (q = '') => {
      const ql = q.trim().toLowerCase();
      const list = I.filter((x: any) => !ql || [x.title, x.address, x.customers?.name].some((v: any) => (v || '').toLowerCase().includes(ql)));
      document.getElementById('i-list')!.innerHTML = list.length ? list.map((x: any) => `<li class="p-item" data-i="${esc(x.id)}"><div><h3>${esc(x.title || x.number || '—')}</h3><p>${esc([x.insp_date ? fmt(x.insp_date) : '', x.address, x.customers?.name].filter(Boolean).join(' · '))}</p></div><span class="p-go">${ICONS.chevron}</span></li>`).join('') : `<li class="p-muted" style="list-style:none">${esc(p('noInspections'))}</li>`;
      document.querySelectorAll('#i-list [data-i]').forEach((el) => el.addEventListener('click', () => renderInspectionEditor(I.find((x: any) => x.id === (el as HTMLElement).dataset.i), CUST, PROJ)));
    };
    document.getElementById('i-search')!.addEventListener('input', (e) => paint((e.target as HTMLInputElement).value));
    paint();
  }

  async function renderInspectionEditor(insp: any, CUST: any[], PROJ: any[]) {
    redraw = () => renderInspectionEditor(insp, CUST, PROJ); await ensureShell('inspections');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const state: any = { id: insp?.id || null, customer_id: insp?.customer_id || '', project_id: insp?.project_id || '', title: insp?.title || '', address: insp?.address || '', insp_date: insp?.insp_date || '', present: insp?.present || '', summary: insp?.summary || '', rows: (insp?.rows || []).map((r: any) => ({ ...r })) };
    let existingPhotos: any[] = [];
    if (state.id) { const { data: ph } = await supabase.from('photos').select('*').eq('inspection_id', state.id); existingPhotos = ph || []; }
    const pending: { blob: Blob; dataUrl: string }[] = [];
    const custOpts = CUST.map((c: any) => `<option value="${esc(c.id)}"${c.id === state.customer_id ? ' selected' : ''}>${esc(c.name)}</option>`).join('');
    const projOpts = PROJ.map((pr: any) => `<option value="${esc(pr.id)}"${pr.id === state.project_id ? ' selected' : ''}>${esc(pr.name)}</option>`).join('');
    root.innerHTML = `
      <div class="p-head"><h1>${esc(p('newInspection'))}</h1><div class="p-user"><button class="btn btn--ghost" id="i-back">${esc(p('inspections'))}</button></div></div>
      <div class="p-grid2">
        <label class="p-field">${esc(p('inspTitle'))}<input id="i-title" value="${esc(state.title)}"></label>
        <label class="p-field">${esc(p('inspDate'))}<input id="i-date" type="date" value="${esc(state.insp_date)}"></label>
      </div>
      <div class="p-grid2">
        <label class="p-field">${esc(p('selectCustomer'))}<select id="i-cust"><option value="">—</option>${custOpts}</select></label>
        <label class="p-field">${esc(p('selectProject'))}<select id="i-proj"><option value="">—</option>${projOpts}</select></label>
      </div>
      <label class="p-field">${esc(p('quoteAddress'))}<input id="i-address" value="${esc(state.address)}"></label>
      <label class="p-field">${esc(p('inspPresent'))}<input id="i-present" value="${esc(state.present)}"></label>
      <p class="p-subhead">${esc(p('inspObs'))}</p>
      <div class="p-tablewrap"><table class="ql-table"><thead><tr><th>${esc(p('colArea'))}</th><th>${esc(p('colObservation'))}</th><th>${esc(p('colRecommendation'))}</th><th></th></tr></thead><tbody id="i-rows"></tbody></table></div>
      <button class="btn btn--ghost p-sm" id="i-addrow" type="button" style="margin-top:6px">${esc(p('addRowLabel'))}</button>
      <label class="p-field" style="margin-top:14px">${esc(p('inspPhotos'))}<input id="i-photos" type="file" accept="image/*" capture="environment" multiple></label>
      <div class="p-thumbs" id="i-thumbs"></div>
      <label class="p-field">${esc(p('inspSummary'))}<textarea id="i-summary" rows="3">${esc(state.summary)}</textarea></label>
      <div class="q-actions"><button class="btn btn--primary" id="i-save" type="button">${esc(p('save'))}</button><button class="btn btn--ghost" id="i-pdf" type="button">${esc(p('downloadPdf'))}</button><button class="btn btn--ghost" id="i-toquote" type="button">${esc(p('inspToQuote'))}</button>${state.id ? `<button class="btn btn--ghost" id="i-del" type="button">${esc(p('removeLabel') || 'Slett')}</button>` : ''}<span class="p-muted" id="i-msg"></span></div>`;
    const drawRows = () => {
      const tb = document.getElementById('i-rows')!;
      tb.innerHTML = state.rows.length ? state.rows.map((r: any, i: number) => `<tr><td><input data-i="${i}" data-f="area" value="${esc(r.area || '')}"></td><td><input data-i="${i}" data-f="obs" value="${esc(r.obs || '')}"></td><td><input data-i="${i}" data-f="rec" value="${esc(r.rec || '')}"></td><td><button class="ql-del" data-del="${i}" type="button">✕</button></td></tr>`).join('') : `<tr><td colspan="4" class="p-muted">—</td></tr>`;
      tb.querySelectorAll('input[data-i]').forEach((inp) => inp.addEventListener('input', (e) => { const el = e.target as HTMLInputElement; state.rows[+el.dataset.i!][el.dataset.f!] = el.value; }));
      tb.querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', (e) => { state.rows.splice(+(e.target as HTMLElement).dataset.del!, 1); drawRows(); }));
    };
    const drawThumbs = () => { document.getElementById('i-thumbs')!.innerHTML = existingPhotos.map((ph: any) => `<div class="p-thumb" data-exist="${esc(ph.id)}"><img src="${esc(ph.__url || '')}"><button class="p-thumb-del" data-pdel="${esc(ph.id)}" type="button">✕</button></div>`).join('') + pending.map((x, i) => `<div class="p-thumb"><img src="${x.dataUrl}"><button class="p-thumb-del" data-pend="${i}" type="button">✕</button></div>`).join(''); bindThumbs(); };
    const bindThumbs = () => {
      document.querySelectorAll('#i-thumbs [data-pend]').forEach((b) => b.addEventListener('click', (e) => { pending.splice(+(e.target as HTMLElement).dataset.pend!, 1); drawThumbs(); }));
      document.querySelectorAll('#i-thumbs [data-pdel]').forEach((b) => b.addEventListener('click', async (e) => { const id = (e.target as HTMLElement).dataset.pdel!; const ph = existingPhotos.find((x: any) => x.id === id); if (ph) { await supabase.storage.from(KS_PHOTO_BUCKET).remove([ph.storage_path]); await supabase.from('photos').delete().eq('id', id); existingPhotos = existingPhotos.filter((x: any) => x.id !== id); drawThumbs(); } }));
    };
    // last inn signerte URL-er for eksisterende bilder
    for (const ph of existingPhotos) { const { data: s } = await supabase.storage.from(KS_PHOTO_BUCKET).createSignedUrl(ph.storage_path, 3600); ph.__url = s?.signedUrl || ''; }
    document.getElementById('i-back')!.addEventListener('click', renderInspections);
    document.getElementById('i-addrow')!.addEventListener('click', () => { state.rows.push({}); drawRows(); });
    (document.getElementById('i-photos') as HTMLInputElement).addEventListener('change', async (e) => { const inp = e.target as HTMLInputElement; for (const f of Array.from(inp.files || [])) { const s = await shrink(f); pending.push(s); } inp.value = ''; drawThumbs(); });
    const readTop = () => { state.title = (document.getElementById('i-title') as HTMLInputElement).value.trim(); state.insp_date = (document.getElementById('i-date') as HTMLInputElement).value || null; state.customer_id = (document.getElementById('i-cust') as HTMLSelectElement).value || null; state.project_id = (document.getElementById('i-proj') as HTMLSelectElement).value || null; state.address = (document.getElementById('i-address') as HTMLInputElement).value.trim(); state.present = (document.getElementById('i-present') as HTMLInputElement).value.trim(); state.summary = (document.getElementById('i-summary') as HTMLTextAreaElement).value; };
    const doSave = async () => {
      readTop(); const msg = document.getElementById('i-msg')!; msg.textContent = p('saving');
      const { data: u } = await supabase.auth.getUser();
      const payload: any = { customer_id: state.customer_id, project_id: state.project_id, title: state.title || null, address: state.address || null, insp_date: state.insp_date, present: state.present || null, summary: state.summary || null, rows: state.rows.filter((r: any) => r.area || r.obs || r.rec) };
      if (!state.number && !state.id) { const year = new Date().getFullYear(); const { data: mx } = await supabase.from('inspections').select('number').like('number', `BEF-${year}-%`).order('number', { ascending: false }).limit(1); let seq = 1; if (mx && mx[0] && mx[0].number) { const mm = String(mx[0].number).match(/BEF-\d+-(\d+)/); if (mm) seq = (+mm[1]) + 1; } payload.number = `BEF-${year}-${String(seq).padStart(3, '0')}`; state.number = payload.number; }
      let res; if (state.id) res = await supabase.from('inspections').update(payload).eq('id', state.id).select().single();
      else { payload.created_by = u.user?.id; res = await supabase.from('inspections').insert(payload).select().single(); }
      if (res.error) { msg.textContent = res.error.message; return null; }
      state.id = res.data.id; state.number = res.data.number;
      if (pending.length) { msg.textContent = p('uploading'); for (const ph of pending) { const path = `inspections/${state.id}/${crypto.randomUUID()}.jpg`; const up = await supabase.storage.from(KS_PHOTO_BUCKET).upload(path, ph.blob, { contentType: 'image/jpeg' }); if (!up.error) { const ins = await supabase.from('photos').insert({ project_id: state.project_id, inspection_id: state.id, storage_path: path, created_by: u.user?.id }).select().single(); const { data: s } = await supabase.storage.from(KS_PHOTO_BUCKET).createSignedUrl(path, 3600); if (ins.data) existingPhotos.push({ ...ins.data, __url: s?.signedUrl || '' }); } } pending.length = 0; drawThumbs(); }
      msg.textContent = p('savedShort') + (state.number ? ' ' + state.number : ''); return res.data;
    };
    document.getElementById('i-save')!.addEventListener('click', doSave);
    const idel = document.getElementById('i-del'); if (idel) idel.addEventListener('click', async () => { if (!confirm(state.title || '')) return; await supabase.from('inspections').delete().eq('id', state.id); renderInspections(); });
    document.getElementById('i-pdf')!.addEventListener('click', async () => { await doSave(); const cust = CUST.find((c: any) => c.id === state.customer_id) || {}; await makeInspectionPdf(state, cust, existingPhotos); });
    document.getElementById('i-toquote')!.addEventListener('click', async () => {
      await doSave(); const { data: u } = await supabase.auth.getUser();
      const { error } = await supabase.from('quotes').insert({ title: state.title || null, address: state.address || null, customer_id: state.customer_id, project_id: state.project_id, lines: [], terms: STD_QUOTE_TERMS.filter((tm: any) => tm.on).map((tm: any) => tm.text.replace('{rate}', nok(QUOTE_LETTER.hourlyDefault || 850))), vat_rate: 25, valid_days: QUOTE_LETTER.validDaysDefault || 30, hourly_rate: QUOTE_LETTER.hourlyDefault || 850, signatory: (QUOTE_LETTER.signatories[0] || {}).name, status: 'draft', created_by: u.user?.id });
      const msg = document.getElementById('i-msg')!; if (error) msg.textContent = error.message; else { ACTIVE_NAV = 'quotes'; paintShellChrome(); renderQuotes(); }
    });
    drawRows(); drawThumbs();
  }

  async function makeInspectionPdf(state: any, cust: any, photos: any[]) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' }); await ensurePdfFont(doc); const logo = await ensureLogo(); const co = QUOTE_LETTER.company || {};
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    if (logo) { try { doc.addImage(logo, 'PNG', margin, y, 20, 20); } catch (_e) { /* */ } }
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(15); doc.setTextColor(20, 23, 28); doc.text('Befaringsrapport', margin + 26, y + 8);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 96, 104);
    doc.text('Oslo ' + fmt(new Date().toISOString()), pageW - margin, y + 6, { align: 'right' } as any);
    if (state.number) doc.text(state.number, pageW - margin, y + 11, { align: 'right' } as any);
    y += 26; doc.setTextColor(20, 23, 28);
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(12); doc.text(state.title || '', margin, y); y += 7;
    const kv = (l: string, v: string) => { if (!v) return; doc.setFont('DejaVu', 'bold'); doc.setFontSize(9); doc.setTextColor(90, 96, 104); doc.text(l + ':', margin, y); doc.setFont('DejaVu', 'normal'); doc.setTextColor(20, 23, 28); const lns = doc.splitTextToSize(v, maxW - 40); lns.forEach((ln: string, k: number) => doc.text(ln, margin + 40, y + k * 4.6)); y += Math.max(5.2, lns.length * 4.6); };
    kv('Kunde', cust.name || ''); kv('Adresse', state.address || ''); kv('Befaringsdato', state.insp_date ? fmt(state.insp_date) : ''); kv('Til stede', state.present || '');
    y += 2;
    if ((state.rows || []).length) {
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(10); doc.text(p('inspObs'), margin, y); y += 5;
      const xs = [margin, margin + 45, margin + 110]; const ws = [43, 63, maxW - 110];
      doc.setFontSize(8); doc.setTextColor(90, 96, 104); doc.text('Område', xs[0], y); doc.text('Observasjon', xs[1], y); doc.text('Anbefaling', xs[2], y); y += 2; doc.setDrawColor(210); doc.line(margin, y, margin + maxW, y); y += 4; doc.setTextColor(20, 23, 28);
      state.rows.forEach((r: any) => {
        const t0 = doc.splitTextToSize(r.area || '', ws[0]), t1 = doc.splitTextToSize(r.obs || '', ws[1]), t2 = doc.splitTextToSize(r.rec || '', ws[2]);
        const rowH = Math.max(t0.length, t1.length, t2.length) * 4.2 || 4.2;
        if (y + rowH > 282) { doc.addPage(); y = margin; }
        doc.setFont('DejaVu', 'normal'); doc.setFontSize(8.5);
        t0.forEach((ln: string, k: number) => doc.text(ln, xs[0], y + k * 4.2)); t1.forEach((ln: string, k: number) => doc.text(ln, xs[1], y + k * 4.2)); t2.forEach((ln: string, k: number) => doc.text(ln, xs[2], y + k * 4.2));
        y += rowH + 2;
      });
      y += 2;
    }
    if (state.summary) { if (y > 260) { doc.addPage(); y = margin; } doc.setFont('DejaVu', 'bold'); doc.setFontSize(10); doc.text(p('inspSummary'), margin, y); y += 5; doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.splitTextToSize(state.summary, maxW).forEach((ln: string) => { if (y > 285) { doc.addPage(); y = margin; } doc.text(ln, margin, y); y += 5; }); y += 3; }
    // bilder
    const imgs: string[] = [];
    for (const ph of photos) { if (ph.__url) { try { const blob = await (await fetch(ph.__url)).blob(); imgs.push(await new Promise<string>((r) => { const fr = new FileReader(); fr.onload = () => r(fr.result as string); fr.readAsDataURL(blob); })); } catch (_e) { /* */ } } }
    if (imgs.length) {
      if (y > 240) { doc.addPage(); y = margin; }
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(10); doc.setTextColor(20, 23, 28); doc.text(p('inspPhotos'), margin, y); y += 5;
      const colW = (maxW - 6) / 2, rowH = colW * 0.72; let col = 0;
      imgs.forEach((src) => { if (y + rowH > 285) { doc.addPage(); y = margin; col = 0; } const x = margin + col * (colW + 6); try { doc.addImage(src, 'JPEG', x, y, colW, rowH); } catch (_e) { /* */ } doc.setDrawColor(220); doc.rect(x, y, colW, rowH); if (col === 1) { y += rowH + 6; col = 0; } else col = 1; });
    }
    await deliverPdf(doc, `Dekmar_Befaring_${(state.number || state.title || '')}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `Befaringsrapport ${state.number || ''} – ${state.title || ''}`.trim());
  }

  // ================= HMS-skjemaer (SJA / risiko / stillas) =================
  const hseType = (k: string) => HSE_FORM_TYPES.find((x: any) => x.type === k);
  function riskStyle(v: number) {
    if (!v) return '';
    if (v <= 4) return 'background:#e4f4e8;color:#1a7f37';
    if (v <= 9) return 'background:#fff6e0;color:#8a6a00';
    if (v <= 14) return 'background:#ffe9d6;color:#b5510a';
    return 'background:#fdeaec;color:#cc1f2a';
  }

  async function renderProjectForms(projectId: string) {
    const secEl = document.getElementById('sec-forms'); if (!secEl) return;
