    deviations: { no: 'Avvik', pl: 'Niezgodności', en: 'Deviations' },
    newDeviation: { no: 'Nytt avvik', pl: 'Nowa niezgodność', en: 'New deviation' },
    noDeviations: { no: 'Ingen avvik registrert på dette prosjektet.', pl: 'Brak niezgodności w tym projekcie.', en: 'No deviations logged for this project.' },
    saving: { no: 'Lagrer …', pl: 'Zapisywanie …', en: 'Saving …' },
    uploading: { no: 'Laster opp bilder …', pl: 'Przesyłanie zdjęć …', en: 'Uploading photos …' },
    newChecklist: { no: 'Ny sjekkliste', pl: 'Nowa lista kontrolna', en: 'New checklist' },
    noChecklists: { no: 'Ingen sjekklister lagret på dette prosjektet.', pl: 'Brak zapisanych list kontrolnych w tym projekcie.', en: 'No checklists saved for this project.' },
    checklistTitle: { no: 'Tittel (valgfritt)', pl: 'Tytuł (opcjonalnie)', en: 'Title (optional)' },
    createdAt: { no: 'Registrert', pl: 'Zarejestrowano', en: 'Logged' },
    newVerneround: { no: 'Ny vernerunde', pl: 'Nowy obchód BHP', en: 'New safety round' },
    noVernerounds: { no: 'Ingen vernerunder registrert på dette prosjektet.', pl: 'Brak obchodów BHP w tym projekcie.', en: 'No safety rounds logged for this project.' },
    archive: { no: 'Arkiv', pl: 'Archiwum', en: 'Archive' },
    search: { no: 'Søk (prosjekt, utførende, tittel)', pl: 'Szukaj (projekt, wykonawca, tytuł)', en: 'Search (project, performer, title)' },
    sortBy: { no: 'Sorter', pl: 'Sortuj', en: 'Sort' },
    dateNewest: { no: 'Dato (nyest)', pl: 'Data (najnowsze)', en: 'Date (newest)' },
    dateOldest: { no: 'Dato (eldst)', pl: 'Data (najstarsze)', en: 'Date (oldest)' },
    byProject: { no: 'Prosjekt', pl: 'Projekt', en: 'Project' },
    byPerformer: { no: 'Utførende', pl: 'Wykonawca', en: 'Performer' },
    typeAll: { no: 'Alle typer', pl: 'Wszystkie typy', en: 'All types' },
    colDate: { no: 'Dato', pl: 'Data', en: 'Date' },
    colProject: { no: 'Prosjekt', pl: 'Projekt', en: 'Project' },
    colType: { no: 'Type', pl: 'Typ', en: 'Type' },
    colPerformer: { no: 'Utførende', pl: 'Wykonawca', en: 'Performer' },
    noResults: { no: 'Ingen treff.', pl: 'Brak wyników.', en: 'No results.' },
    documents: { no: 'Dokumenter', pl: 'Dokumenty', en: 'Documents' },
    newDocument: { no: 'Last opp dokument', pl: 'Prześlij dokument', en: 'Upload document' },
    docTitle: { no: 'Tittel', pl: 'Tytuł', en: 'Title' },
    category: { no: 'Kategori', pl: 'Kategoria', en: 'Category' },
    allCategories: { no: 'Alle kategorier', pl: 'Wszystkie kategorie', en: 'All categories' },
    download: { no: 'Last ned', pl: 'Pobierz', en: 'Download' },
    uploadedBy: { no: 'Lastet opp av', pl: 'Przesłał', en: 'Uploaded by' },
    noDocuments: { no: 'Ingen dokumenter ennå. Last opp det første nedenfor.', pl: 'Brak dokumentów. Prześlij pierwszy poniżej.', en: 'No documents yet. Upload the first below.' },
    file: { no: 'Fil', pl: 'Plik', en: 'File' },
    forProject: { no: 'Prosjekt (valgfritt)', pl: 'Projekt (opcjonalnie)', en: 'Project (optional)' },
    common: { no: 'Felles / ingen', pl: 'Wspólne / brak', en: 'Common / none' },
    colTitle: { no: 'Tittel', pl: 'Tytuł', en: 'Title' },
    colCategory: { no: 'Kategori', pl: 'Kategoria', en: 'Category' },
    team: { no: 'Ansatte', pl: 'Pracownicy', en: 'Team' },
    invite: { no: 'Inviter ansatt', pl: 'Zaproś pracownika', en: 'Invite staff' },
    inviteEmail: { no: 'E-post til den ansatte', pl: 'E-mail pracownika', en: "Staff member's email" },
    sendInvite: { no: 'Send invitasjon', pl: 'Wyślij zaproszenie', en: 'Send invitation' },
    inviteSent: { no: 'Invitasjon sendt til', pl: 'Zaproszenie wysłane do', en: 'Invitation sent to' },
    alreadyMember: { no: 'Denne e-posten er allerede registrert.', pl: 'Ten adres e-mail jest już zarejestrowany.', en: 'This email is already registered.' },
    manageTemplates: { no: 'Maler', pl: 'Szablony', en: 'Templates' },
    templatesTitle: { no: 'Maladministrasjon', pl: 'Zarządzanie szablonami', en: 'Template administration' },
    standardTemplatesLabel: { no: 'Standardmaler', pl: 'Szablony standardowe', en: 'Standard templates' },
    ownTemplates: { no: 'Egne maler', pl: 'Własne szablony', en: 'Own templates' },
    newTemplate: { no: '+ Opprett egen mal', pl: '+ Utwórz własny szablon', en: '+ Create own template' },
    standardBadge: { no: 'Standard', pl: 'Standard', en: 'Standard' },
    duplicate: { no: 'Dupliser', pl: 'Duplikuj', en: 'Duplicate' },
    edit: { no: 'Rediger', pl: 'Edytuj', en: 'Edit' },
    del: { no: 'Slett', pl: 'Usuń', en: 'Delete' },
    categoriesLabel: { no: 'Kategorier', pl: 'Kategorie', en: 'Categories' },
    templateName: { no: 'Malnavn', pl: 'Nazwa szablonu', en: 'Template name' },
    templateKind: { no: 'Type', pl: 'Typ', en: 'Type' },
    kindVerneround: { no: 'Vernerunde', pl: 'Obchód BHP', en: 'Safety round' },
    kindChecklist: { no: 'Sjekkliste', pl: 'Lista kontrolna', en: 'Checklist' },
    descriptionLabel: { no: 'Beskrivelse', pl: 'Opis', en: 'Description' },
    addSection: { no: '+ Legg til kategori', pl: '+ Dodaj kategorię', en: '+ Add category' },
    addItem: { no: '+ Legg til punkt', pl: '+ Dodaj punkt', en: '+ Add item' },
    sectionTitleLabel: { no: 'Kategori', pl: 'Kategoria', en: 'Category' },
    itemTextLabel: { no: 'Kontrollpunkt', pl: 'Punkt kontrolny', en: 'Control point' },
    removeLabel: { no: 'Fjern', pl: 'Usuń', en: 'Remove' },
    chooseTemplate: { no: 'Velg mal', pl: 'Wybierz szablon', en: 'Choose template' },
    noTemplatesYet: { no: 'Ingen maler for denne typen ennå. Opprett under «Maler».', pl: 'Brak szablonów tego typu. Utwórz w «Szablony».', en: 'No templates of this type yet. Create under “Templates”.' },
    deviationMark: { no: 'Avvik', pl: 'Niezgodność', en: 'Deviation' },
    confirmDelete: { no: 'Slette denne malen?', pl: 'Usunąć ten szablon?', en: 'Delete this template?' },
    copySuffix: { no: '(kopi)', pl: '(kopia)', en: '(copy)' },
    nameRequired: { no: 'Malnavn er påkrevd.', pl: 'Nazwa szablonu jest wymagana.', en: 'Template name is required.' },
    members: { no: 'Registrerte brukere', pl: 'Zarejestrowani użytkownicy', en: 'Registered users' },
    setPwTitle: { no: 'Velg ditt passord', pl: 'Ustaw swoje hasło', en: 'Set your password' },
    setPwIntro: { no: 'Velkommen til Dekmar KS. Velg et passord for å fullføre kontoen din.', pl: 'Witamy w Dekmar KS. Ustaw hasło, aby dokończyć konfigurację konta.', en: 'Welcome to Dekmar QA. Choose a password to finish setting up your account.' },
    newPassword: { no: 'Nytt passord', pl: 'Nowe hasło', en: 'New password' },
    savePassword: { no: 'Lagre passord', pl: 'Zapisz hasło', en: 'Save password' },
    pwTooShort: { no: 'Passordet må være minst 8 tegn.', pl: 'Hasło musi mieć co najmniej 8 znaków.', en: 'Password must be at least 8 characters.' },
  };
  const DOCCATS = [
    { v: 'hms', no: 'HMS-håndbok', pl: 'Podręcznik BHP', en: 'HSE handbook' },
    { v: 'sha', no: 'SHA-plan', pl: 'Plan BIOZ', en: 'SHA plan' },
    { v: 'sdb', no: 'Sikkerhetsdatablad', pl: 'Karta charakterystyki', en: 'Safety data sheet' },
    { v: 'prosedyre', no: 'Prosedyre / instruks', pl: 'Procedura / instrukcja', en: 'Procedure / instruction' },
    { v: 'sertifikat', no: 'Sertifikat / kurs', pl: 'Certyfikat / szkolenie', en: 'Certificate / course' },
    { v: 'risiko', no: 'Risikovurdering / SJA', pl: 'Ocena ryzyka / JSA', en: 'Risk assessment / JSA' },
    { v: 'referat', no: 'Møtereferat', pl: 'Protokół', en: 'Meeting minutes' },
    { v: 'annet', no: 'Annet', pl: 'Inne', en: 'Other' },
  ];
  const p = (k: string) => (P[k] ? P[k][lang()] : k);
  const catLabel = (v: string) => { const c = DOCCATS.find((x) => x.v === v); return c ? (c as any)[lang()] : (v || ''); };
  const esc = (s: any) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const root = document.getElementById('portal-root')!;
  const fmt = (d: string) => new Date(d).toLocaleDateString('nb-NO');

  // Gjeldende visning tegnes på nytt når språket byttes (KsLayout sender 'kslangchange')
  let redraw: () => void = () => route();
  document.addEventListener('kslangchange', () => redraw());

  // ---------- Maler (templates) ----------
  async function ensureTemplates() {
    if (!TEMPLATES_SEEDED) {
      const { data: existing } = await supabase.from('templates').select('slug');
      const have = new Set((existing || []).map((t: any) => t.slug).filter(Boolean));
      const missing = STD_TEMPLATES.filter((t: any) => !have.has(t.slug));
      if (missing.length) {
        const { data: u } = await supabase.auth.getUser();
        await supabase.from('templates').insert(missing.map((t: any) => ({
          slug: t.slug, name: t.name, kind: t.kind, description: t.description || null,
          is_standard: true, sections: t.sections, sort: t.sort || 0, created_by: u.user?.id,
        })));
      }
      TEMPLATES_SEEDED = true;
    }
    await loadTemplates();
  }
  async function loadTemplates() {
    const { data } = await supabase.from('templates').select('*').order('sort').order('name');
    TEMPLATES = data || [];
  }
  const templatesOf = (kind: string) => TEMPLATES.filter((t: any) => t.kind === kind);

  // ---------- Auth routing ----------
  async function route() {
    if (new URLSearchParams(location.search).get('setpw') === '1') { renderSetPassword(); return; }
    const { data } = await supabase.auth.getSession();
    if (data.session) renderProjects(); else renderLogin();
  }
  supabase.auth.onAuthStateChange(() => route());

  // Inviterte ansatte lander her med ?setpw=1 og en aktiv invitasjons-sesjon
  function renderSetPassword() {
    redraw = renderSetPassword;
    root.innerHTML = `
      <div class="p-card p-login">
        <h1>${esc(p('setPwTitle'))}</h1>
        <p class="p-muted">${esc(p('setPwIntro'))}</p>
        <form id="pwf" style="margin-top:16px">
          <label class="p-field">${esc(p('newPassword'))}<input id="pwf-pass" type="password" autocomplete="new-password" required></label>
          <button class="btn btn--primary" type="submit">${esc(p('savePassword'))}</button>
          <p class="p-err" id="pwf-err" hidden></p>
        </form>
      </div>`;
    const f = document.getElementById('pwf') as HTMLFormElement;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('pwf-err')!; err.hidden = true;
      const pass = (document.getElementById('pwf-pass') as HTMLInputElement).value;
      if (pass.length < 8) { err.textContent = p('pwTooShort'); err.hidden = false; return; }
      const btn = f.querySelector('button')!; btn.setAttribute('disabled', 'true');
      const { error } = await supabase.auth.updateUser({ password: pass });
      if (error) { err.textContent = error.message; err.hidden = false; btn.removeAttribute('disabled'); return; }
      history.replaceState(null, '', '/ks/portal/');
      renderProjects();
    });
  }

  // ---------- Login ----------
  function renderLogin() {
    redraw = renderLogin;
    root.innerHTML = `
      <div class="p-card p-login">
        <h1>${esc(p('loginTitle'))}</h1>
        <p class="p-muted">${esc(p('loginIntro'))}</p>
        <form id="lf" style="margin-top:16px">
          <label class="p-field">${esc(p('email'))}<input id="lf-email" type="email" autocomplete="email" required></label>
          <label class="p-field">${esc(p('password'))}<input id="lf-pass" type="password" autocomplete="current-password" required></label>
          <button class="btn btn--primary" type="submit">${esc(p('signIn'))}</button>
          <p class="p-err" id="lf-err" hidden></p>
        </form>
      </div>`;
    const f = document.getElementById('lf') as HTMLFormElement;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('lf-err')!;
      err.hidden = true;
      const email = (document.getElementById('lf-email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('lf-pass') as HTMLInputElement).value;
      const btn = f.querySelector('button')!; btn.setAttribute('disabled', 'true');
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      btn.removeAttribute('disabled');
      if (error) { err.textContent = p('loginErr'); err.hidden = false; }
    });
  }

  async function currentEmail() {
    const { data } = await supabase.auth.getUser();
    return data.user?.email || '';
  }

  // ---------- Projects ----------
  async function renderProjects() {
    redraw = renderProjects;
    root.innerHTML = `<p class="portal-loading">${esc(t('generating') || '…')}</p>`;
    const { data: projects, error } = await supabase.from('projects').select('*').order('created_at', { ascending: false });
    const email = await currentEmail();
    const rows = (projects || []).map((pr: any) => `
      <li class="p-item" data-id="${esc(pr.id)}">
        <div><h3>${esc(pr.name)}</h3><p>${esc([pr.address, pr.client].filter(Boolean).join(' · '))}</p></div>
        <span class="p-muted">›</span>
      </li>`).join('');
    root.innerHTML = `
      <div class="p-head">
        <h1>${esc(p('projects'))}</h1>
