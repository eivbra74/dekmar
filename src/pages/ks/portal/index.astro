      const msRows = d.milestones.map((m: any, i: number) => `
        <div class="p-grid2"><span class="p-field" style="margin:0;justify-content:center">${esc(m.name)}</span><input type="date" value="${esc(m.date || '')}" data-ms="${i}"></div>`).join('');
      const spRows = d.specific.map((s: any, i: number) => `
        <fieldset class="p-tpl-edit-sec"><div class="p-grid-inline"><input data-sp="${i}" data-f="activity" value="${esc(s.activity || '')}" placeholder="${esc(p('colActivity'))}"><button type="button" class="btn btn--ghost p-sm" data-spdel="${i}">${esc(p('removeLabel'))}</button></div>
          <textarea data-sp="${i}" data-f="risk" rows="2" placeholder="${esc(p('colRisk'))}" style="width:100%;margin-bottom:6px">${esc(s.risk || '')}</textarea>
          <textarea data-sp="${i}" data-f="measure" rows="3" placeholder="${esc(p('colMeasure'))}" style="width:100%;margin-bottom:6px">${esc(s.measure || '')}</textarea>
          <input data-sp="${i}" data-f="responsible" value="${esc(s.responsible || '')}" placeholder="${esc(p('colResponsible'))}" style="width:100%"></fieldset>`).join('');
      const pvRows = d.preventive.map((v: any, i: number) => `
        <div class="p-grid-inline"><input data-pv="${i}" data-f="measure" value="${esc(v.measure || '')}" placeholder="${esc(p('colMeasure'))}"><input data-pv="${i}" data-f="responsible" value="${esc(v.responsible || '')}" placeholder="${esc(p('colResponsible'))}" style="max-width:150px"><button type="button" class="btn btn--ghost p-sm" data-pvdel="${i}">${esc(p('removeLabel'))}</button></div>`).join('');
      root.innerHTML = `
        <div class="p-head"><div><h1>${esc(p('shaPlan'))}</h1><p class="p-muted">${esc(pr?.name || '')}${rev ? ` · ${esc(p('revLabel'))} ${rev}` : ''}</p></div>
          <div class="p-user"><button class="btn btn--ghost" id="sha-back">${esc(p('back'))}</button></div></div>
        <div class="p-card">
          <label class="p-field">${esc(p('shaProjectDesc'))}<textarea id="sha-desc" rows="3">${esc(d.description || '')}</textarea></label>
          <h3>${esc(p('shaOrg'))}</h3>${roleRows}<button type="button" class="btn btn--ghost p-sm" id="sha-addrole">${esc(p('addRow'))}</button>
          <h3 style="margin-top:18px">${esc(p('shaProgress'))}</h3>${msRows}
          <h3 style="margin-top:18px">${esc(p('shaSpecificT'))}</h3>${spRows}<button type="button" class="btn btn--ghost p-sm" id="sha-addsp">${esc(p('addRow'))}</button>
          <h3 style="margin-top:18px">${esc(p('shaPreventiveT'))}</h3>${pvRows}<button type="button" class="btn btn--ghost p-sm" id="sha-addpv">${esc(p('addRow'))}</button>
