    });
    // Config: ansvarlige
    const drawResps = () => {
      const el = document.getElementById('dc-resps')!;
      el.innerHTML = DEV_RESP.length ? DEV_RESP.map((r: any) => `<li class="p-item" style="cursor:default;padding:8px 12px"><span>${esc(r.name)}</span><button class="btn btn--ghost p-sm" data-respdel="${esc(r.id)}">${esc(p('del'))}</button></li>`).join('') : `<p class="p-muted">—</p>`;
      el.querySelectorAll<HTMLElement>('[data-respdel]').forEach((b) => b.addEventListener('click', async () => { const r = DEV_RESP.find((x: any) => x.id === b.dataset.respdel); if (!(await confirmDelete('nResponsible', r ? r.name : ''))) return; if (await runDelete(supabase.from('deviation_responsibles').delete().eq('id', b.dataset.respdel))) { await ensureDevConfig(); drawResps(); } }));
    };
    drawResps();
    document.getElementById('dc-addresp')!.addEventListener('click', async () => {
      const inp = document.getElementById('dc-newresp') as HTMLInputElement; const name = inp.value.trim(); if (!name) return;
      await supabase.from('deviation_responsibles').insert({ name, sort: DEV_RESP.length });
      inp.value = ''; await ensureDevConfig(); drawResps();
    });
    // Automatisk avviksvarsling
    (async () => {
      const { data: s } = await supabase.from('app_settings').select('value').eq('key', 'deviation_notify').maybeSingle();
      const cfg = (s && (s as any).value) || {};
      (document.getElementById('dc-notify-on') as HTMLInputElement).checked = !!cfg.enabled;
      (document.getElementById('dc-notify-emails') as HTMLInputElement).value = (cfg.emails || []).join(', ');
      (document.getElementById('dc-notify-high') as HTMLInputElement).checked = !!cfg.onlyHigh;
    })();
    document.getElementById('dc-notify-save')!.addEventListener('click', async () => {
      const msg = document.getElementById('dc-notify-msg')!;
      const emails = (document.getElementById('dc-notify-emails') as HTMLInputElement).value.split(/[,;]/).map((x) => x.trim()).filter(Boolean);
      const value = { enabled: (document.getElementById('dc-notify-on') as HTMLInputElement).checked, emails, onlyHigh: (document.getElementById('dc-notify-high') as HTMLInputElement).checked };
      const { data: u } = await supabase.auth.getUser();
      const { error } = await supabase.from('app_settings').upsert({ key: 'deviation_notify', value, updated_at: new Date().toISOString(), updated_by: u.user?.id }, { onConflict: 'key' });
      if (error) { msg.textContent = ''; toastError(error); } else { msg.textContent = ''; toast(p('savedShort')); }
    });
  }

  async function notifyNewDeviation(dev: any, projectName: string) {
    try {
      const { data: st } = await supabase.from('app_settings').select('value').eq('key', 'deviation_notify').maybeSingle();
      const cfg = (st && (st as any).value) || {};
      if (!cfg.enabled || !(cfg.emails || []).length) return;
      if (cfg.onlyHigh && dev.severity !== 'hoy') return;
      const subject = `Nytt avvik ${dev.number || ''} – ${projectName}`.trim();
      const meta = [
        `Prosjekt: ${projectName}`,
        `Avviksnr: ${dev.number || '—'}`,
        dev.category ? `Kategori: ${devCatLabel(dev.category)}` : null,
        dev.severity ? `Alvorlighetsgrad: ${devSeverityLabel(dev.severity)}` : null,
        dev.location ? `Sted: ${dev.location}` : null,
        dev.responsible ? `Ansvarlig: ${dev.responsible}` : null,
        dev.due_date ? `Frist: ${dev.due_date}` : null,
      ].filter(Boolean).join('\n');
      const body = `Det er registrert et nytt avvik i Dekmars HMS- og KS-system.\n\n${meta}\n\nBeskrivelse:\n${dev.description || '—'}\n\nLogg inn i portalen for full rapport: https://dekmar.no/portal/`;
      await supabase.functions.invoke('send-report', { body: { to: cfg.emails, subject, message: body } });
    } catch (_e) { /* varsling skal aldri blokkere lagring */ }
  }

