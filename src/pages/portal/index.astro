  async function makeSickLeavePdf(SL: any[], year: number, daysThisYear: number) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' }); await ensurePdfFont(doc); const logo = await ensureLogo();
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    if (logo) { try { doc.addImage(logo, 'PNG', margin, y, 20, 20); } catch (_e) { /* */ } }
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(15); doc.setTextColor(20, 23, 28); doc.text(p('sickLeave'), margin + 26, y + 8);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 96, 104); doc.text('Oslo ' + fmt(new Date().toISOString()), pageW - margin, y + 6, { align: 'right' } as any);
    y += 26; doc.setTextColor(20, 23, 28);
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(11); doc.text(`${p('sickDaysYear')} ${year}: ${nok(daysThisYear)}`, margin, y); y += 8;
    const cx = { emp: margin, type: margin + 52, per: margin + 92, days: margin + maxW - 14, deg: margin + maxW };
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(8.5); doc.setTextColor(90, 96, 104);
    doc.text(p('weekEmployee'), cx.emp, y); doc.text(p('sickType'), cx.type, y); doc.text(p('sickPeriod'), cx.per, y); doc.text(p('sickDaysCol'), cx.days, y, { align: 'right' } as any); doc.text('%', cx.deg, y, { align: 'right' } as any);
    y += 2; doc.setDrawColor(210); doc.line(margin, y, margin + maxW, y); y += 4; doc.setTextColor(20, 23, 28);
    SL.forEach((s: any) => {
      if (y > 282) { doc.addPage(); y = margin; }
      doc.setFont('DejaVu', 'normal'); doc.setFontSize(8.5);
      doc.text(doc.splitTextToSize(s.employee || '', 48)[0], cx.emp, y);
      doc.text(sickTypeLabel(s.type), cx.type, y);
      doc.text(fmt(s.from_date) + (s.to_date && s.to_date !== s.from_date ? ' – ' + fmt(s.to_date) : ''), cx.per, y);
      doc.text(String(daysInclusive(s.from_date, s.to_date)), cx.days, y, { align: 'right' } as any);
      doc.text(s.degree != null ? String(s.degree) : '', cx.deg, y, { align: 'right' } as any);
      y += 5.2;
    });
    await deliverPdf(doc, `Dekmar_Sykefravaer_${year}.pdf`, `${p('sickLeave')} ${year}`);
  }

