  async function tripletexFetch(action: string): Promise<any[]> {
    const { data, error } = await supabase.functions.invoke('tripletex', { body: { action } });
    let errMsg = error ? (error.message || 'error') : ((data && (data as any).error) || '');
    if (error && (error as any).context && typeof (error as any).context.json === 'function') { try { const b = await (error as any).context.json(); if (b && b.error) errMsg = b.error; } catch (_e) { /* */ } }
    if (errMsg) throw new Error(errMsg);
    return ((data as any).values) || [];
  }
