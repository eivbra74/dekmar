    document.getElementById('c-pdf')!.addEventListener('click', async () => { await doSave(); const cust = CUST.find((x: any) => x.id === state.customer_id) || {}; const pr = PROJ.find((x: any) => x.id === state.project_id) || {}; state.__projName = pr.name || ''; state.__projAddr = pr.address || ''; await makeContractPdf(state, cust, co); });
  }

  async function makeContractPdf(state: any, cust: any, co: any) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' }); await ensurePdfFont(doc); const logo = await ensureLogo();
    const pageW = 210, margin = 18, maxW = pageW - margin * 2; let y = margin;
    if (logo) { try { doc.addImage(logo, 'PNG', margin, y, 18, 18); } catch (_e) { /* */ } }
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(9); doc.setTextColor(90, 96, 104); doc.text(co.name || 'Dekmar AS', pageW - margin, y + 4, { align: 'right' } as any);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(8); [co.orgno ? ('Org.nr ' + co.orgno) : '', co.address, co.phone].filter(Boolean).forEach((l: string, i: number) => doc.text(l, pageW - margin, y + 9 + i * 4, { align: 'right' } as any));
    y += 26; doc.setTextColor(20, 23, 28);
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(17); doc.text(p('contractDoc'), margin, y); y += 8;
    doc.setFontSize(12); doc.text(state.title || '', margin, y); y += 6;
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(9); doc.setTextColor(90, 96, 104);
    doc.text(`${p('contractNo')}: ${state.number || '—'}   ·   ${p('nsStandard')}: ${state.ns_standard}   ·   ${fmt(new Date().toISOString())}`, margin, y); y += 8; doc.setTextColor(20, 23, 28);
    // Partene – to kolonner
    const colW = (maxW - 8) / 2; const dekmarIsEnt = true;
    const clientBox = [`${p('partyClient')}:`, cust.name || '—', state.data.clientOrg ? ('Org.nr ' + state.data.clientOrg) : '', state.data.contactClient || ''].filter(Boolean);
    const entBox = [`${p('contractEntreprenor')}:`, co.name || 'Dekmar AS', co.orgno ? ('Org.nr ' + co.orgno) : '', state.data.contactUs || ''].filter(Boolean);
    const boxTop = y; let yL = y + 5, yR = y + 5;
    doc.setDrawColor(220); doc.setFillColor(247, 248, 250);
    const boxH = Math.max(clientBox.length, entBox.length) * 4.8 + 6;
    doc.rect(margin, boxTop, colW, boxH, 'S'); doc.rect(margin + colW + 8, boxTop, colW, boxH, 'S');
    clientBox.forEach((l, i) => { doc.setFont('DejaVu', i === 0 ? 'bold' : 'normal'); doc.setFontSize(i === 0 ? 8 : 9.5); doc.setTextColor(i === 0 ? 90 : 20, i === 0 ? 96 : 23, i === 0 ? 104 : 28); doc.text(l, margin + 3, yL + i * 4.8); });
    entBox.forEach((l, i) => { doc.setFont('DejaVu', i === 0 ? 'bold' : 'normal'); doc.setFontSize(i === 0 ? 8 : 9.5); doc.setTextColor(i === 0 ? 90 : 20, i === 0 ? 96 : 23, i === 0 ? 104 : 28); doc.text(l, margin + colW + 11, yR + i * 4.8); });
    y = boxTop + boxH + 8; doc.setTextColor(20, 23, 28);
    const kv = (l: string, v: string) => { if (!v && v !== '0') return; if (y > 272) { doc.addPage(); y = margin; } doc.setFont('DejaVu', 'bold'); doc.setFontSize(9.5); doc.setTextColor(20, 23, 28); doc.text(l, margin, y); y += 5; doc.setFont('DejaVu', 'normal'); doc.setFontSize(9.5); doc.splitTextToSize(String(v), maxW).forEach((ln: string) => { if (y > 280) { doc.addPage(); y = margin; } doc.text(ln, margin, y); y += 5; }); y += 3; };
    const prName = (PROJS: any) => '';
    kv(p('colProject') + ':', [state.__projName, state.__projAddr].filter(Boolean).join(' · ') || (state.project_id ? '' : ''));
    if (state.sum != null && state.sum !== '') kv(p('contractSum') + ':', 'kr ' + nok(state.sum));
    if (state.start_date || state.end_date) kv(p('contractStart') + ' / ' + p('contractEnd') + ':', `${state.start_date ? fmt(state.start_date) : '—'} – ${state.end_date ? fmt(state.end_date) : '—'}`);
    kv(p('contractBasis') + ':', state.data.basis);
    kv(p('contractBetaling') + ':', state.data.betaling);
    kv(p('contractDagmulkt') + ':', state.data.dagmulkt);
    kv(p('contractSikkerhet') + ':', state.data.sikkerhet);
    kv(p('contractEndringer') + ':', state.data.endringer);
    if (state.data.saerlige) kv(p('contractSaerlige') + ':', state.data.saerlige);
    // signaturer
    if (y > 235) { doc.addPage(); y = margin; }
    y += 6; doc.setFont('DejaVu', 'bold'); doc.setFontSize(10); doc.text(p('contractSignatures'), margin, y); y += 4;
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(9); doc.setTextColor(90, 96, 104); doc.text(p('contractPlaceDate') + ': ______________________________', margin, y + 6); y += 16; doc.setTextColor(20, 23, 28);
    const sy = y + 12; const sw = (maxW - 12) / 2;
    doc.setDrawColor(20, 23, 28); doc.line(margin, sy, margin + sw, sy); doc.line(margin + sw + 12, sy, margin + maxW, sy);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(8.5); doc.setTextColor(90, 96, 104);
    doc.text(`${p('partyClient')} – ${cust.name || ''}`, margin, sy + 4); doc.text(`${p('contractEntreprenor')} – ${co.name || 'Dekmar AS'}`, margin + sw + 12, sy + 4);
    await deliverPdf(doc, `Dekmar_Avtaledokument_${(state.number || state.title || '')}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `${p('contractDoc')} ${state.number || ''} – ${state.title || ''}`.trim());
  }

  // ================= HMS-skjemaer (SJA / risiko / stillas) =================
  const hseType = (k: string) => HSE_FORM_TYPES.find((x: any) => x.type === k);
  function riskStyle(v: number) {
