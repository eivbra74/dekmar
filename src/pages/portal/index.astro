          <label class="p-field">${esc(t('cause'))}<textarea id="nd-cause" rows="3"></textarea></label>
          <label class="p-field">${esc(p('devPreventive'))}<textarea id="nd-prevent" rows="3"></textarea></label>
        </details>
        <p class="p-muted p-note">${esc(p('ndNumberAuto'))}</p>
        <div class="p-actionbar">
          <button class="btn btn--primary" id="nd-save" type="submit">${esc(p('ndSave'))}</button>
          <button class="btn btn--ghost" id="nd-cancel" type="button">${esc(p('cancelLabel'))}</button>
        </div>
      </form>`;
    const form = document.getElementById('nd-form') as HTMLFormElement;
    const projSel = document.getElementById('nd-proj') as HTMLSelectElement;
    const DRAFT = 'deviation-new';
    const pending: { blob: Blob; dataUrl: string }[] = [];
    const thumbs = document.getElementById('nd-thumbs')!;
    const drawThumbs = () => {
      thumbs.innerHTML = pending.map((x, i) => `<div class="p-thumb"><img src="${x.dataUrl}" alt=""><button class="p-thumb-del" type="button" data-pend="${i}" aria-label="${esc(p('deletePhoto'))}">${ICONS.x}</button></div>`).join('');
      thumbs.querySelectorAll<HTMLElement>('[data-pend]').forEach((b) => b.addEventListener('click', () => { pending.splice(+b.dataset.pend!, 1); drawThumbs(); }));
    };
    (document.getElementById('nd-photos') as HTMLInputElement).addEventListener('change', async (e) => {
      const el = e.target as HTMLInputElement;
      for (const f of Array.from(el.files || [])) pending.push(await shrink(f));
      el.value = ''; drawThumbs();
    });
    const leave = () => { if (ME.role === 'ansatt') renderFieldHome(); else if (projSel.value || projectId) openProject(projSel.value || projectId!); else goNav('deviations'); };
    document.getElementById('nd-back')!.addEventListener('click', leave);
    setViewChrome(p('fieldReport'), leave);
    document.getElementById('nd-cancel')!.addEventListener('click', leave);
    projSel.addEventListener('change', () => { if (projSel.value) setFieldProject(projSel.value); });
    bindFormDraft(DRAFT, form, () => renderNewDeviation(projectId));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = (id: string) => ((document.getElementById(id) as HTMLInputElement | null)?.value || '').trim() || null;
      const pe = document.getElementById('nd-proj-err')!, de = document.getElementById('nd-desc-err')!;
      pe.hidden = true; de.hidden = true;
      const pid = projSel.value;
      if (!pid) { pe.textContent = p('ndProjectRequired'); pe.hidden = false; projSel.focus(); return; }
      if (!val('nd-desc')) { de.textContent = p('ndDescRequired'); de.hidden = false; (document.getElementById('nd-desc') as HTMLElement).focus(); return; }
      const btn = document.getElementById('nd-save') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = p('saving');
      try {
        const number = await nextDeviationNumber();
        const sev = (form.querySelector('input[name="nd-sev"]:checked') as HTMLInputElement | null)?.value || null;
        const { data: dev, error } = await supabase.from('deviations').insert({
          project_id: pid, number, dev_date: val('nd-date'), location: val('nd-loc'), description: val('nd-desc'),
          correction: val('nd-corr'), improvement: val('nd-improve'), responsible: val('nd-resp'), due_date: val('nd-due'),
          cause: val('nd-cause'), preventive: val('nd-prevent'), reporter: val('nd-reporter'),
          category: (document.getElementById('nd-cat') as HTMLSelectElement).value || null, severity: sev,
          status: 'open', created_by: ME.id || null,
        }).select().single();
        if (error || !dev) { toastError(error); return; }
        clearDraft(DRAFT);
        markClean(form);
        let failed = 0;
        if (pending.length) {
          btn.textContent = p('uploading');
          for (const ph of pending) {
            const path = `${pid}/${dev.id}/${crypto.randomUUID()}.jpg`;
            const up = await supabase.storage.from(KS_PHOTO_BUCKET).upload(path, ph.blob, { contentType: 'image/jpeg' });
            if (up.error) { failed++; continue; }
            const ins = await supabase.from('photos').insert({ project_id: pid, deviation_id: dev.id, storage_path: path, created_by: ME.id || null });
            if (ins.error) failed++;
          }
        }
        void notifyNewDeviation(dev, (projs.find((x: any) => x.id === pid) || {}).name || '');
        toast(fill(p('ndSaved'), { no: dev.number || '' }));
        reportUploadFailures(failed, pending.length);
        if (ME.role === 'ansatt') renderFieldHome(); else openProject(pid);
      } finally { btn.disabled = false; btn.textContent = p('ndSave'); }
    });
  }

  // ---------- Ny sjekkliste / vernerunde: prosjekt og mal først, ett trykk per punkt ----------
  async function renderNewChecklist(projectId: string | null, kind: 'checklist' | 'verneround') {
    redraw = () => renderNewChecklist(projectId, kind);
    await ensureShell('projects', { view: 'checklist-new', project: projectId, kind: kind === 'verneround' ? 'verneround' : null });
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const [projs] = await Promise.all([wdActiveProjects(), ensureTemplates()]);
    const tpls = templatesOf(kind);
    const heading = kind === 'checklist' ? p('newChecklist') : p('newVerneround');
    const projOpts = projs.map((pr: any) => `<option value="${esc(pr.id)}"${pr.id === projectId ? ' selected' : ''}>${esc(pr.name)}</option>`).join('');
    const tplOpts = tpls.map((tp: any) => `<option value="${esc(tp.id)}"${tpls.length === 1 ? ' selected' : ''}>${esc(tp.name)}${tp.is_standard ? '' : ' *'}</option>`).join('');
    const kindPill = (k: string, l: string) => `<label class="ks-pill"><input type="radio" name="nc-kind" value="${k}"${k === kind ? ' checked' : ''}><span>${esc(l)}</span></label>`;
    root.innerHTML = `
      <button class="btn btn--ghost p-back" id="nc-back" type="button"><span class="btn-ic">${ICONS.arrowLeft}</span>${esc(p('backGeneric'))}</button>
      <div class="p-head"><h1 class="p-viewh1">${esc(heading)}</h1></div>
      <form class="p-card p-form" id="nc-form" novalidate>
        <fieldset class="p-field p-seg"><legend>${esc(p('ncTypeLabel'))}</legend><div class="ks-radios">${kindPill('checklist', t('checklist'))}${kindPill('verneround', t('verneround'))}</div></fieldset>
        <label class="p-field">${esc(p('byProject'))}<select id="nc-proj" aria-describedby="nc-proj-err"><option value="">${esc(p('wdChooseProject'))}…</option>${projOpts}</select></label>
        <p class="p-err" id="nc-proj-err" hidden></p>
        ${tpls.length ? `
        <label class="p-field">${esc(p('chooseTemplate'))}<select id="nc-tpl" data-restore-change><option value="">${esc(p('chooseTemplate'))}…</option>${tplOpts}</select></label>
        <div class="p-grid2">
          <label class="p-field">${esc(p('checklistTitle'))}<input id="nc-title" type="text"></label>
          <label class="p-field">${esc(t('performedBy'))}<input id="nc-by" type="text" value="${esc(ME.name || ME.email)}"></label>
        </div>
        <label class="p-field">${esc(t('date'))}<input id="nc-date" type="date" value="${todayISO()}"></label>
        <div class="nc-tools" id="nc-tools" hidden><button type="button" class="btn btn--ghost p-sm" id="nc-allok">${esc(p('ncAllOk'))}</button></div>
        <div id="nc-body"></div>
        <div class="p-actionbar">
          <button class="btn btn--primary" type="submit" id="nc-save" disabled>${esc(p('save'))}</button>
          <button class="btn btn--ghost" type="button" id="nc-cancel">${esc(p('cancelLabel'))}</button>
        </div>` : `<p class="p-muted">${esc(p('noTemplatesYet'))}</p>`}
      </form>`;
    const form = document.getElementById('nc-form') as HTMLFormElement;
    const projSel = document.getElementById('nc-proj') as HTMLSelectElement;
    const leave = () => { if (ME.role === 'ansatt') renderFieldHome(); else if (projSel.value || projectId) openProject(projSel.value || projectId!); else goNav('projects'); };
    document.getElementById('nc-back')!.addEventListener('click', leave);
    setViewChrome(heading, leave);
    form.querySelectorAll<HTMLInputElement>('input[name="nc-kind"]').forEach((r) => r.addEventListener('change', () => renderNewChecklist(projSel.value || projectId, r.value === 'verneround' ? 'verneround' : 'checklist')));
    projSel.addEventListener('change', () => { if (projSel.value) setFieldProject(projSel.value); });
    if (!tpls.length) return;
    document.getElementById('nc-cancel')!.addEventListener('click', leave);
    const tplSel = document.getElementById('nc-tpl') as HTMLSelectElement;
    const body = document.getElementById('nc-body')!;
    const tools = document.getElementById('nc-tools')!;
    const saveBtn = document.getElementById('nc-save') as HTMLButtonElement;
    const titleInp = document.getElementById('nc-title') as HTMLInputElement;
    let chosen: any = null;
    const pick = () => {
      chosen = tpls.find((x: any) => x.id === tplSel.value) || null;
      body.innerHTML = chosen ? buildFormBody(chosen.sections) : '';
      saveBtn.disabled = !chosen; tools.hidden = !chosen;
      if (chosen && !titleInp.value.trim()) titleInp.value = chosen.name;
    };
    tplSel.addEventListener('change', pick);
    pick();
    document.getElementById('nc-allok')!.addEventListener('click', async () => {
      const radios = Array.from(body.querySelectorAll<HTMLInputElement>('input[type=radio]'));
      // Masseendring: si hvor mange punkter det gjelder og få et ja først.
      const open = [...new Set(radios.map((r) => r.name))].filter((n) => !radios.some((r) => r.name === n && r.checked));
      if (!open.length) return;
      if (!(await askConfirm({ title: p('ncAllOk') + '?', body: fill(p('ncAllOkBody'), { n: open.length }), ok: p('ncAllOk') }))) return;
      new Set(radios.map((r) => r.name)).forEach((n) => {
        const grp = radios.filter((r) => r.name === n);
        if (!grp.some((r) => r.checked)) { const ok = grp.find((r) => r.value === 'ok'); if (ok) { ok.checked = true; ok.dataset.dirty = '1'; } }
      });
      form.dispatchEvent(new Event('change'));
    });
    const DRAFT = 'checklist-new:' + kind;
    bindFormDraft(DRAFT, form, () => renderNewChecklist(projectId, kind));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!chosen) return;
      const pe = document.getElementById('nc-proj-err')!; pe.hidden = true;
      const pid = projSel.value;
      if (!pid) { pe.textContent = p('ndProjectRequired'); pe.hidden = false; projSel.focus(); return; }
      const answers: Record<string, string> = {};
      body.querySelectorAll<HTMLInputElement>('input[type=radio]:checked').forEach((r) => { answers[r.name] = r.value; });
      body.querySelectorAll<HTMLInputElement>('input[data-note]').forEach((n) => { if (n.value.trim()) answers[n.dataset.note!] = n.value.trim(); });
      const finalTitle = titleInp.value.trim() || chosen.name;
      saveBtn.disabled = true; saveBtn.textContent = p('saving');
      try {
        const title_i18n = await formTitleI18n(finalTitle);
        const { error } = await supabase.from('checklists').insert({
          project_id: pid, type: kind, template_id: chosen.id, sections: chosen.sections,
          title: finalTitle, title_i18n,
          performed_by: (document.getElementById('nc-by') as HTMLInputElement).value.trim() || null,
          performed_date: (document.getElementById('nc-date') as HTMLInputElement).value || null,
          lang: lang(), answers, created_by: ME.id || null,
        });
        if (error) { toastError(error); return; }
        clearDraft(DRAFT);
        markClean(form);
        toast(fill(p('ncSaved'), { what: finalTitle }));
        if (ME.role === 'ansatt') renderFieldHome(); else openProject(pid);
      } finally { saveBtn.disabled = false; saveBtn.textContent = p('save'); }
    });
  }

  // Direktelenker (?view=…&id=…) og «siste registreringer» åpner enkeltposter.
  async function openDeviationById(devId: string, projectId: string) {
    const [{ data: d }, { data: pr }] = await Promise.all([
      supabase.from('deviations').select('*').eq('id', devId).maybeSingle(),
      supabase.from('projects').select('*').eq('id', projectId).maybeSingle(),
    ]);
    if (!d) { toast(p('errLoad'), 'err'); return renderDeviationCenter(); }
    CURRENT_PROJECT = pr;
    return openDeviationEditor(d, projectId);
  }
  async function openWorkDocById(id: string) {
    const { data: d } = await supabase.from('work_docs').select('*, projects(name)').eq('id', id).maybeSingle();
    if (!d) { toast(p('errLoad'), 'err'); return renderWorkDocs(); }
    return renderWorkDocEditor(d, d.project_id);
  }
  /** Siste dokumentasjon på prosjektet åpnes; finnes ingen, startes en ny. */
  async function openProjectWorkDoc(pid: string) {
    const { data } = await supabase.from('work_docs').select('*, projects(name)').eq('project_id', pid).order('created_at', { ascending: false }).limit(1);
    return renderWorkDocEditor(data && data.length ? data[0] : null, pid);
  }

  // Rediger et eksisterende avvik – alle felt + bildehåndtering + PDF
  async function openDeviationEditor(d: any, projectId: string) {
    redraw = () => openDeviationEditor(d, projectId);
    await ensureShell('deviations', { view: 'projects', id: projectId, dev: d.id });
    root.innerHTML = `<p class="portal-loading">…</p>`;
    await ensureDevConfig();
    let existingPhotos: any[] = [];
    const { data: ph } = await supabase.from('photos').select('*').eq('deviation_id', d.id);
    existingPhotos = ph || [];
    for (const x of existingPhotos) { const { data: s } = await supabase.storage.from(KS_PHOTO_BUCKET).createSignedUrl(x.storage_path, 3600); x.__url = s?.signedUrl || ''; }
    const pending: { blob: Blob; dataUrl: string }[] = [];
    const catOpts = DEV_CATS.map((c: any) => `<option value="${esc(c.name)}"${c.name === d.category ? ' selected' : ''}>${esc(devCatLabel(c.name))}</option>`).join('');
    const respOpts = DEV_RESP.map((r: any) => `<option value="${esc(r.name)}">`).join('');
    const sevOpt = (v: string, l: string) => `<option value="${v}"${d.severity === v ? ' selected' : ''}>${esc(l)}</option>`;
    const stOpt = (v: string, l: string) => `<option value="${v}"${(d.status || 'open') === v ? ' selected' : ''}>${esc(l)}</option>`;
    const ta = (id: string, label: string, val: string, rows = 3) => `<label class="p-field">${esc(label)}<textarea id="${id}" rows="${rows}">${esc(val || '')}</textarea></label>`;
    const inp = (id: string, label: string, val: string, type = 'text') => `<label class="p-field">${esc(label)}<input id="${id}" type="${type}" value="${esc(val || '')}"></label>`;
    root.innerHTML = `
      <button class="btn btn--ghost p-back" id="de-back"><span class="btn-ic">${ICONS.arrowLeft}</span>${esc(p('backGeneric'))}</button>
      <div class="p-card"><h1 style="margin:0 0 4px">${esc(devTitle(d))}</h1><p class="p-muted">${esc(CURRENT_PROJECT?.name || '')}</p></div>
      <div class="p-section">
        <p class="p-subhead" style="margin-top:0">${esc(p('devSecReporter'))}</p>
        <div class="p-grid2">${inp('de-no', t('devNo'), d.number)}${inp('de-date', t('date'), d.dev_date, 'date')}</div>
        ${inp('de-reporter', p('devReporter'), d.reporter)}
        <div class="p-grid2">
          <label class="p-field">${esc(p('devCategory'))}<select id="de-cat"><option value="">${esc(p('none'))}</option>${catOpts}</select></label>
          <label class="p-field">${esc(p('severity'))}<select id="de-sev"><option value="">${esc(p('none'))}</option>${sevOpt('lav', p('sevLow'))}${sevOpt('middels', p('sevMed'))}${sevOpt('hoy', p('sevHigh'))}</select></label>
        </div>
        ${inp('de-loc', t('location'), d.location)}
        ${ta('de-desc', t('description'), d.description, 6)}
        ${ta('de-corr', t('correction'), d.correction)}
        ${ta('de-improve', p('devImprovement'), d.improvement)}
        <div class="p-photopick">
          <label class="p-photo-btn"><span class="btn-ic">${ICONS.camera}</span><span>${esc(p('takePhoto'))}</span><input id="de-photos" type="file" accept="image/*" capture="environment" multiple hidden></label>
          <div class="p-thumbs" id="de-thumbs"></div>
        </div>
        <p class="p-subhead">${esc(p('devSecHandler'))}</p>
        <div class="p-grid2"><label class="p-field">${esc(t('responsible'))}<input id="de-resp" type="text" list="de-resp-list" value="${esc(d.responsible || '')}"><datalist id="de-resp-list">${respOpts}</datalist></label>${inp('de-due', p('dueDate'), d.due_date, 'date')}</div>
        ${ta('de-cause', t('cause'), d.cause)}
        ${ta('de-prevent', p('devPreventive'), d.preventive)}
        ${ta('de-verif', t('verification'), d.verification)}
        <div class="p-grid2">
          <label class="p-field">${esc(t('status'))}<select id="de-status">${stOpt('open', t('statusOpen'))}${stOpt('in_progress', p('statusInProgress'))}${stOpt('closed', t('statusClosed'))}</select></label>
          ${inp('de-informed', p('devReporterInformed'), d.reporter_informed, 'date')}
        </div>
        <div class="p-actionbar">
          <button class="btn btn--primary" id="de-save" type="button">${esc(p('save'))}</button>
          <span class="p-pdfpick">
            <label class="p-inline"><span class="sr-only">${esc(p('wdPdfLang'))}</span><select id="de-pdflang" aria-label="${esc(p('wdPdfLang'))}"><option value="no">NO</option><option value="pl">PL</option><option value="en">EN</option></select></label>
            <button class="btn btn--ghost" id="de-pdf" type="button">${esc(p('quotePreviewSend'))}</button>
          </span>
          <span class="p-muted" id="de-msg" role="status"></span>
        </div>
        <div class="p-dangerzone"><button class="btn btn--ghost btn--dangerghost" id="de-del" type="button"><span class="btn-ic">${ICONS.trash}</span>${esc(p('del'))}</button></div>
      </div>`;
    const drawThumbs = () => {
      document.getElementById('de-thumbs')!.innerHTML = existingPhotos.map((x: any) => `<div class="p-thumb"><img src="${esc(x.__url || '')}" alt=""><button class="p-thumb-del" data-pdel="${esc(x.id)}" type="button" aria-label="${esc(p('deletePhoto'))}">${ICONS.x}</button></div>`).join('') + pending.map((x, i) => `<div class="p-thumb"><img src="${x.dataUrl}" alt=""><button class="p-thumb-del" data-pend="${i}" type="button" aria-label="${esc(p('deletePhoto'))}">${ICONS.x}</button></div>`).join('');
      document.querySelectorAll<HTMLElement>('#de-thumbs [data-pend]').forEach((b) => b.addEventListener('click', () => { pending.splice(+b.dataset.pend!, 1); drawThumbs(); }));
      document.querySelectorAll<HTMLElement>('#de-thumbs [data-pdel]').forEach((b) => b.addEventListener('click', async () => {
        const id = b.dataset.pdel!; const x = existingPhotos.find((z: any) => z.id === id); if (!x) return;
        if (!(await confirmDelete('nPhoto'))) return;
        await supabase.storage.from(KS_PHOTO_BUCKET).remove([x.storage_path]);
        if (!(await runDelete(supabase.from('photos').delete().eq('id', id)))) return;
        existingPhotos = existingPhotos.filter((z: any) => z.id !== id); drawThumbs();
      }));
    };
    (document.getElementById('de-photos') as HTMLInputElement).addEventListener('change', async (e) => { const el = e.target as HTMLInputElement; for (const f of Array.from(el.files || [])) { const s = await shrink(f); pending.push(s); } el.value = ''; drawThumbs(); });
    document.getElementById('de-back')!.addEventListener('click', () => openProject(projectId));
    setViewChrome(devTitle(d), () => openProject(projectId));
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim() || null;
    const collect = () => { const statusVal = (document.getElementById('de-status') as HTMLSelectElement).value; return { number: val('de-no'), dev_date: val('de-date'), reporter: val('de-reporter'), category: (document.getElementById('de-cat') as HTMLSelectElement).value || null, severity: (document.getElementById('de-sev') as HTMLSelectElement).value || null, location: val('de-loc'), description: val('de-desc'), correction: val('de-corr'), improvement: val('de-improve'), responsible: val('de-resp'), due_date: val('de-due'), cause: val('de-cause'), preventive: val('de-prevent'), verification: val('de-verif'), status: statusVal, reporter_informed: val('de-informed'), closed_at: statusVal === 'closed' ? (d.closed_at || new Date().toISOString()) : null }; };
    const doSave = async (quiet = false) => {
      const msg = document.getElementById('de-msg')!; msg.textContent = p('saving');
      const patch = collect();
      const { error } = await supabase.from('deviations').update(patch).eq('id', d.id);
      if (error) { msg.textContent = ''; toastError(error); return false; }
      Object.assign(d, patch);
      let failed = 0; const total = pending.length;
      if (total) {
        msg.textContent = p('uploading');
        for (const phn of pending) {
          const path = `${projectId}/${d.id}/${crypto.randomUUID()}.jpg`;
          const up = await supabase.storage.from(KS_PHOTO_BUCKET).upload(path, phn.blob, { contentType: 'image/jpeg' });
          if (up.error) { failed++; continue; }
          const ins = await supabase.from('photos').insert({ project_id: projectId, deviation_id: d.id, storage_path: path, created_by: ME.id || null }).select().single();
          if (ins.error || !ins.data) { failed++; continue; }
          const { data: s } = await supabase.storage.from(KS_PHOTO_BUCKET).createSignedUrl(path, 3600);
          existingPhotos.push({ ...ins.data, __url: s?.signedUrl || '' });
        }
        pending.length = 0; drawThumbs();
      }
      msg.textContent = '';
      markClean(root);
      if (!quiet) toast(p('savedShort'));
      reportUploadFailures(failed, total);
      return true;
    };
    document.getElementById('de-save')!.addEventListener('click', () => doSave());
    // Ett PDF-valg i stedet for fire knapper: språket velges, innholdet oversettes ved behov.
    const dePdf = async (target: string) => {
      if (!(await doSave(true))) return;
      if (target === lang()) { await makeDeviationPdf(d); return; }
      const code = target === 'pl' ? 'PL' : target === 'en' ? 'EN' : 'NB';
      const strings: string[] = [t('deviation'), t('handoverTitle'), t('devNo'), t('date'), t('status'), devStatusLabel(d.status), p('devCategory'), (d.category ? devCatLabel(d.category) : ''), p('severity'), (d.severity ? devSeverityLabel(d.severity) : ''), p('dueDate'), 'Iht. Internkontrollforskriften § 5', 'Avviksrapport', p('devSecReporter'), p('devSecHandler'), p('devReporter'), t('location'), t('description'), t('correction'), p('devImprovement'), t('responsible'), t('cause'), p('devPreventive'), t('verification'), p('devReporterInformed'), p('devClosedDate'), t('photos'), d.reporter, d.location, d.description, d.correction, d.improvement, d.responsible, d.cause, d.preventive, d.verification];
      const msg = document.getElementById('de-msg')!; msg.textContent = p('translating');
      try { const m = await translateMap(strings.filter(Boolean), code); msg.textContent = ''; await makeDeviationPdf(d, (s: string) => m.get(s) || s, langName(code)); }
      catch (e: any) { msg.textContent = ''; toast((p('translateFail') + ' ' + (e.message || '')).trim(), 'err'); }
    };
    const pdfLangSel = document.getElementById('de-pdflang') as HTMLSelectElement;
    pdfLangSel.value = 'no';
    document.getElementById('de-pdf')!.addEventListener('click', (e) => pdfBusy(e.currentTarget as HTMLButtonElement, () => dePdf(pdfLangSel.value)));
    document.getElementById('de-del')!.addEventListener('click', async () => {
      if (!(await confirmDelete('nDeviation', d.number))) return;
      if (await runDelete(supabase.from('deviations').delete().eq('id', d.id))) openProject(projectId);
    });
    drawThumbs();
  }

  // Bygg inn en Unicode-font (DejaVu Sans) i PDF-ene så æøå og polske tegn (ł/ś/ż osv.) vises riktig.
  let PDF_FONT_CACHE: { reg: string; bold: string } | null = null;
  async function ensurePdfFont(doc: any) {
    try {
      if (!PDF_FONT_CACHE) {
        const toB64 = (buf: ArrayBuffer) => {
          const bytes = new Uint8Array(buf); let bin = '';
          for (let i = 0; i < bytes.length; i += 0x8000) bin += String.fromCharCode.apply(null, Array.from(bytes.subarray(i, i + 0x8000)) as any);
          return btoa(bin);
        };
        const [r, b] = await Promise.all([
          fetch('/fonts/DejaVuSans.ttf').then((x) => x.arrayBuffer()),
          fetch('/fonts/DejaVuSans-Bold.ttf').then((x) => x.arrayBuffer()),
        ]);
        PDF_FONT_CACHE = { reg: toB64(r), bold: toB64(b) };
      }
      doc.addFileToVFS('DejaVuSans.ttf', PDF_FONT_CACHE.reg);
      doc.addFont('DejaVuSans.ttf', 'DejaVu', 'normal');
      doc.addFileToVFS('DejaVuSans-Bold.ttf', PDF_FONT_CACHE.bold);
      doc.addFont('DejaVuSans-Bold.ttf', 'DejaVu', 'bold');
      doc.setFont('DejaVu', 'normal');
    } catch (_e) { /* faller tilbake til standardfont */ }
  }

  async function makeDeviationPdf(d: any, T: (s: string) => string = (s) => s, lang = '') {
    // hent bilder (signerte URL-er) og konverter til dataURL
    const { data: phRows } = await supabase.from('photos').select('*').eq('deviation_id', d.id);
    const imgs: string[] = [];
    for (const ph of phRows || []) {
      const { data: signed } = await supabase.storage.from(KS_PHOTO_BUCKET).createSignedUrl(ph.storage_path, 120);
      if (signed?.signedUrl) {
        try {
          const blob = await (await fetch(signed.signedUrl)).blob();
          imgs.push(await new Promise<string>((r) => { const fr = new FileReader(); fr.onload = () => r(fr.result as string); fr.readAsDataURL(blob); }));
        } catch (e) {}
      }
    }
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    await ensurePdfFont(doc);
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    const block = (label: string, txt: string, translateVal = true) => {
      if (!txt) return;
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(9.5); doc.setTextColor(120);
      if (y > 275) { doc.addPage(); y = margin; }
      doc.text(T(label).toUpperCase(), margin, y); y += 4.5;
      doc.setFont('DejaVu', 'normal'); doc.setFontSize(10.5); doc.setTextColor(20, 23, 28);
      doc.splitTextToSize(translateVal ? T(txt) : txt, maxW).forEach((ln: string) => { if (y > 282) { doc.addPage(); y = margin; } doc.text(ln, margin, y); y += 5; }); y += 3;
    };
    doc.setFillColor(20, 23, 28); doc.rect(0, 0, pageW, 24, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('DejaVu', 'bold'); doc.setFontSize(16); doc.text('Dekmar AS', margin, 11);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(11); doc.text(T(t('deviation')) + ' – ' + T(t('handoverTitle')), margin, 18);
    doc.setTextColor(20, 23, 28); y = 32;
    const stTxt = devStatusLabel(d.status);
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(11);
    doc.text(`${T(t('devNo'))}: ${d.number || '—'}    ${T(t('date'))}: ${d.dev_date || '—'}    ${T(t('status'))}: ${T(stTxt)}`, margin, y); y += 6;
    const meta2 = [d.category ? `${T(p('devCategory'))}: ${T(devCatLabel(d.category))}` : '', d.severity ? `${T(p('severity'))}: ${T(devSeverityLabel(d.severity))}` : '', d.due_date ? `${T(p('dueDate'))}: ${d.due_date}` : ''].filter(Boolean).join('    ');
    if (meta2) { doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.text(meta2, margin, y); y += 6; }
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(8.5); doc.setTextColor(120); doc.text(T('Iht. Internkontrollforskriften § 5'), margin, y); y += 6; doc.setTextColor(20, 23, 28);
    const sec = (title: string) => { if (y > 270) { doc.addPage(); y = margin; } y += 1; doc.setDrawColor(204, 31, 42); doc.setLineWidth(0.4); doc.line(margin, y, margin + maxW, y); y += 5; doc.setFont('DejaVu', 'bold'); doc.setFontSize(10.5); doc.setTextColor(204, 31, 42); doc.text(T(title), margin, y); y += 6; doc.setTextColor(20, 23, 28); };
    sec(p('devSecReporter'));
    block(p('devReporter'), d.reporter); block(t('location'), d.location); block(t('description'), d.description);
    block(t('correction'), d.correction); block(p('devImprovement'), d.improvement);
    sec(p('devSecHandler'));
    block(t('responsible'), d.responsible); block(t('cause'), d.cause);
    block(p('devPreventive'), d.preventive); block(t('verification'), d.verification);
    if (d.reporter_informed) block(p('devReporterInformed'), d.reporter_informed, false);
    if (d.closed_at) block(p('devClosedDate'), fmt(d.closed_at), false);
    if (imgs.length) {
      if (y > 250) { doc.addPage(); y = margin; }
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(9.5); doc.setTextColor(120); doc.text(T(t('photos')).toUpperCase(), margin, y); y += 5; doc.setTextColor(20, 23, 28);
      const colW = (maxW - 6) / 2, rowH = colW * 0.72; let col = 0;
      imgs.forEach((src) => {
        if (y + rowH > 285) { doc.addPage(); y = margin; col = 0; }
        const x = margin + col * (colW + 6);
        try { doc.addImage(src, 'JPEG', x, y, colW, rowH); } catch (e) {}
        doc.setDrawColor(220); doc.rect(x, y, colW, rowH);
        if (col === 1) { y += rowH + 6; col = 0; } else col = 1;
      });
    }
    await deliverPdf(doc, `Dekmar_Avvik${lang ? '_' + lang : ''}_${(d.number || 'nr')}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `${T('Avviksrapport')} ${d.number || ''} – ${CURRENT_PROJECT?.name || ''}`.trim());
  }

