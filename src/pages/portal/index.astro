      const { data: cust } = await supabase.from('customers').select('id, tripletex_id').not('tripletex_id', 'is', null);
      const custMap: Record<string, string> = {}; (cust || []).forEach((c: any) => { custMap[c.tripletex_id] = c.id; });
      const rows = vals.filter((v: any) => !have.has(String(v.id))).map((v: any) => ({ tripletex_id: v.id, name: v.displayName || v.name || ('Prosjekt ' + v.id), client: v.customer?.name || null, customer_id: (v.customer?.id != null ? custMap[v.customer.id] : undefined) || null, address: v.deliveryAddress?.displayName || null, created_by: u.user?.id }));
