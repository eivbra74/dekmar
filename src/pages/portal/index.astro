  // Gjett om et Tripletex-produkt trenger FDV: fysiske varer ja, arbeid/tjenester nei.
  // Bruker Tripletex `isStockItem` naar den finnes; ellers navne-heuristikk (arbeidsord = nei).
  const FDV_WORK_RE = /(riving|montering|demontering|arbeid|timepris|\btime[rn]?\b|\brigg\b|frakt|kj[øo]ring|transport|prosjektledelse|prosjektadministrasjon|befaring|oppm[åa]ling|rydding|avfall|kranbil|\blift\b|produksjon|tilpasning|sveising|legging|tekking|dagrigg|mannskap|reise|diett|overtid|kontroll|dokumentasjon)/i;
  function guessFdv(v: any): boolean {
    if (FDV_WORK_RE.test(v.name || '')) return false;  // arbeid/tjeneste = ikke FDV
    if (v.isStockItem === true) return true;            // eksplisitt lagervare = fysisk
    return v.costExcludingVatCurrency != null;          // ellers: materiale hvis kostpris (isStockItem=false hos Dekmar betyr bare «ikke lagerstyrt», ikke «ikke materiale»)
  }

