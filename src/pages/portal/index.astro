  async function makeInspectionPdf(state: any, cust: any, photos: any[], T: (s: string) => string = (s) => s, lang = '') {
    const doc = new jsPDF({ unit: 'mm', format: 'a4' }); await ensurePdfFont(doc); const logo = await ensureLogo(); const co = QUOTE_LETTER.company || {};
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    if (logo) { try { doc.addImage(logo, 'PNG', margin, y, 20, 20); } catch (_e) { /* */ } }
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(15); doc.setTextColor(20, 23, 28); doc.text(T('Befaringsrapport'), margin + 26, y + 8);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 96, 104);
    doc.text('Oslo ' + fmt(new Date().toISOString()), pageW - margin, y + 6, { align: 'right' } as any);
    if (state.number) doc.text(state.number, pageW - margin, y + 11, { align: 'right' } as any);
    y += 26; doc.setTextColor(20, 23, 28);
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(12); doc.text(T(state.title || ''), margin, y); y += 7;
    const kv = (l: string, v: string, translateVal = true) => { if (!v) return; doc.setFont('DejaVu', 'bold'); doc.setFontSize(9); doc.setTextColor(90, 96, 104); doc.text(T(l) + ':', margin, y); doc.setFont('DejaVu', 'normal'); doc.setTextColor(20, 23, 28); const vv = translateVal ? T(v) : v; const lns = doc.splitTextToSize(vv, maxW - 40); lns.forEach((ln: string, k: number) => doc.text(ln, margin + 40, y + k * 4.6)); y += Math.max(5.2, lns.length * 4.6); };
    kv('Kunde', cust.name || '', false); kv('Adresse', state.address || '', false); kv('Befaringsdato', state.insp_date ? fmt(state.insp_date) : '', false); kv('Til stede', state.present || '', false);
    y += 2;
    if ((state.rows || []).length) {
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(10); doc.text(T(p('inspObs')), margin, y); y += 5;
      const xs = [margin, margin + 30, margin + 78, margin + 120, margin + 137, margin + maxW]; const ws = [28, 46, 40, 15, 21, 22];
      doc.setFontSize(7.6); doc.setTextColor(90, 96, 104);
      doc.text(T('Område'), xs[0], y); doc.text(T('Observasjon'), xs[1], y); doc.text(T('Anbefaling'), xs[2], y); doc.text(T(p('colTg')), xs[3], y); doc.text(T(p('colPrio')), xs[4], y); doc.text(T(p('colEstimate')), xs[5], y, { align: 'right' } as any);
      y += 2; doc.setDrawColor(210); doc.line(margin, y, margin + maxW, y); y += 4; doc.setTextColor(20, 23, 28);
      const tgColor: Record<string, number[]> = { tg0: [26, 127, 55], tg1: [138, 106, 0], tg2: [181, 81, 10], tg3: [204, 31, 42] };
      const PRIO_MAP: Record<string, string> = { now: 'prioNow', short: 'prioShort', long: 'prioLong', watch: 'prioWatch' };
      let estTotal = 0;
      state.rows.forEach((r: any) => {
        const t0 = doc.splitTextToSize(T(r.area || ''), ws[0]), t1 = doc.splitTextToSize(T(r.obs || ''), ws[1]), t2 = doc.splitTextToSize(T(r.rec || ''), ws[2]);
        const prioTxt = r.prio && PRIO_MAP[r.prio] ? T(p(PRIO_MAP[r.prio])) : '';
        const t4 = doc.splitTextToSize(prioTxt, ws[4]);
        const rowH = Math.max(t0.length, t1.length, t2.length, t4.length, 1) * 4.2;
        if (y + rowH > 282) { doc.addPage(); y = margin; }
        doc.setFont('DejaVu', 'normal'); doc.setFontSize(8);
        t0.forEach((ln: string, k: number) => doc.text(ln, xs[0], y + k * 4.2)); t1.forEach((ln: string, k: number) => doc.text(ln, xs[1], y + k * 4.2)); t2.forEach((ln: string, k: number) => doc.text(ln, xs[2], y + k * 4.2));
        if (r.tg) { const c = tgColor[r.tg] || [20, 23, 28]; doc.setFont('DejaVu', 'bold'); doc.setTextColor(c[0], c[1], c[2]); doc.text(String(r.tg).toUpperCase(), xs[3], y); doc.setTextColor(20, 23, 28); doc.setFont('DejaVu', 'normal'); }
        t4.forEach((ln: string, k: number) => doc.text(ln, xs[4], y + k * 4.2));
        if (r.cost) { doc.text(nok(numv(r.cost)), xs[5], y, { align: 'right' } as any); estTotal += numv(r.cost); }
        y += rowH + 2;
      });
      if (estTotal > 0) { if (y + 8 > 285) { doc.addPage(); y = margin; } doc.setDrawColor(20, 23, 28); doc.line(margin + 110, y, margin + maxW, y); y += 5; doc.setFont('DejaVu', 'bold'); doc.setFontSize(9.5); doc.text(T(p('inspTotalEstimate')), margin + 110, y); doc.text('kr ' + nok(estTotal), margin + maxW, y, { align: 'right' } as any); y += 6; doc.setFont('DejaVu', 'normal'); }
      y += 2;
    }
    if (state.summary) { if (y > 260) { doc.addPage(); y = margin; } doc.setFont('DejaVu', 'bold'); doc.setFontSize(10); doc.text(T(p('inspSummary')), margin, y); y += 5; doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.splitTextToSize(T(state.summary), maxW).forEach((ln: string) => { if (y > 285) { doc.addPage(); y = margin; } doc.text(ln, margin, y); y += 5; }); y += 3; }
    // bilder
    const imgs: string[] = [];
    for (const ph of photos) { if (ph.__url) { try { const blob = await (await fetch(ph.__url)).blob(); imgs.push(await new Promise<string>((r) => { const fr = new FileReader(); fr.onload = () => r(fr.result as string); fr.readAsDataURL(blob); })); } catch (_e) { /* */ } } }
    if (imgs.length) {
      if (y > 240) { doc.addPage(); y = margin; }
      doc.setFont('DejaVu', 'bold'); doc.setFontSize(10); doc.setTextColor(20, 23, 28); doc.text(T(p('inspPhotos')), margin, y); y += 5;
      const colW = (maxW - 6) / 2, rowH = colW * 0.72; let col = 0;
      imgs.forEach((src) => { if (y + rowH > 285) { doc.addPage(); y = margin; col = 0; } const x = margin + col * (colW + 6); try { doc.addImage(src, 'JPEG', x, y, colW, rowH); } catch (_e) { /* */ } doc.setDrawColor(220); doc.rect(x, y, colW, rowH); if (col === 1) { y += rowH + 6; col = 0; } else col = 1; });
    }
    await deliverPdf(doc, `Dekmar_Befaring${lang ? '_' + lang : ''}_${(state.number || state.title || '')}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `${T('Befaringsrapport')} ${state.number || ''} – ${state.title || ''}`.trim());
  }

  // ================= Timeføring / timebudsjett =================
  const TIME_ACTIVITIES = ['Riving', 'Tekking', 'Membran', 'Blikk/beslag', 'Isolasjon', 'Rigg og drift', 'Transport/kjøring', 'Befaring', 'Opprydding', 'Dokumentasjon'];
  function timeBar(logged: number, budget: number): string {
    if (!(budget > 0)) return '';
    const pct = Math.min(100, Math.round((logged / budget) * 100));
    const col = logged > budget ? '#cc1f2a' : (logged >= budget * 0.9 ? '#b5510a' : '#1a7f37');
    return `<div class="p-bar" title="${esc(nok(logged))} / ${esc(nok(budget))}"><span style="width:${pct}%;background:${col}"></span></div>`;
  }

