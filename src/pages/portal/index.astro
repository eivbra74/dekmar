  const SICK_TYPES: [string, string][] = [['egenmelding', 'sickEgen'], ['sykmelding', 'sickDoc'], ['barn', 'sickChild']];
  function sickTypeLabel(tp: string): string { const m: Record<string, string> = { egenmelding: 'sickEgen', sykmelding: 'sickDoc', barn: 'sickChild' }; return m[tp] ? p(m[tp]) : tp; }
  function daysInclusive(a: string, b: string): number { const d1 = new Date(a + 'T00:00:00Z').getTime(), d2 = new Date((b || a) + 'T00:00:00Z').getTime(); return Math.max(1, Math.round((d2 - d1) / 86400000) + 1); }

