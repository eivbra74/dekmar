  // ---------- Ansatte / invitasjon / roller ----------
  const ROLE_KEYS: Record<string, string> = { admin: 'roleAdmin', leder: 'roleLeder', ansatt: 'roleAnsatt' };
  const roleName = (r: string) => p(ROLE_KEYS[r] || 'roleAnsatt');

  /**
   * «for 3 timer siden» er lettere å lese enn et tidspunkt når spørsmålet er
   * «brukes dette i det hele tatt». Faller tilbake til dato når det er lenge
   * siden, fordi «for 94 dager siden» ikke er informasjon.
   */
  function since(iso: string | null): string {
    if (!iso) return p('neverSignedIn');
    const ms = Date.now() - new Date(iso).getTime();
    const min = Math.floor(ms / 60000);
    if (min < 2) return { no: 'nå nettopp', pl: 'przed chwilą', en: 'just now' }[lang()] || 'now';
    if (min < 60) return `${min} min`;
    const hrs = Math.floor(min / 60);
    if (hrs < 24) return `${hrs} t`;
    const days = Math.floor(hrs / 24);
    if (days <= 30) return `${days} d`;
    return fmt(iso);
  }

  async function renderTeam() {
    if (!guard('team')) return;
    redraw = renderTeam;
    await ensureShell('team');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const { data: profs } = await supabase
      .from('profiles')
      .select('id, full_name, email, role, created_at, last_sign_in_at, last_seen_at')
      .order('created_at');

    // Rollestyrt: kun admin ser rollemeny og passordfelt. Leder/ansatt ser rolle
    // som ren tekst og ingen passordfunksjon. (RLS avgjor hvilke RADER som kommer.)
    const admin = ME.role === 'admin';
    const canInvite = ME.role === 'admin' || ME.role === 'leder';
    const rows = (profs || []).map((pr: any) => {
      const isMe = pr.id === ME.id;
      const opts = ['admin', 'leder', 'ansatt']
        .map((r) => `<option value="${esc(r)}"${r === pr.role ? ' selected' : ''}>${esc(roleName(r))}</option>`)
        .join('');
      const roleCtrl = admin
        ? `<label class="p-field" style="margin:0;min-width:160px"><span class="p-muted" style="font-size:12px">${esc(p('roleLabel'))}</span><select data-role-for="${esc(pr.id)}">${opts}</select></label>`
        : `<div class="p-field" style="margin:0;min-width:120px"><span class="p-muted" style="font-size:12px">${esc(p('roleLabel'))}</span><span style="font-weight:600">${esc(roleName(pr.role))}</span></div>`;
      const pwBlock = admin ? `
        <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
          <label class="p-field" style="margin:0;flex:1;min-width:200px">
            <span class="p-muted" style="font-size:12px">${esc(p('setUserPw'))}</span>
            <input type="password" data-pw-for="${esc(pr.id)}" autocomplete="new-password" placeholder="${esc(p('pwPlaceholder'))}">
          </label>
          <button class="btn btn--ghost" type="button" data-pw-set="${esc(pr.id)}" data-pw-email="${esc(pr.email || '')}">${esc(p('pwSetBtn'))}</button>
          <span class="p-muted" data-pw-msg="${esc(pr.id)}" style="font-size:12px"></span>
        </div>` : '';
      return `
      <li class="p-item" style="cursor:default;flex-direction:column;align-items:stretch;gap:12px">
        <div style="display:flex;gap:12px;align-items:flex-start">
          <div style="flex:1">
            <h3>${esc(pr.email || pr.full_name || '—')}${isMe ? ` <span class="p-muted" style="font-weight:400">(${esc(p('youLabel'))})</span>` : ''}</h3>
            <p>
              ${esc(p('lastSignIn'))}: ${esc(since(pr.last_sign_in_at))}
              &nbsp;·&nbsp; ${esc(p('lastSeen'))}: ${esc(isMe ? p('lastSeenNow') : (pr.last_seen_at ? since(pr.last_seen_at) : '—'))}
              &nbsp;·&nbsp; ${esc(p('createdAt'))} ${esc(fmt(pr.created_at))}
            </p>
          </div>
          ${roleCtrl}
        </div>
        ${pwBlock}
      </li>`;
    }).join('');

    root.innerHTML = `
      <div class="p-head"><h1>${esc(p('team'))}</h1></div>
      ${canInvite ? `<div class="p-card">
        <h2 style="margin-top:0">${esc(p('invite'))}</h2>
        <form id="inv">
          <label class="p-field">${esc(p('inviteEmail'))}<input id="inv-email" type="email" required></label>
          <button class="btn btn--primary" type="submit">${esc(p('sendInvite'))}</button>
          <span class="p-muted" id="inv-msg" style="margin-left:10px"></span>
        </form>
      </div>` : ''}
      <div class="p-section">
        <h2>${esc(p('members'))}</h2>
        <p class="p-muted p-intro" style="margin-top:-4px">${esc(p('roleHelp'))}</p>
        <span class="p-muted" id="role-msg"></span>
        ${rows ? `<ul class="p-list">${rows}</ul>` : ''}
      </div>`;


    document.querySelectorAll<HTMLSelectElement>('[data-role-for]').forEach((sel) => {
      sel.addEventListener('change', async () => {
        const id = sel.dataset.roleFor!;
        const msg = document.getElementById('role-msg')!;
        const prev = Array.from(sel.options).find((o) => o.defaultSelected)?.value || 'ansatt';
        // Det maa alltid vaere minst én administrator: blokker degradering av siste admin.
        if (prev === 'admin' && sel.value !== 'admin') {
          const otherAdmins = (profs || []).filter((x: any) => x.role === 'admin' && x.id !== id).length;
          if (otherAdmins === 0) { msg.textContent = p('lastAdminBlock'); msg.style.color = '#cc1f2a'; sel.value = prev; return; }
        }
        msg.style.color = '';
        // Rollen styrer hva personen får se og endre: bekreft før den lagres.
        const who = (profs || []).find((x: any) => x.id === id);
        const ok = await askConfirm({ title: fill(p('roleConfirmTitle'), { name: (who && (who.full_name || who.email)) || '', role: roleName(sel.value) }), body: p('roleHelp'), ok: p('confirmLabel') });
        if (!ok) { sel.value = prev; return; }
        sel.disabled = true;
        const { error } = await supabase.from('profiles').update({ role: sel.value }).eq('id', id);
        sel.disabled = false;
        if (error) {
          // Triggeren protect_profile_role() avviser alle andre enn admin, så
          // dette er også det som fanger opp en bruker som mistet rollen sin
          // mens siden sto åpen.
          msg.textContent = error.message;
          sel.value = prev;
          return;
        }
        msg.textContent = ''; toast(p('roleSaved'));
        Array.from(sel.options).forEach((o) => { o.defaultSelected = o.value === sel.value; });
        // Endrer du din egen rolle, må menyen tegnes på nytt — ellers står du
        // igjen med punkter du ikke lenger har tilgang til.
        if (id === ME.id) { await loadMe(); paintShellChrome(); }
      });
    });

    // Admin setter/endrer passord for en bruker (edge-funksjon med service-role, admin-sjekk på server).
    document.querySelectorAll<HTMLButtonElement>('[data-pw-set]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.pwSet!;
        const email = btn.dataset.pwEmail || '';
        const inp = document.querySelector<HTMLInputElement>(`[data-pw-for="${id}"]`)!;
        const m = document.querySelector<HTMLElement>(`[data-pw-msg="${id}"]`)!;
        const pw = inp.value;
        if (!email) { m.textContent = '—'; m.style.color = '#cc1f2a'; return; }
        if (!pw || pw.length < 8) { m.textContent = p('pwTooShort'); m.style.color = '#cc1f2a'; return; }
        btn.disabled = true; m.style.color = ''; m.textContent = p('saving');
        const { data, error } = await supabase.functions.invoke('set-user-password', { body: { email, password: pw } });
        btn.disabled = false;
        if (error || (data && data.error)) {
          let detail = data?.error || error?.message || 'Feil';
          try { const body = await (error as any)?.context?.json?.(); if (body?.error) detail = body.error; } catch (_e) { /* ignore */ }
          m.textContent = detail; m.style.color = '#cc1f2a';
        } else {
          m.textContent = ''; toast(p('pwSetOk')); inp.value = '';
        }
      });
    });

    const invForm = document.getElementById('inv') as HTMLFormElement | null;
    if (invForm) invForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('inv-email') as HTMLInputElement).value.trim();
      const msg = document.getElementById('inv-msg')!;
      const btn = (e.target as HTMLFormElement).querySelector('button')!; btn.setAttribute('disabled', 'true'); msg.textContent = '…';
      const { data, error } = await supabase.functions.invoke('invite-user', { body: { email } });
      btn.removeAttribute('disabled');
      if (error || (data && data.error)) {
        // supabase-js gir en generisk feilmelding; hent den faktiske teksten fra svarkroppen
        let detail = data?.error || error?.message || 'Feil';
        try { const body = await (error as any)?.context?.json?.(); if (body?.error) detail = body.error; } catch (_e) { /* ignore */ }
        if (/already.*registered/i.test(detail)) detail = p('alreadyMember');
        msg.textContent = detail;
      }
      else { toast(p('inviteSent') + ' ' + email); await renderTeam(); }
    });
  }

