      state.rows.forEach((r: any) => { strings.push(r.area); strings.push(r.obs); strings.push(r.rec); });
      try { const m = await translateMap(strings.filter(Boolean), target); msg.textContent = ''; await makeInspectionPdf(state, cust, existingPhotos, (s: string) => m.get(s) || s, langName(target)); }
      catch (e: any) { msg.textContent = (p('translateFail') + ' ' + (e.message || '')).trim(); }
