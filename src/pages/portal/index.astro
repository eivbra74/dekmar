  //
  // MERK: dette filtrerer MENYEN. Selve låsen ligger i RLS (migrasjon 018) —
  // uten den kunne en ansatt lest hele kunderegisteret og alle marginer fra
  // nettleserkonsollen uansett hva menyen viser. Endrer du denne listen, endre
  // policyene i samme slengen.
  const ROLE_ACCESS: Record<string, string[]> = {
    dashboard:   ['admin', 'leder', 'ansatt'],
    projects:    ['admin', 'leder', 'ansatt'],
    inspections: ['admin', 'leder', 'ansatt'],
    resource:    ['admin', 'leder', 'ansatt'],
