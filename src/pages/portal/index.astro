      </div>
      <div id="calc-body"><p class="portal-loading">…</p></div>`;
    root.querySelectorAll('[data-ct]').forEach((b) => b.addEventListener('click', () => { CALC_TAB = (b as HTMLElement).dataset.ct!; renderCalc(); }));
    if (CALC_TAB === 'materials') return renderMaterialsTab();
    if (CALC_TAB === 'orders') return renderOrdersTab();
    return renderCalcsTab();
  }

