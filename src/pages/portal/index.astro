        : `<button class="btn btn--ghost p-sm" data-edit="${esc(tp.id)}">${esc(p('edit'))}</button>
           <button class="btn btn--ghost p-sm" data-dup="${esc(tp.id)}">${esc(p('duplicate'))}</button>
