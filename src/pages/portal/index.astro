  async function renderWorkDocEditor(docIn: any, projectId: string) {
    let doc: any = docIn;
    let currentId: string | null = doc?.id || null;
    const isNew = !currentId;
    const draftK = () => 'workdoc:' + (currentId || 'new:' + projectId);
    await ensureShell('workdoc', { view: 'workdoc', id: currentId, new: currentId ? null : projectId });
    const projs = await wdActiveProjects();
    const projName = (projs.find((x: any) => x.id === projectId) || {}).name || doc?.projects?.name || '';
    const genEid = () => 'e' + Math.random().toString(36).slice(2, 9);
    // Utkast fra en avbrutt økt (fanen ble lukket mens kameraet var åpent o.l.).
    const draft = REDRAWING ? null : loadDraft(draftK());
    let entries: any[] = (doc && Array.isArray(doc.entries)) ? JSON.parse(JSON.stringify(doc.entries)) : [];
    if (draft && Array.isArray(draft.data?.order)) {
      const byId = new Map(entries.map((e: any) => [e.id, e]));
      entries = draft.data.order.map((id: string) => byId.get(id) || { id, location: '', work: '', materials: '', method: '' });
    }
    if (!entries.length) entries = [{ location: '', work: '', materials: '', method: '' }];
    entries.forEach((e) => { if (!e.id) e.id = genEid(); });
    const removedEids = new Set<string>([...(doc?.__removed || []), ...((draft && draft.data?.removed) || [])]);
    const dflt = (v: any, d: string) => esc(v || (isNew ? d : ''));
    root.innerHTML = `
      <button class="btn btn--ghost p-back" id="wd-back" type="button"><span class="btn-ic">${ICONS.arrowLeft}</span>${esc(p('backGeneric'))}</button>
      <div class="p-head"><div><h1 class="p-viewh1">${esc(p('workdocNav'))}</h1><p class="p-muted">${esc(projName)}</p></div></div>
      <div id="wd-form">
        <div class="p-card">
          <div class="p-grid2">
            <label class="p-field">${esc(p('wdTitle'))}<input id="wd-title" type="text" value="${esc(wdI18nVal(doc, 'title'))}"></label>
            <label class="p-field">${esc(p('wdClient'))}<input id="wd-client" type="text" value="${esc(doc?.client || '')}"></label>
          </div>
          <div class="p-grid2">
            <label class="p-field">${esc(t('performedBy'))}<input id="wd-by" type="text" value="${dflt(doc?.performed_by, ME.name)}"></label>
            <div class="p-grid2">
              <label class="p-field">${esc(p('wdPeriodFrom'))}<input id="wd-from" type="date" value="${dflt(doc?.period_from, todayISO())}"></label>
              <label class="p-field">${esc(p('wdPeriodTo'))}<input id="wd-to" type="date" value="${dflt(doc?.period_to, todayISO())}"></label>
            </div>
          </div>
          <label class="p-field">${esc(p('wdSummary'))}<textarea id="wd-summary" rows="3">${esc(wdI18nVal(doc, 'summary'))}</textarea></label>
        </div>
        <div class="p-section">
          <h2>${esc(p('wdEntries'))}</h2>
          <div id="wd-entries">${entries.map((e, i) => wdEntryRow(e, i + 1)).join('')}</div>
          <button class="btn btn--ghost" id="wd-add-entry" type="button"><span class="btn-ic">${ICONS.plus}</span>${esc(p('wdAddEntry').replace(/^\+\s*/, ''))}</button>
        </div>
        <div class="p-card">
          <label class="p-field">${esc(p('wdControl'))}<textarea id="wd-control" rows="2">${esc(wdI18nVal(doc, 'control'))}</textarea></label>
          <label class="p-field">${esc(p('wdConclusion'))}<textarea id="wd-conclusion" rows="2">${esc(wdI18nVal(doc, 'conclusion'))}</textarea></label>
        </div>
        <div class="p-actionbar">
          <button class="btn btn--primary" id="wd-save" type="button">${esc(p('save'))}</button>
          <span class="p-pdfpick">
            <select id="wd-pdflang" aria-label="${esc(p('wdPdfLang'))}"><option value="no">NO</option><option value="pl">PL</option><option value="en">EN</option></select>
            <button class="btn btn--ghost" id="wd-export" type="button">${esc(p('quotePreviewSend'))}</button>
          </span>
          <span class="p-muted" id="wd-msg" role="status"></span>
        </div>
      </div>`;
    const formEl = document.getElementById('wd-form')!;
    const entriesEl = document.getElementById('wd-entries')!;
    const saveBtn = document.getElementById('wd-save') as HTMLButtonElement;
    const msg = document.getElementById('wd-msg')!;
    document.getElementById('wd-back')!.addEventListener('click', () => goNav('workdoc'));
    setViewChrome(wdI18nVal(doc, 'title') || p('workdocNav'), () => goNav('workdoc'));

    // Språkbytte tegner på nytt med samme punkter i samme rekkefølge, også nye som ikke er lagret.
    const structDoc = () => {
      const byId = new Map(((doc && doc.entries) || []).map((e: any) => [e.id, e]));
      const order = Array.from(entriesEl.querySelectorAll<HTMLElement>('.wd-entry')).map((c) => c.dataset.eid!);
      return { ...(doc || {}), id: currentId, entries: order.map((id) => byId.get(id) || { id, location: '', work: '', materials: '', method: '' }), __removed: [...removedEids] };
    };
    redraw = () => renderWorkDocEditor(structDoc(), projectId);

    const renumber = () => {
      const cards = Array.from(entriesEl.querySelectorAll<HTMLElement>('.wd-entry'));
      cards.forEach((c, i) => {
        c.querySelector('.wd-entry-n')!.textContent = fill(p('wdEntryN'), { n: i + 1 });
        (c.querySelector('.wd-del-entry') as HTMLElement).hidden = cards.length <= 1;
      });
    };
    const storeDraft = () => saveDraft(draftK(), {
      order: Array.from(entriesEl.querySelectorAll<HTMLElement>('.wd-entry')).map((c) => c.dataset.eid!),
      removed: [...removedEids],
      fields: snapshotFields(formEl, true),
    });
    let draftTmr: any = 0;
    const queueDraft = () => { clearTimeout(draftTmr); draftTmr = setTimeout(storeDraft, 350); };
    formEl.addEventListener('input', queueDraft);
    formEl.addEventListener('change', queueDraft);

    const bindEntryDel = () => entriesEl.querySelectorAll<HTMLElement>('.wd-del-entry').forEach((b) => b.onclick = async () => {
      if (entriesEl.querySelectorAll('.wd-entry').length <= 1) return;
      const card = b.closest('.wd-entry') as HTMLElement; const eid = card.dataset.eid!;
      let count = 0;
      if (currentId) {
        const r = await supabase.from('photos').select('id', { count: 'exact', head: true }).eq('work_doc_id', currentId).eq('entry_ref', eid);
        count = r.count || 0;
      }
      const hasText = Array.from(card.querySelectorAll<HTMLInputElement>('.wd-loc,.wd-mat,.wd-work,.wd-method')).some((x) => x.value.trim());
      if (count && !(await askConfirm({ title: fill(p('wdRemoveWithPhotos'), { n: count }), ok: p('wdRemoveEntry'), danger: true }))) return;
      if (!count && hasText && !(await askConfirm({ title: p('wdRemoveEntry') + '?', ok: p('wdRemoveEntry'), danger: true }))) return;
      if (count) removedEids.add(eid);
      card.remove(); renumber(); queueDraft();
    });
    bindEntryDel(); renumber();
    document.getElementById('wd-add-entry')!.addEventListener('click', () => {
      const n = entriesEl.querySelectorAll('.wd-entry').length + 1;
      entriesEl.insertAdjacentHTML('beforeend', wdEntryRow({ id: genEid(), location: '', work: '', materials: '', method: '' }, n));
      bindEntryDel(); renumber(); renderAllEntryPhotos(); queueDraft();
      const last = entriesEl.querySelector<HTMLInputElement>('.wd-entry:last-child .wd-loc'); if (last) last.focus();
    });
    // Tomme punkter droppes ved lagring, men ikke hvis de har bilder (da ville bildene mistet punktet sitt).
    const entryHasPhotos = (c: HTMLElement) => Number((c.querySelector('.wd-entry-photos') as HTMLElement | null)?.dataset.n || 0) > 0;
    const collectEntries = () => Array.from(entriesEl.querySelectorAll<HTMLElement>('.wd-entry')).map((c: any) => ({
      id: (c as HTMLElement).dataset.eid,
      location: (c.querySelector('.wd-loc') as HTMLInputElement).value.trim(),
      work: (c.querySelector('.wd-work') as HTMLTextAreaElement).value.trim(),
      materials: (c.querySelector('.wd-mat') as HTMLInputElement).value.trim(),
      method: (c.querySelector('.wd-method') as HTMLTextAreaElement).value.trim(),
      _keep: entryHasPhotos(c),
    })).filter((e: any) => e.location || e.work || e.materials || e.method || e._keep).map(({ _keep, ...e }: any) => e);

    // Bilder per arbeidspunkt: egne store Før/Under/Etter-knapper i hvert punkt.
    // Knappene virker også før første lagring: dokumentet lagres da automatisk først.
    const phaseNm = (ph: string) => ph === 'before' ? p('phaseBefore') : ph === 'during' ? p('phaseDuring') : ph === 'after' ? p('phaseAfter') : '';
    async function renderEntryPhotos(container: HTMLElement, eid: string) {
      let rows: any[] = [];
      if (currentId) { const r = await supabase.from('photos').select('*').eq('work_doc_id', currentId).eq('entry_ref', eid).order('created_at'); rows = r.data || []; }
      container.dataset.n = String(rows.length);
      const card = container.closest('.wd-entry') as HTMLElement | null;
      const where = ((card?.querySelector('.wd-loc') as HTMLInputElement | null)?.value || '').trim() || (card?.querySelector('.wd-entry-n')?.textContent || '');
      const thumbs = await Promise.all(rows.map(async (ph: any) => {
        const { data: s } = await supabase.storage.from(KS_PHOTO_BUCKET).createSignedUrl(ph.storage_path, 300);
        return `<figure class="wd-thumb"><img src="${s?.signedUrl || ''}" loading="lazy" alt="${esc(fill(p('wdPhotoAlt'), { phase: phaseNm(ph.phase), where }))}"><figcaption class="wd-thumb-ph">${esc(phaseNm(ph.phase))}</figcaption><button type="button" class="wd-thumb-del" data-wpdel="${esc(ph.id)}" data-path="${esc(ph.storage_path)}" data-phase="${esc(phaseNm(ph.phase))}" aria-label="${esc(p('deletePhoto'))}">${ICONS.x}</button></figure>`;
      }));
      const phBtn = (ph: string) => `<label class="p-photo-btn"><span class="btn-ic">${ICONS.camera}</span><span>${esc(phaseNm(ph))}</span><input type="file" data-phase="${ph}" accept="image/*" capture="environment" multiple hidden></label>`;
      container.innerHTML = `
        ${thumbs.length ? `<div class="wd-thumbs">${thumbs.join('')}</div>` : ''}
        <div class="wd-photo-btns">${phBtn('before')}${phBtn('during')}${phBtn('after')}</div>
        <span class="p-muted wd-ep-msg" role="status"></span>`;
      container.querySelectorAll<HTMLElement>('[data-wpdel]').forEach((b) => b.addEventListener('click', async () => {
        if (!(await confirmDelete('nPhoto', b.dataset.phase || ''))) return;
        await supabase.storage.from(KS_PHOTO_BUCKET).remove([b.dataset.path!]);
        if (await runDelete(supabase.from('photos').delete().eq('id', b.dataset.wpdel))) renderEntryPhotos(container, eid);
      }));
      container.querySelectorAll<HTMLInputElement>('input[type=file]').forEach((inp) => inp.addEventListener('change', async () => {
        const files = Array.from(inp.files || []); inp.value = '';
        if (!files.length) return;
        const msgEl = container.querySelector('.wd-ep-msg') as HTMLElement | null;
        if (!currentId) { if (msgEl) msgEl.textContent = p('saving'); if (!(await saveDoc(true)) || !currentId) { if (msgEl) msgEl.textContent = ''; return; } }
        const m2 = container.querySelector('.wd-ep-msg') as HTMLElement | null; if (m2) m2.textContent = p('uploading');
        const phase = inp.dataset.phase!;
        let failed = 0;
        for (const f of files) {
          const s = await shrink(f);
          const path = `${projectId}/workdoc/${currentId}/${crypto.randomUUID()}.jpg`;
          const up = await supabase.storage.from(KS_PHOTO_BUCKET).upload(path, s.blob, { contentType: 'image/jpeg' });
          if (up.error) { failed++; continue; }
          const ins = await supabase.from('photos').insert({ project_id: projectId, work_doc_id: currentId, storage_path: path, phase, entry_ref: eid, created_by: ME.id || null });
          if (ins.error) failed++;
        }
        reportUploadFailures(failed, files.length);
        renderEntryPhotos(container, eid);
      }));
    }
    const renderAllEntryPhotos = () => entriesEl.querySelectorAll<HTMLElement>('.wd-entry-photos').forEach((c) => renderEntryPhotos(c, c.dataset.eid!));

    // Lagring skriver først (raskt, også på dårlig nett) og oversetter etterpå i bakgrunnen.
    let saveSeq = 0;
    let writing: Promise<any> | null = null;     // en oversettelse som skrives akkurat nå
    let translating: Promise<void> | null = null;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    async function translateAndStore(seq: number, collected: any[], head: Record<string, string>) {
      const items: { ref: string; text: string }[] = Object.keys(head).map((k) => ({ ref: 'd.' + k, text: head[k] }));
      collected.forEach((e: any, i: number) => (['location', 'work', 'materials', 'method'] as string[]).forEach((k) => items.push({ ref: 'e' + i + '.' + k, text: e[k] || '' })));
      const bundle = await wdTranslateBundle(items);
      if (seq !== saveSeq || !currentId) return; // en nyere lagring har tatt over
      const i18n: any = {};
      (['no', 'pl', 'en'] as string[]).forEach((l) => { i18n[l] = {}; Object.keys(head).forEach((k) => { i18n[l][k] = bundle[l]['d.' + k]; }); });
      const withI18n = collected.map((e: any, i: number) => {
        const tri: any = {};
        (['no', 'pl', 'en'] as string[]).forEach((l) => { tri[l] = { location: bundle[l]['e' + i + '.location'], work: bundle[l]['e' + i + '.work'], materials: bundle[l]['e' + i + '.materials'], method: bundle[l]['e' + i + '.method'] }; });
        return { ...e, i18n: tri };
      });
      writing = Promise.resolve(supabase.from('work_docs').update({ i18n, entries: withI18n }).eq('id', currentId));
      const { error } = await writing; writing = null;
      if (!error && seq === saveSeq) doc = { ...(doc || {}), i18n, entries: withI18n };
    }
    async function saveDoc(quiet = false): Promise<boolean> {
      const seq = ++saveSeq;
      if (writing) await writing;
      saveBtn.disabled = true; saveBtn.textContent = p('saving');
      try {
        const head = { title: val('wd-title'), summary: val('wd-summary'), control: val('wd-control'), conclusion: val('wd-conclusion') };
        const collected = collectEntries();
        const payload: any = {
          project_id: projectId,
          title: head.title || null,
          client: val('wd-client') || null,
          performed_by: val('wd-by') || null,
          period_from: val('wd-from') || null,
          period_to: val('wd-to') || null,
          summary: head.summary || null,
          entries: collected,
          control: head.control || null,
          conclusion: head.conclusion || null,
          i18n: null,
        };
        const oldKey = draftK();
        let err: any;
        if (currentId) { const r = await supabase.from('work_docs').update(payload).eq('id', currentId); err = r.error; if (!err) doc = { ...(doc || {}), ...payload, id: currentId }; }
        else { payload.created_by = ME.id || null; const r = await supabase.from('work_docs').insert(payload).select().single(); err = r.error; if (!err && r.data) { currentId = r.data.id; doc = r.data; } }
        if (err) { msg.textContent = ''; toastError(err); return false; }
        const gone = [...removedEids].filter((id) => !collected.some((e: any) => e.id === id));
        if (currentId && gone.length) {
          const { data: ph } = await supabase.from('photos').select('id, storage_path').eq('work_doc_id', currentId).in('entry_ref', gone);
          if (ph && ph.length) {
            await supabase.storage.from(KS_PHOTO_BUCKET).remove(ph.map((x: any) => x.storage_path));
            await supabase.from('photos').delete().in('id', ph.map((x: any) => x.id));
          }
        }
        removedEids.clear();
        clearDraft(oldKey); clearDraft(draftK());
        markClean(formEl);
        setUrl({ view: 'workdoc', id: currentId }, true);
        msg.textContent = '';
        if (!quiet) toast(p('wdSaved'));
        renderAllEntryPhotos();
        translating = translateAndStore(seq, collected, head).catch(() => { /* språkversjonene lages ved neste lagring */ });
        return true;
      } finally { saveBtn.disabled = false; saveBtn.textContent = p('save'); }
    }
    saveBtn.addEventListener('click', () => saveDoc());
    const pdfLangSel = document.getElementById('wd-pdflang') as HTMLSelectElement;
    pdfLangSel.value = 'no';
    const exportBtn = document.getElementById('wd-export') as HTMLButtonElement;
    exportBtn.addEventListener('click', () => pdfBusy(exportBtn, async () => {
      // PDF-en lages alltid av det som står på skjermen: lagre først om noe er endret.
      const changed = !currentId || !!formEl.querySelector('[data-dirty]') || removedEids.size > 0;
      if (changed && !(await saveDoc(true))) return;
      if (translating) await translating;
      await makeWorkDocPdf(currentId!, projName, pdfLangSel.value);
    }));
    if (draft && draft.data?.fields && Object.keys(draft.data.fields).length) {
      restoreFields(formEl, draft.data.fields);
      draftNotice(formEl, draft.t, () => { clearDraft(draftK()); if (currentId) openWorkDocById(currentId); else renderWorkDocEditor(null, projectId); });
    }
    renderAllEntryPhotos();
  }

  async function makeWorkDocPdf(docId: string, projName: string, L: string = 'no') {
    // PDF-en til oppdragsgiver lages på valgt språk (standard norsk), ikke på språket til den som trykker.
    const pp = (k: string) => (P[k] ? P[k][L] : k);
    const tt = (k: string) => (UI[k] ? UI[k][L] : k);
    const vv = (obj: any, f: string) => wdI18nVal(obj, f, L);
    const { data: d } = await supabase.from('work_docs').select('*').eq('id', docId).single();
    if (!d) return;
    const { data: rows } = await supabase.from('photos').select('*').eq('work_doc_id', docId).order('created_at');
    const doc = new jsPDF({ unit: 'mm', format: 'a4' }); await ensurePdfFont(doc);
    const pageW = 210, margin = 15, maxW = pageW - margin * 2; let y = margin;
    const line = (txt: string, size = 10, style = 'normal', gap = 5, color = [20, 23, 28]) => {
      doc.setFont('DejaVu', style as any); doc.setFontSize(size); doc.setTextColor(color[0], color[1], color[2]);
      doc.splitTextToSize(txt || '', maxW).forEach((ln: string) => { if (y > 282) { doc.addPage(); y = margin; } doc.text(ln, margin, y); y += gap; });
      doc.setTextColor(20, 23, 28);
    };
    doc.setFillColor(20, 23, 28); doc.rect(0, 0, pageW, 24, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('DejaVu', 'bold'); doc.setFontSize(16); doc.text('Dekmar AS', margin, 11);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(11); doc.text(`${pp('workdocNav')} – ${projName || ''}`, margin, 18);
    doc.setTextColor(20, 23, 28); y = 32;
    const dTitle = vv(d, 'title'); if (dTitle) line(dTitle, 13, 'bold', 7);
    const meta = [d.client ? `${pp('wdClient')}: ${d.client}` : '', d.performed_by ? `${tt('performedBy')}: ${d.performed_by}` : '', (d.period_from || d.period_to) ? `${pp('wdPeriodFrom')} ${d.period_from || ''} – ${d.period_to || ''}` : ''].filter(Boolean).join('   ·   ');
    if (meta) line(meta, 9.5, 'normal', 6, [90, 96, 104]);
    const dSummary = vv(d, 'summary'); if (dSummary) { line(pp('wdSummary'), 11, 'bold', 5.5); line(dSummary, 10, 'normal', 5.5); y += 1; }
    (d.entries || []).forEach((e: any, i: number) => {
      if (y > 268) { doc.addPage(); y = margin; }
      y += 2; doc.setDrawColor(204, 31, 42); doc.setLineWidth(0.5); doc.line(margin, y, margin + maxW, y); y += 5;
      const eLoc = vv(e, 'location'), eWork = vv(e, 'work'), eMat = vv(e, 'materials'), eMet = vv(e, 'method');
      line(`${i + 1}. ${eLoc || pp('wdEntryLabel')}`, 12, 'bold', 6);
      if (eWork) { line(`${pp('wdWork')}:`, 9, 'bold', 4.5, [90, 96, 104]); line(eWork, 10, 'normal', 5); }
      if (eMat) line(`${pp('wdMaterials')}: ${eMat}`, 10, 'normal', 5);
      if (eMet) { line(`${pp('wdMethod')}:`, 9, 'bold', 4.5, [90, 96, 104]); line(eMet, 10, 'normal', 5); }
    });
    const dControl = vv(d, 'control'); if (dControl) { y += 2; line(pp('wdControl'), 11, 'bold', 5.5); line(dControl, 10, 'normal', 5.5); }
    const dConcl = vv(d, 'conclusion'); if (dConcl) { y += 2; line(pp('wdConclusion'), 11, 'bold', 5.5); line(dConcl, 10, 'normal', 5.5); }
    if (rows && rows.length) {
      const phaseName = (ph: string) => ph === 'before' ? pp('phaseBefore') : ph === 'during' ? pp('phaseDuring') : ph === 'after' ? pp('phaseAfter') : '';
      // Bilder gruppert per arbeidspunkt (Foer -> Under -> Etter); bilder uten gyldig punkt samles til slutt.
      const phaseOrd: any = { before: 0, during: 1, after: 2 };
      const byPhase = (a: any, b: any) => (phaseOrd[a.phase] ?? 3) - (phaseOrd[b.phase] ?? 3);
      const ents: any[] = d.entries || [];
      const groups = ents.map((e: any, i: number) => ({ head: `${i + 1}. ${vv(e, 'location') || pp('wdEntryLabel')}`, photos: rows.filter((ph: any) => ph.entry_ref === e.id).sort(byPhase) }));
      const rest = rows.filter((ph: any) => !ents.some((e: any) => e.id === ph.entry_ref));
      if (rest.length) groups.push({ head: pp('wdOtherPhotos'), photos: rest.sort(byPhase) });
      if (y > 250) { doc.addPage(); y = margin; }
      y += 4; doc.setDrawColor(204, 31, 42); doc.line(margin, y, margin + maxW, y); y += 6;
      line(pp('wdPhotos'), 12, 'bold', 6);
      const colW = (maxW - 6) / 2, rowH = colW * 0.72;
      for (const g of groups.filter((g) => g.photos.length)) {
        if (y + rowH + 16 > 285) { doc.addPage(); y = margin; }
        y += 2; line(g.head, 10.5, 'bold', 5.5);
        let col = 0;
        for (const ph of g.photos) {
          const { data: signed } = await supabase.storage.from(KS_PHOTO_BUCKET).createSignedUrl(ph.storage_path, 300);
          if (!signed?.signedUrl) continue;
          let dataUrl = '';
          try { const blob = await (await fetch(signed.signedUrl)).blob(); dataUrl = await new Promise<string>((r) => { const fr = new FileReader(); fr.onload = () => r(fr.result as string); fr.readAsDataURL(blob); }); } catch (e) { continue; }
          if (y + rowH + 8 > 285) { doc.addPage(); y = margin; col = 0; }
          const x = margin + col * (colW + 6);
          try { doc.addImage(dataUrl, 'JPEG', x, y, colW, rowH); } catch (e) { /* */ }
          doc.setDrawColor(220); doc.rect(x, y, colW, rowH);
          const cap = [ph.phase ? phaseName(ph.phase) : '', ph.caption || ''].filter(Boolean).join(' · ');
          if (cap) { doc.setFontSize(8); doc.setTextColor(80); doc.text(doc.splitTextToSize(cap, colW), x, y + rowH + 3.5); doc.setTextColor(20, 23, 28); }
          if (col === 1) { y += rowH + 12; col = 0; } else col = 1;
        }
        if (col === 1) y += rowH + 12;
      }
    }
    await deliverPdf(doc, `Dekmar_Arbeidsdokumentasjon_${projName || ''}.pdf`.replace(/[^a-z0-9]+/gi, '_'), `${pp('workdocNav')} – ${projName || ''}`);
  }

  // ---------- HMS-håndbok (artikler) ----------
  async function renderArticles() {
    redraw = renderArticles;
    await ensureShell('articles');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    await ensureArticles();
    // Offisielle håndbøker (kategori 'handbok') vises som fremhevet blokk øverst
    const { data: hb } = await supabase.from('documents').select('*').eq('category', 'handbok').order('title');
    const readBtns = getHandbooks().map((b: any) => `<button class="btn btn--ghost" data-hbread="${esc(b.key)}"><span class="app-nav-ic" style="width:16px;height:16px;vertical-align:-3px">${ICONS.handbook}</span> ${esc(p('readElectronic'))}: ${esc(bookTitle(b))}</button>`).join('');
    const hbHtml = `
      <div class="p-section">
        <h2>${esc(p('handbooksTitle'))}</h2>
        <div class="p-actions" style="margin-bottom:12px">${readBtns}</div>
        ${(hb && hb.length) ? `<div class="hb-grid">
          ${hb.map((d: any) => `
            <button class="hb-card" data-hb="${esc(d.storage_path)}">
              <span class="hb-ic">${ICONS.handbook}</span>
              <span class="hb-body"><span class="hb-title">${esc(locDocText(d.title))}</span>${d.file_name ? `<span class="hb-meta">${esc(d.file_name)}</span>` : ''}</span>
              <span class="hb-go">${esc(p('openDoc'))} ↓</span>
            </button>`).join('')}
        </div>` : ''}
      </div>`;
    const cats = Array.from(new Set(ARTICLES.map((a: any) => artText(a, 'category') || '—')));
    const groups = cats.map((cat) => {
      const items = ARTICLES.filter((a: any) => (artText(a, 'category') || '—') === cat).map((a: any) => `
        <li class="p-item" data-article="${esc(a.id)}">
          <div><h3>${esc(artText(a, 'title'))}</h3><p>${esc(artText(a, 'summary'))}</p></div>
          <span class="p-muted p-go-txt">${esc(p('readArticle'))} ${ICONS.chevron}</span>
        </li>`).join('');
      return `<div class="p-section"><h2>${esc(cat)}</h2><ul class="p-list">${items}</ul></div>`;
    }).join('');
    root.innerHTML = `
      <div class="p-head">
        <div><h1>${esc(p('hmsHandbook'))}</h1><p class="p-muted">${esc(p('articlesIntro'))}</p></div>
        <div class="p-user"><button class="btn btn--primary" id="art-new">${esc(p('newArticle'))}</button></div>
      </div>
      ${hbHtml}
      ${ARTICLES.length ? groups : `<p class="p-muted">${esc(p('noArticles'))}</p>`}`;
    document.getElementById('art-new')!.addEventListener('click', () => renderArticleEditor(null));
    root.querySelectorAll<HTMLElement>('[data-hb]').forEach((el) => el.addEventListener('click', async () => {
      const { data: signed } = await supabase.storage.from('ks-docs').createSignedUrl(el.dataset.hb!, 300);
      if (signed?.signedUrl) window.open(signed.signedUrl, '_blank');
    }));
    root.querySelectorAll<HTMLElement>('[data-hbread]').forEach((el) => el.addEventListener('click', () => renderHandbookReader(el.dataset.hbread!)));
    root.querySelectorAll<HTMLElement>('[data-article]').forEach((el) => el.addEventListener('click', () => renderArticle(ARTICLES.find((a: any) => a.id === el.dataset.article))));
  }

  // ---------- Elektronisk håndbok-leser (kapittelnavigasjon + søk, NO/PL/EN) ----------
  // Gir «neste gjennomgang» = revisjonsdato + 6 mnd, og varsel når forfalt
  // Lokalisert boktittel (innholdet i bøkene er trespråklig; tittelen er fast norsk i data)
  const BOOK_TITLE: Record<string, any> = {
    hms: { no: 'HMS-håndbok', pl: 'Podręcznik BHP', en: 'HSE handbook' },
    ks: { no: 'KS-håndbok', pl: 'Podręcznik KS', en: 'QA handbook' },
  };
  const bookTitle = (b: any) => (BOOK_TITLE[b.key] ? (BOOK_TITLE[b.key][lang()] || BOOK_TITLE[b.key].no) : b.title);
  // Lokaliserer de faste tokenene i revisjons-/dokumenttitler (data er norsk).
  // Filnavn (d.file_name) er den faktiske .docx-en og oversettes ikke.
  const DOC_I18N: Record<string, { pl: string; en: string }> = {
    'HMS-håndbok': { pl: 'Podręcznik BHP', en: 'HSE handbook' },
    'KS-håndbok': { pl: 'Podręcznik KS', en: 'QA handbook' },
    'Risikovurdering': { pl: 'Ocena ryzyka', en: 'Risk assessment' },
    'taktekking': { pl: 'prace dekarskie', en: 'roofing' },
    'Versjon': { pl: 'Wersja', en: 'Version' },
    'godkjent': { pl: 'zatwierdzono', en: 'approved' },
    'revidert': { pl: 'zmieniono', en: 'revised' },
  };
  const locDocText = (s: string) => {
    const L = lang(); if (L === 'no' || !s) return s;
    let out = s;
    for (const k of Object.keys(DOC_I18N)) out = out.split(k).join((DOC_I18N as any)[k][L] || k);
    return out;
  };
  function reviewInfo(reviewDate: string) {
    const base = new Date(reviewDate); if (isNaN(+base)) return null;
    const due = new Date(base); due.setMonth(due.getMonth() + 6);
    const overdue = Date.now() > +due;
    return { due: due.toLocaleDateString('nb-NO'), overdue };
  }
  function renderHandbookReader(key: string) {
    redraw = () => renderHandbookReader(key);
    const book = getHandbooks().find((b: any) => b.key === key);
    if (!book) { renderArticles(); return; }
    const L = lang();
    const chTitle = (c: any) => (L === 'pl' ? (c.title_pl || c.title) : L === 'en' ? (c.title_en || c.title) : c.title);
    const chBody = (c: any) => (L === 'pl' ? (c.pl || c.no) : L === 'en' ? (c.en || c.no) : c.no);
    const chapHtml = (chapters: any[]) => chapters.map((c: any, i: number) => `
      <details class="hb-chap" data-ci="${i}"><summary>${esc(chTitle(c))}</summary><div class="p-article">${chBody(c)}</div></details>`).join('');
    const ri = reviewInfo(book.reviewDate);
    const reviewBanner = ri ? (ri.overdue
      ? `<div class="hb-review overdue">${esc(p('reviewOverdue'))} (${esc(locDocText(book.revision))})</div>`
      : `<div class="hb-review">${esc(p('nextReview'))}: ${esc(ri.due)}</div>`) : '';
    root.innerHTML = `
      <div class="p-head">
        <div><h1>${esc(bookTitle(book))}</h1><p class="p-muted">${esc(locDocText(book.revision))}</p></div>
        <div class="p-user"><button class="btn btn--ghost" id="hbr-back"><span class="btn-ic">${ICONS.arrowLeft}</span>${esc(p('backGeneric'))}</button></div>
      </div>
      ${reviewBanner}
      <div class="p-searchbar"><span class="p-searchbar-ic">${ICONS.search}</span><input id="hbr-search" type="search" placeholder="${esc(p('searchHandbook'))}" autocomplete="off"></div>
      <div id="hbr-list">${chapHtml(book.chapters)}</div>
      <p class="p-muted" id="hbr-none" hidden>${esc(p('noHits'))}</p>`;
    document.getElementById('hbr-back')!.addEventListener('click', renderArticles);
    const search = document.getElementById('hbr-search') as HTMLInputElement;
    const list = document.getElementById('hbr-list')!;
    const none = document.getElementById('hbr-none')!;
    const chaps = Array.from(list.querySelectorAll<HTMLDetailsElement>('.hb-chap'));
    const texts = book.chapters.map((c: any) => (chTitle(c) + ' ' + chBody(c)).toLowerCase().replace(/<[^>]+>/g, ' '));
    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      chaps.forEach((el, i) => {
        const hit = !q || texts[i].includes(q);
        el.style.display = hit ? '' : 'none';
        el.open = !!q && hit;
        if (hit) shown++;
      });
      none.hidden = shown > 0;
    });
  }

  function renderArticle(a: any) {
    if (!a) { renderArticles(); return; }
    redraw = () => renderArticle(a);
    root.innerHTML = `
      <div class="p-head">
        <div><p class="p-muted" style="margin:0">${esc(artText(a, 'category'))}</p><h1 style="margin:2px 0 0">${esc(artText(a, 'title'))}</h1></div>
        <div class="p-user"><button class="btn btn--ghost" id="ar-edit">${esc(p('edit'))}</button><button class="btn btn--ghost" id="ar-back"><span class="btn-ic">${ICONS.arrowLeft}</span>${esc(p('backGeneric'))}</button></div>
      </div>
