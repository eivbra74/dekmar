  async function makeResourcePdf(wk: any, range: string, days: string[], roster: string[], dayKeys: string[], cell: any, projName: (id: string) => string) {
    const doc = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'landscape' }); await ensurePdfFont(doc); const logo = await ensureLogo();
    const pageW = 297, margin = 15, maxW = pageW - margin * 2; let y = margin;
    if (logo) { try { doc.addImage(logo, 'PNG', margin, y, 18, 18); } catch (_e) { /* */ } }
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(15); doc.setTextColor(20, 23, 28); doc.text(p('resourcePlan'), margin + 24, y + 7);
    doc.setFont('DejaVu', 'normal'); doc.setFontSize(10); doc.setTextColor(90, 96, 104); doc.text(`${p('weekLabel')} ${wk.w} · ${wk.y} · ${range}`, pageW - margin, y + 6, { align: 'right' } as any);
    y += 24; doc.setTextColor(20, 23, 28);
    const nameW = 50; const dayW = (maxW - nameW) / 7;
    doc.setFont('DejaVu', 'bold'); doc.setFontSize(8.5); doc.setTextColor(90, 96, 104);
    doc.text(p('weekEmployee'), margin, y); days.forEach((d, i) => doc.text(d, margin + nameW + i * dayW, y)); y += 2; doc.setDrawColor(210); doc.line(margin, y, margin + maxW, y); y += 4; doc.setTextColor(20, 23, 28);
    doc.setFontSize(8);
    roster.forEach((emp) => {
      const cells = dayKeys.map((dk) => (cell[emp + '|' + dk] || []).map((a: any) => projName(a.project_id)));
      const maxLines = Math.max(1, ...cells.map((c: string[]) => c.length));
      const rowH = maxLines * 4 + 3;
      if (y + rowH > 195) { doc.addPage(); y = margin; }
      doc.setFont('DejaVu', 'bold'); doc.text(doc.splitTextToSize(emp, nameW - 2)[0], margin, y);
      doc.setFont('DejaVu', 'normal');
      cells.forEach((c: string[], i: number) => c.forEach((nm, k) => doc.text(doc.splitTextToSize(nm, dayW - 2)[0], margin + nameW + i * dayW, y + k * 4)));
      y += rowH; doc.setDrawColor(235); doc.line(margin, y - 2, margin + maxW, y - 2);
    });
    await deliverPdf(doc, `Dekmar_Bemanningsplan_${wk.y}_uke${wk.w}.pdf`, `${p('resourcePlan')} – ${p('weekLabel')} ${wk.w}/${wk.y}`);
  }

