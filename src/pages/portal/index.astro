    const sortEl = document.getElementById('pl-sort') as HTMLSelectElement | null;
    const archEl = document.getElementById('pl-arch');
    const bind = (el: Element) => el.querySelectorAll('.p-item').forEach((li) => li.addEventListener('click', () => openProject((li as HTMLElement).dataset.id!)));
    const paintList = (q: string) => {
      const term = q.trim().toLowerCase();
      const flt = (arr: any[]) => term ? arr.filter((pr: any) => [pr.name, pr.address, pr.client].filter(Boolean).join(' ').toLowerCase().includes(term)) : arr;
      // Sorter foerst, filtrer etterpaa: motsatt rekkefoelge gir samme svar
      // her, men bryter i det en sortering trenger hele settet for aa vaere
      // meningsfull (rangering, loepenummer).
      const shownA = flt(applySort(activeAll, SORTS_PROJECTS, SORT_STATE.projects));
      listEl.innerHTML = shownA.length ? shownA.map(rowHtml).join('') : `<li class="p-muted" style="list-style:none;padding:8px 2px">${esc(p('noResults'))}</li>`;
      bind(listEl);
      if (archEl) { const shownB = flt(applySort(archivedAll, SORTS_PROJECTS, SORT_STATE.projects)); archEl.innerHTML = shownB.map(rowHtml).join('') || `<li class="p-muted" style="list-style:none;padding:8px 2px">${esc(p('noArchived'))}</li>`; bind(archEl); }
    };
    paintList('');
    const searchEl = document.getElementById('pl-search') as HTMLInputElement | null;
    if (searchEl) searchEl.addEventListener('input', () => paintList(searchEl.value));
    if (sortEl) sortEl.addEventListener('change', () => { SORT_STATE.projects = sortEl.value; paintList(searchEl ? searchEl.value : ''); });
