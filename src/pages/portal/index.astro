  // Verdi paa gitt spraak (standard: innlogget) fra i18n, med fallback til grunnfeltet.
  const wdI18nVal = (obj: any, field: string, L: string = lang()) => (obj && obj.i18n && obj.i18n[L] && obj.i18n[L][field]) || (obj && obj[field]) || '';
  // Oversetter en bunt tekstfelt til no/pl/en (kilde = gjeldende spraak).
  async function wdTranslateBundle(items: { ref: string; text: string }[]) {
    const src = lang();
    const res: any = { no: {}, pl: {}, en: {} };
    items.forEach((it) => { res[src][it.ref] = it.text; });
    const tmap: any = { no: 'NB', pl: 'PL', en: 'EN' };
    for (const tl of (['no', 'pl', 'en'] as string[]).filter((l) => l !== src)) {
      let m = new Map<string, string>();
      try { m = await translateMap(items.map((it) => it.text), tmap[tl]); } catch (_e) { /* behold kilde ved feil */ }
      items.forEach((it) => { res[tl][it.ref] = m.get(it.text) || it.text; });
    }
    return res;
  }
