  }

  // ---------- Tilbakemelding: kvittering, bekreftelse, feiltekst ----------
  const fill = (s: string, vars: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_m, k) => (vars[k] !== undefined ? String(vars[k]) : ''));

  // Én levende region som finnes fra start, så skjermlesere faktisk leser opp kvitteringene.
  const TOASTS = document.createElement('div');
  TOASTS.className = 'p-toasts';
  TOASTS.setAttribute('aria-live', 'polite');
  document.body.appendChild(TOASTS);
  function toast(msg: string, kind: 'ok' | 'err' = 'ok', detail = '') {
    const el = document.createElement('div');
    el.className = 'p-toast p-toast--' + kind;
    if (kind === 'err') el.setAttribute('role', 'alert');
    el.innerHTML = `<p class="p-toast-msg">${esc(msg)}${detail ? `<small>${esc(p('errDetails'))}: ${esc(detail)}</small>` : ''}</p><button type="button" class="p-toast-x" aria-label="${esc(p('close'))}">${ICONS.x}</button>`;
    const kill = () => { el.classList.add('is-out'); setTimeout(() => el.remove(), 220); };
    el.querySelector('.p-toast-x')!.addEventListener('click', kill);
    TOASTS.appendChild(el);
    setTimeout(kill, kind === 'err' ? 10000 : 3800);
  }
  /** Oversetter en rå Supabase-/nettverksfeil til noe en håndverker kan handle på. Den rå teksten følger med som detalj. */
  function friendlyError(e: any, fallbackKey = 'errGeneric'): { msg: string; detail: string } {
    const raw = String((e && (e.message || e.error_description || e.error)) || e || '');
    const code = String((e && e.code) || '');
    if ((typeof navigator !== 'undefined' && navigator.onLine === false) || /failed to fetch|networkerror|network request|load failed|timeout/i.test(raw)) return { msg: p('errNetwork'), detail: raw };
    if (code === '42501' || /row-level security|permission denied|not authori[sz]ed|forbidden/i.test(raw)) return { msg: p('errPermission'), detail: raw };
    return { msg: p(fallbackKey), detail: raw };
  }
  const toastError = (e: any, fallbackKey = 'errGeneric') => { const f = friendlyError(e, fallbackKey); toast(f.msg, 'err', f.detail); };

  /** Bekreftelse i appen (native <dialog>: Esc og fokusfelle følger med). Avbryt har fokus ved sletting. */
  function askConfirm(opts: { title: string; body?: string; ok: string; danger?: boolean }): Promise<boolean> {
    return new Promise((resolve) => {
      const dlg = document.createElement('dialog');
      dlg.className = 'p-dialog';
      dlg.innerHTML = `<form method="dialog"><h2 class="p-dialog-title">${esc(opts.title)}</h2>${opts.body ? `<p class="p-dialog-body">${esc(opts.body)}</p>` : ''}<div class="p-dialog-actions"><button class="btn btn--ghost" value="cancel">${esc(p('cancelLabel'))}</button><button class="btn ${opts.danger ? 'btn--danger' : 'btn--primary'}" value="ok">${esc(opts.ok)}</button></div></form>`;
      document.body.appendChild(dlg);
      dlg.addEventListener('close', () => { resolve(dlg.returnValue === 'ok'); dlg.remove(); });
      dlg.showModal();
      (dlg.querySelector(opts.danger ? 'button[value="cancel"]' : 'button[value="ok"]') as HTMLButtonElement).focus();
    });
  }
  const confirmDelete = (nounKey: string, name?: string | null) =>
    askConfirm({ title: fill(p('confirmTitleDelete'), { what: name ? `${p(nounKey)} «${name}»` : p(nounKey) }), body: p('cannotUndo'), ok: p('del'), danger: true });
  /** Kjører en sletting og sier fra om den faktisk gikk. */
  async function runDelete(q: PromiseLike<{ error: any }>): Promise<boolean> {
    const { error } = await q;
    if (error) { toastError(error, 'errDelete'); return false; }
    toast(p('deletedToast'));
    return true;
  }
  /** Knappen viser «Lager PDF …» til PDF-vinduet åpnes (deliverPdf sender 'p-pdf-ready'). */
  async function pdfBusy(btn: HTMLButtonElement | null, fn: () => Promise<any>) {
    if (!btn) return fn();
    if (btn.getAttribute('aria-busy') === 'true') return;
    const orig = btn.innerHTML;
    const done = () => { btn.removeAttribute('aria-busy'); btn.disabled = false; btn.innerHTML = orig; document.removeEventListener('p-pdf-ready', done); };
    btn.setAttribute('aria-busy', 'true'); btn.disabled = true; btn.textContent = p('makingPdf');
    document.addEventListener('p-pdf-ready', done);
    try { await fn(); } catch (e) { toastError(e); } finally { done(); }
  }
  /** Laster opp bilder og teller feilene i stedet for å svelge dem. */
  function reportUploadFailures(failed: number, total: number) {
    if (failed) toast(fill(p('photoUploadFailed'), { n: failed, total }), 'err');
  }

  // ---------- Skjematilstand: ingenting forsvinner ved språkbytte eller avbrudd ----------
  // Feltet brukeren har rørt får data-dirty. Et språkbytte tegner siden på nytt og legger
  // de rørte verdiene tilbake; urørte felt får den nye språkversjonen.
  PORTAL.addEventListener('input', (e) => markDirty(e.target), true);
  PORTAL.addEventListener('change', (e) => markDirty(e.target), true);
  function markDirty(t: EventTarget | null) {
    const el = t as HTMLInputElement | null;
    if (el && el.matches && el.matches('input,textarea,select') && el.type !== 'file' && el.type !== 'password') el.dataset.dirty = '1';
  }
  const markClean = (scope: ParentNode) => scope.querySelectorAll<HTMLElement>('[data-dirty]').forEach((el) => delete el.dataset.dirty);

  // Klikkbare listerader (li/tr) skal også kunne brukes med tastatur: Tab til raden, Enter/mellomrom åpner.
  const ROW_SEL = '.p-item:not([style*="cursor:default"]):not([tabindex]), tr[data-form]:not([tabindex]), tr[data-q]:not([tabindex]), tr[data-doc]:not([tabindex]), tr.p-click:not([tabindex])';
  new MutationObserver(() => PORTAL.querySelectorAll<HTMLElement>(ROW_SEL).forEach((el) => { el.tabIndex = 0; el.setAttribute('role', 'button'); })).observe(PORTAL, { childList: true, subtree: true });
  PORTAL.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    if ((e.key === 'Enter' || e.key === ' ') && el.getAttribute('role') === 'button' && !/^(BUTTON|A|INPUT|TEXTAREA|SELECT|LABEL)$/.test(el.tagName)) { e.preventDefault(); el.click(); }
  });
  function fieldSig(el: Element) { const h = el as HTMLElement; return el.tagName + '.' + (el.getAttribute('class') || '') + (h.dataset.note ? '[' + h.dataset.note + ']' : ''); }
  function fieldKey(el: Element, scope: ParentNode): string {
    if (el.id) return '#' + el.id;
    const sig = fieldSig(el);
    const same = Array.from(scope.querySelectorAll(el.tagName)).filter((x) => fieldSig(x) === sig);
    return sig + '@' + same.indexOf(el);
  }
  function snapshotFields(scope: ParentNode, onlyDirty: boolean): Record<string, any> {
    const out: Record<string, any> = {};
    scope.querySelectorAll<HTMLInputElement>('input,textarea,select').forEach((el) => {
      if (el.type === 'file' || el.type === 'password' || el.type === 'hidden') return;
      if (el.type === 'radio') {
        if (!el.checked) return;
        const grp = Array.from(scope.querySelectorAll<HTMLInputElement>('input[type=radio]')).filter((r) => r.name === el.name);
        if (onlyDirty && !grp.some((r) => r.dataset.dirty)) return;
        out['r:' + el.name] = el.value;
        return;
      }
      if (onlyDirty && !el.dataset.dirty) return;
      out[fieldKey(el, scope)] = el.type === 'checkbox' ? el.checked : el.value;
    });
    return out;
  }
  function restoreFields(scope: ParentNode, snap: Record<string, any>) {
    // Nedtrekk som bygger resten av skjemaet (mal, prosjekt) først, med change-hendelse.
    scope.querySelectorAll<HTMLSelectElement>('select[data-restore-change]').forEach((el) => {
      const k = fieldKey(el, scope);
      if (k in snap && el.value !== snap[k]) { el.value = String(snap[k]); el.dataset.dirty = '1'; el.dispatchEvent(new Event('change', { bubbles: true })); }
    });
    scope.querySelectorAll<HTMLInputElement>('input,textarea,select').forEach((el) => {
      if ((el as HTMLElement).hasAttribute('data-restore-change')) return;
      if (el.type === 'radio') { const v = snap['r:' + el.name]; if (v !== undefined) { el.checked = el.value === v; if (el.checked) el.dataset.dirty = '1'; } return; }
      const k = fieldKey(el, scope);
      if (!(k in snap)) return;
      if (el.type === 'checkbox') el.checked = !!snap[k]; else el.value = String(snap[k]);
      el.dataset.dirty = '1';
    });
  }

  // Utkast i nettleseren: overlever at telefonen dreper fanen mens kameraet er åpent.
  const draftKey = (k: string) => `dekmar-draft:${ME.id}:${k}`;
  function saveDraft(k: string, data: any) { try { localStorage.setItem(draftKey(k), JSON.stringify({ t: Date.now(), data })); } catch (_e) { /* full lagring: ikke kritisk */ } }
  function loadDraft(k: string): { t: number; data: any } | null { try { const s = localStorage.getItem(draftKey(k)); return s ? JSON.parse(s) : null; } catch (_e) { return null; } }
  function clearDraft(k: string) { try { localStorage.removeItem(draftKey(k)); } catch (_e) { /* */ } }
  function draftNotice(scope: HTMLElement, t: number, onDiscard: () => void) {
    const time = new Date(t).toLocaleTimeString(lang() === 'en' ? 'en-GB' : lang() === 'pl' ? 'pl-PL' : 'nb-NO', { hour: '2-digit', minute: '2-digit' });
    const n = document.createElement('div');
    n.className = 'p-draftnote';
    n.setAttribute('role', 'status');
    n.innerHTML = `<span>${esc(fill(p('draftRestored'), { time }))}</span><button type="button" class="p-linkbtn">${esc(p('draftDiscard'))}</button>`;
    n.querySelector('button')!.addEventListener('click', onDiscard);
    scope.prepend(n);
  }
  /** Knytter et skjema til et utkast: gjenoppretter det som finnes og lagrer rørte felt fortløpende. */
  function bindFormDraft(k: string, scope: HTMLElement, onDiscard: () => void) {
    const d = REDRAWING ? null : loadDraft(k);
    if (d && d.data && Object.keys(d.data).length) { restoreFields(scope, d.data); draftNotice(scope, d.t, () => { clearDraft(k); onDiscard(); }); }
    let tmr: any = 0;
    const store = () => { clearTimeout(tmr); tmr = setTimeout(() => saveDraft(k, snapshotFields(scope, true)), 350); };
    scope.addEventListener('input', store);
    scope.addEventListener('change', store);
  }

  // ---------- Adressen følger visningen ----------
  // Tilbake-knappen på telefonen og en oppdatering skal lande der du var.
  let URL_FROM_ROUTE = false;
  function setUrl(params: Record<string, string | null | undefined>, replace = false) {
    const q = new URLSearchParams();
    Object.entries(params).forEach(([k, v]) => { if (v) q.set(k, v); });
    const next = location.pathname + (q.toString() ? '?' + q.toString() : '');
    if (next === location.pathname + location.search) return;
    try { if (replace || URL_FROM_ROUTE) history.replaceState(null, '', next); else history.pushState(null, '', next); } catch (_e) { /* */ }
  }
  window.addEventListener('popstate', () => { route(); });

  // Gjeldende visning tegnes på nytt når språket byttes (KsLayout sender 'kslangchange').
  // Rørte felt legges tilbake etterpå, så halvutfylte skjemaer ikke tømmes.
  let redraw: () => any = () => route();
  let REDRAWING = false; // sant mens et språkbytte tegner på nytt: da hentes ikke utkast inn en gang til
  document.addEventListener('kslangchange', async () => {
    const snap = SHELL_BUILT ? snapshotFields(root, true) : {};
    if (SHELL_BUILT) paintShellChrome();
    REDRAWING = true;
    try { await redraw(); } finally { REDRAWING = false; }
    if (Object.keys(snap).length) restoreFields(root, snap);
  });

  // ---------- App-skall (sidemeny + hovedområde) ----------
  async function currentEmailSafe() { try { const { data } = await supabase.auth.getUser(); return data.user?.email || ''; } catch { return ''; } }
  // Admin-modus: kun disse brukerne ser import-knappene (Tripletex-sync). Rediger listen ved behov.
  const ADMIN_EMAILS = ['eivind@dekmar.no', 'post@dekmar.no', 'pawel@dekmar.no'];
  async function isAdmin() { return ADMIN_EMAILS.includes((await currentEmailSafe()).toLowerCase()); }
  function buildShell() {
    PORTAL.innerHTML = `
      <div class="app" data-drawer="closed">
        <div class="app-scrim" id="app-scrim"></div>
        <aside class="app-side" id="app-side">
          <div class="app-brand"><span class="app-brand-mark">HMS/KS</span><span class="app-brand-name">Dekmar</span></div>
          <nav class="app-nav" id="app-nav"></nav>
          <div class="app-side-foot">
            <div class="app-user" id="app-user"></div>
            <a class="app-logout" id="app-help" href="/ks/hjelp/"><span class="app-nav-ic">${ICONS.help}</span><span></span></a>
            <button class="app-logout" id="app-logout"><span class="app-nav-ic">${ICONS.logout}</span><span></span></button>
          </div>
        </aside>
        <div class="app-body">
          <header class="app-topbar">
            <button class="app-topback" id="app-topback" type="button" hidden>${ICONS.arrowLeft}</button>
            <button class="app-burger" id="app-burger" aria-controls="app-side" aria-expanded="false">${ICONS.menu}</button>
            <span class="app-topbar-title" id="app-topbar-title"></span>
          </header>
          <main class="app-main" id="pmain"></main>
        </div>
        <nav class="app-tabbar" id="app-tabbar"></nav>
      </div>`;
    SHELL_BUILT = true;
    root = document.getElementById('pmain')!;
    const side = document.getElementById('app-side')!;
    const app = PORTAL.querySelector('.app') as HTMLElement;
    const burger = document.getElementById('app-burger') as HTMLButtonElement;
    const isOpen = () => app.getAttribute('data-drawer') === 'open';
    const openDrawer = () => {
      app.setAttribute('data-drawer', 'open'); burger.setAttribute('aria-expanded', 'true');
      const first = side.querySelector<HTMLElement>('.app-nav-item.is-active') || side.querySelector<HTMLElement>('.app-nav-item');
      if (first) first.focus();
    };
    const closeDrawer = (refocus = false) => {
      if (!isOpen()) return;
      app.setAttribute('data-drawer', 'closed'); burger.setAttribute('aria-expanded', 'false');
      // Menyknappen i toppen er skjult på telefon; da får «Meny» i knapperaden fokus tilbake.
      if (refocus) { const target = burger.offsetParent ? burger : document.querySelector<HTMLElement>('[data-tab="menu"]'); target?.focus(); }
    };
    burger.addEventListener('click', () => (isOpen() ? closeDrawer(true) : openDrawer()));
    document.getElementById('app-scrim')!.addEventListener('click', () => closeDrawer(true));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) closeDrawer(true); });
    document.getElementById('app-logout')!.addEventListener('click', () => supabase.auth.signOut());
    document.getElementById('app-topback')!.addEventListener('click', () => { if (VIEW_BACK) VIEW_BACK(); });
    side.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('.app-nav-item')) closeDrawer(); });
    (window as any).__openDrawer = openDrawer;
    paintShellChrome();
  }
  /** Går til en menyvisning (brukes av menyen, snarveier og kort). */
  function goNav(id: string) {
    const n = NAV.find((x) => x.id === id);
    if (!n || !canSee(n.id)) return;
    ACTIVE_NAV = n.id; paintShellChrome(); n.run();
  }
  function paintShellChrome() {
    if (!SHELL_BUILT) return;
    const nav = document.getElementById('app-nav'); if (!nav) return;
    const item = (n: typeof NAV[number]) => `<button class="app-nav-item${n.id === ACTIVE_NAV ? ' is-active' : ''}" data-nav="${n.id}"${n.id === ACTIVE_NAV ? ' aria-current="page"' : ''}><span class="app-nav-ic">${ICONS[n.icon]}</span><span class="app-nav-label">${esc(n.label())}</span></button>`;
    nav.innerHTML = NAV_GROUPS.map((g) => {
      const items = g.ids.map((id) => NAV.find((n) => n.id === id)).filter((n): n is typeof NAV[number] => !!n && canSee(n.id));
      if (!items.length) return '';
      return `<div class="app-nav-group">${g.key ? `<p class="app-nav-glabel">${esc(p(g.key))}</p>` : ''}${items.map(item).join('')}</div>`;
    }).join('');
    nav.querySelectorAll<HTMLElement>('[data-nav]').forEach((b) => b.addEventListener('click', () => goNav(b.dataset.nav!)));
    const logoutLabel = document.querySelector('#app-logout span:last-child'); if (logoutLabel) logoutLabel.textContent = p('signOut');
    const helpLabel = document.querySelector('#app-help span:last-child'); if (helpLabel) helpLabel.textContent = t('help');
    const burger = document.getElementById('app-burger'); if (burger) burger.setAttribute('aria-label', p('menuLabel'));
    paintTopbar();
    paintTabbar();
  }
  // Toppen på telefon: visningens egen tittel og en tilbake-pil (menyen ligger i knapperaden nederst).
  let VIEW_TITLE = '';
  let VIEW_BACK: (() => void) | null = null;
  function setViewChrome(title: string, back?: () => void) { VIEW_TITLE = title; VIEW_BACK = back || null; paintTopbar(); }
  function paintTopbar() {
    const title = document.getElementById('app-topbar-title');
    if (title) { const n = NAV.find((x) => x.id === ACTIVE_NAV); title.textContent = VIEW_TITLE || (n ? n.label() : ''); }
    const back = document.getElementById('app-topback') as HTMLButtonElement | null;
    if (back) { back.hidden = !VIEW_BACK; back.setAttribute('aria-label', p('backGeneric')); }
  }
  // Fast knapperad nederst på telefon: de fire tingene man gjør i felt, pluss menyen.
  function paintTabbar() {
    const bar = document.getElementById('app-tabbar'); if (!bar) return;
    const cur = new URLSearchParams(location.search).get('view') || 'dashboard';
    const tab = (id: string, icon: string, label: string) => `<button type="button" class="app-tab${cur === id ? ' is-active' : ''}" data-tab="${id}"${cur === id ? ' aria-current="page"' : ''}><span class="app-tab-ic">${ICONS[icon]}</span><span class="app-tab-l">${esc(label)}</span></button>`;
    bar.setAttribute('aria-label', p('menuLabel'));
    bar.innerHTML = tab('dashboard', ME.role === 'ansatt' ? 'home' : 'dashboard', ME.role === 'ansatt' ? p('homeLabel') : p('overview'))
      + tab('deviation-new', 'deviation', p('fieldReport'))
      + tab('checklist-new', 'checklist', t('checklist'))
      + tab('workdoc', 'camera', p('wdPhotos'))
      + `<button type="button" class="app-tab" data-tab="menu"><span class="app-tab-ic">${ICONS.menu}</span><span class="app-tab-l">${esc(p('menuLabel'))}</span></button>`;
    bar.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
      const id = b.dataset.tab!;
      if (id === 'menu') { (window as any).__openDrawer?.(); return; }
      if (id === 'deviation-new') { renderNewDeviation(fieldProject()); return; }
      if (id === 'checklist-new') { renderNewChecklist(fieldProject(), 'checklist'); return; }
      goNav(id);
    }));
  }
  async function ensureShell(navId?: string, url?: Record<string, string | null | undefined>) {
    // Rollen foerst. Tegnes menyen foer den er kjent, vises den som 'ansatt'
    // og hopper naar svaret kommer — og verre: guard() ville avvist en leder.
    if (!ME.id) await loadMe();
    if (!SHELL_BUILT) buildShell();
    if (navId) ACTIVE_NAV = navId;
    if (url) setUrl(url); else if (navId) setUrl({ view: navId === 'dashboard' ? null : navId });
    VIEW_TITLE = ''; VIEW_BACK = null;
    paintShellChrome();
    const ue = document.getElementById('app-user'); if (ue && !ue.textContent) ue.textContent = ME.name || await currentEmailSafe();
  }
  function teardownShell() { SHELL_BUILT = false; root = PORTAL; PORTAL.innerHTML = ''; }

  // ---------- Maler (templates) ----------
  async function ensureTemplates() {
    if (!TEMPLATES_SEEDED) {
      // upsert standardmaler på slug slik at innholdsendringer propagerer (standardmaler er ikke redigerbare i UI, kun «Dupliser»)
      const { data: u } = await supabase.auth.getUser();
      await supabase.from('templates').upsert(STD_TEMPLATES.map((t: any) => ({
        slug: t.slug, name: t.name, kind: t.kind, description: t.description || null,
        is_standard: true, sections: t.sections, sort: t.sort || 0, created_by: u.user?.id,
      })), { onConflict: 'slug' });
      TEMPLATES_SEEDED = true;
    }
    await loadTemplates();
  }
  async function loadTemplates() {
    const { data } = await supabase.from('templates').select('*').order('sort').order('name');
    TEMPLATES = data || [];
  }
  const templatesOf = (kind: string) => TEMPLATES.filter((t: any) => t.kind === kind);

  // ---------- HMS-artikler ----------
  // Standardartikler lagres trespråklig som JSON i tekstkolonnene (title/summary/body/category)
  async function ensureArticles() {
    if (!ARTICLES_SEEDED) {
      // upsert på slug for å oppgradere eksisterende (tidl. kun norsk) til trespråklig
      await supabase.from('articles').upsert(STD_ARTICLES.map((a: any) => ({
        slug: a.slug, title: JSON.stringify(a.title), category: JSON.stringify(a.category),
        summary: JSON.stringify(a.summary), body: JSON.stringify(a.body),
        sort: a.sort || 0, is_standard: true, updated_at: new Date().toISOString(),
      })), { onConflict: 'slug' });
      ARTICLES_SEEDED = true;
    }
    const { data } = await supabase.from('articles').select('*').order('sort').order('title');
    ARTICLES = data || [];
  }
  // Les et artikkelfelt: parse trespråklig JSON hvis det finnes, ellers ren tekst
  function artText(a: any, field: string): string {
    const raw = a?.[field];
    if (raw == null) return '';
    if (typeof raw === 'object') return raw[lang()] || raw.no || '';
    if (typeof raw === 'string' && raw.startsWith('{')) {
      try { const o = JSON.parse(raw); if (o && (o.no || o.pl || o.en)) return o[lang()] || o.no || ''; } catch (_e) { /* ren tekst */ }
    }
    return raw;
  }
  // ---------- FDV-arkiv (produktbibliotek) ----------
  async function ensureFdv() {
    if (!FDV_SEEDED) {
      // insert kun manglende (behold brukerens redigeringer, f.eks. tillagte SDS-lenker)
      const { data: existing } = await supabase.from('fdv_products').select('slug');
      const have = new Set((existing || []).map((x: any) => x.slug).filter(Boolean));
      const missing = STD_FDV.filter((f: any) => !have.has(f.slug));
      if (missing.length) {
        await supabase.from('fdv_products').insert(missing.map((f: any) => ({
          slug: f.slug, name: f.name, supplier: f.supplier || null, category: f.category || null,
          use_area: f.use_area || null, is_chemical: !!f.is_chemical, hazards: f.hazards || null,
          signal_word: f.signal_word || null, unit: f.unit || null, notes: f.notes || null,
          is_standard: true, sort: f.sort || 0,
        })));
      }
      FDV_SEEDED = true;
    }
    const { data } = await supabase.from('fdv_products').select('*').order('category').order('sort').order('name');
    FDV = data || [];
  }

  function artTri(a: any, field: string): any {
    const raw = a?.[field];
    if (raw && typeof raw === 'object') return { no: raw.no || '', pl: raw.pl || '', en: raw.en || '' };
    if (typeof raw === 'string' && raw.startsWith('{')) { try { const o = JSON.parse(raw); if (o && (o.no || o.pl || o.en)) return o; } catch (_e) { /* */ } }
    const v = raw || ''; return { no: v, pl: v, en: v };
  }

  // ---------- Avvik-konfig (kategorier + ansvarlige) ----------
  async function ensureDevConfig() {
    if (!DEV_SEEDED) {
      const { data: cats } = await supabase.from('deviation_categories').select('id').limit(1);
      if (!cats || !cats.length) {
        await supabase.from('deviation_categories').insert(STD_DEV_CATS.map((name, i) => ({ name, sort: i, is_standard: true })));
      }
      DEV_SEEDED = true;
    }
    const [{ data: c }, { data: r }] = await Promise.all([
      supabase.from('deviation_categories').select('*').order('sort').order('name'),
      supabase.from('deviation_responsibles').select('*').order('sort').order('name'),
    ]);
    DEV_CATS = c || []; DEV_RESP = r || [];
  }
  // Oversettelse av standard avvikskategorier (lagret navn = norsk; vises på gjeldende språk)
  const DEV_CAT_I18N: Record<string, { no: string; pl: string; en: string }> = {
    'HMS': { no: 'HMS', pl: 'BHP', en: 'HSE' },
    'Kvalitet': { no: 'Kvalitet', pl: 'Jakość', en: 'Quality' },
    'Fremdrift': { no: 'Fremdrift', pl: 'Postęp', en: 'Progress' },
    'Materiell / leveranse': { no: 'Materiell / leveranse', pl: 'Materiały / dostawa', en: 'Materials / delivery' },
    'Skade / ulykke': { no: 'Skade / ulykke', pl: 'Uraz / wypadek', en: 'Injury / accident' },
    'Nestenulykke': { no: 'Nestenulykke', pl: 'Sytuacja o mały włos', en: 'Near miss' },
    'Miljø': { no: 'Miljø', pl: 'Środowisko', en: 'Environment' },
    'Annet': { no: 'Annet', pl: 'Inne', en: 'Other' },
  };
  const devCatLabel = (name: string) => { const m = DEV_CAT_I18N[name]; return m ? m[lang()] : (name || ''); };
  const devSeverityLabel = (s: string) => s === 'hoy' ? p('sevHigh') : s === 'middels' ? p('sevMed') : s === 'lav' ? p('sevLow') : '';
  const devStatusLabel = (s: string) => s === 'closed' ? t('statusClosed') : s === 'in_progress' ? p('statusInProgress') : t('statusOpen');
  const devStatusClass = (s: string) => s === 'closed' ? 'closed' : s === 'in_progress' ? 'progress' : 'open';
  // Ett format for avvik overalt: «Avvik 2026-003»; status i merkelappen, alvorlighetsgrad som tekst.
  const devTitle = (d: any) => { const w = p('nDeviation'); return `${w.charAt(0).toUpperCase()}${w.slice(1)} ${d.number || '—'}`; };

  // ---------- Auth routing ----------
  async function route() {
    const hash = new URLSearchParams(location.hash.replace(/^#/, ''));
    if (new URLSearchParams(location.search).get('setpw') === '1' || hash.get('type') === 'recovery') { renderSetPassword(); return; }
    const { data } = await supabase.auth.getSession();
    if (!data.session) { renderLogin(); return; }
    if (!ME.id) await loadMe();
    // Visningen leses fra adressen (?view=…&id=…), så lenker, oppdatering og
    // Tilbake-knappen på telefonen lander på samme sted.
    const q = new URLSearchParams(location.search);
    const view = q.get('view') || 'dashboard';
    const id = q.get('id');
    URL_FROM_ROUTE = true;
    try {
      if (view === 'deviation-new') await renderNewDeviation(q.get('project'));
      else if (view === 'checklist-new') await renderNewChecklist(q.get('project'), q.get('kind') === 'verneround' ? 'verneround' : 'checklist');
      else if (view === 'projects' && id && q.get('dev')) await openDeviationById(q.get('dev')!, id);
      else if (view === 'projects' && id) await openProject(id);
      else if (view === 'workdoc' && id) await openWorkDocById(id);
      else if (view === 'workdoc' && q.get('new')) await renderWorkDocEditor(null, q.get('new')!);
      else {
        const n = NAV.find((x) => x.id === view);
        const ok = n && canSee(n.id);
        ACTIVE_NAV = ok ? n!.id : 'dashboard';
        await (ok ? n!.run() : renderDashboard());
      }
    } finally { URL_FROM_ROUTE = false; }
  }
  // Kun ekte bytte av bruker (inn/ut, annen konto) skal tegne siden på nytt.
  // Supabase sender også hendelser når innloggingen fornyes og når fanen får
  // fokus igjen – de skal IKKE tømme et halvutfylt skjema.
  let AUTH_UID: string | null | undefined = undefined;
  supabase.auth.onAuthStateChange((ev, session) => {
    if (ev === 'PASSWORD_RECOVERY') { renderSetPassword(); return; }
    const uid = session?.user?.id || null;
    if (ev === 'INITIAL_SESSION') { AUTH_UID = uid; return; } // oppstarten tas av route() nederst
    if (uid === AUTH_UID) return;
    AUTH_UID = uid;
    ME = { id: '', email: '', role: 'ansatt', name: '' };
    route();
  });

  // Inviterte ansatte lander her med ?setpw=1 og en aktiv invitasjons-sesjon
  function renderSetPassword() {
    redraw = renderSetPassword;
    teardownShell();
    root.innerHTML = `
      <div class="p-card p-login">
        <h1>${esc(p('setPwTitle'))}</h1>
        <p class="p-muted">${esc(p('setPwIntro'))}</p>
        <form id="pwf" style="margin-top:16px">
          <label class="p-field">${esc(p('newPassword'))}<input id="pwf-pass" type="password" autocomplete="new-password" required></label>
          <button class="btn btn--primary" type="submit">${esc(p('savePassword'))}</button>
          <p class="p-err" id="pwf-err" hidden></p>
        </form>
      </div>`;
    const f = document.getElementById('pwf') as HTMLFormElement;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('pwf-err')!; err.hidden = true;
      const pass = (document.getElementById('pwf-pass') as HTMLInputElement).value;
      if (pass.length < 8) { err.textContent = p('pwTooShort'); err.hidden = false; return; }
      const btn = f.querySelector('button')!; btn.setAttribute('disabled', 'true');
      const { error } = await supabase.auth.updateUser({ password: pass });
      if (error) { err.textContent = error.message; err.hidden = false; btn.removeAttribute('disabled'); return; }
      history.replaceState(null, '', '/portal/');
      route();
    });
  }

  // ---------- Glemt passord ----------
  /**
   * Sender lenke for nytt passord.
   *
   * Svarer ALLTID det samme, uansett om adressen finnes. Et skjema som sier
   * «denne e-posten er ikke registrert» forteller hvem som helst hvem som
   * jobber her — og for en portal med en håndfull ansatte er det en kort liste
   * å gjette seg fram til.
   *
   * Lenken peker tilbake med ?setpw=1, som er samme landingssted inviterte
   * ansatte bruker. Én skjerm for «velg et passord», ikke to som kan komme i
   * utakt.
   */
  function renderForgot() {
    redraw = renderForgot;
    teardownShell();
    root.innerHTML = `
      <div class="p-card p-login">
        <h1>${esc(p('forgotTitle'))}</h1>
        <p class="p-muted">${esc(p('forgotIntro'))}</p>
        <form id="fgf" style="margin-top:16px">
          <label class="p-field">${esc(p('email'))}<input id="fgf-email" type="email" autocomplete="email" required></label>
          <button class="btn btn--primary" type="submit">${esc(p('forgotSend'))}</button>
          <p class="p-muted" id="fgf-msg" hidden style="margin-top:12px"></p>
        </form>
        <p style="margin-top:14px"><button type="button" class="p-linkbtn" id="fgf-back">${esc(p('backToLogin'))}</button></p>
      </div>`;
    document.getElementById('fgf-back')!.addEventListener('click', renderLogin);
    const f = document.getElementById('fgf') as HTMLFormElement;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('fgf-email') as HTMLInputElement).value.trim();
      const msg = document.getElementById('fgf-msg')!;
      const btn = f.querySelector('button')!;
      btn.setAttribute('disabled', 'true');
      await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: location.origin + '/portal/?setpw=1',
      });
      // Feilen fra Supabase brukes bevisst ikke: samme svar uansett.
      btn.removeAttribute('disabled');
      msg.textContent = p('forgotSent');
      msg.hidden = false;
    });
  }

  // ---------- Login ----------
  function renderLogin() {
    redraw = renderLogin;
    teardownShell();
    root.innerHTML = `
      <div class="p-card p-login">
        <h1>${esc(p('loginTitle'))}</h1>
        <p class="p-muted">${esc(p('loginIntro'))}</p>
        <form id="lf" style="margin-top:16px">
          <label class="p-field">${esc(p('email'))}<input id="lf-email" type="email" autocomplete="email" required></label>
          <label class="p-field">${esc(p('password'))}<input id="lf-pass" type="password" autocomplete="current-password" required></label>
          <button class="btn btn--primary" type="submit">${esc(p('signIn'))}</button>
          <p class="p-err" id="lf-err" hidden></p>
        </form>
        <p style="margin-top:14px"><button type="button" class="p-linkbtn" id="lf-forgot">${esc(p('forgotPw'))}</button></p>
      </div>`;
    document.getElementById('lf-forgot')!.addEventListener('click', renderForgot);
    const f = document.getElementById('lf') as HTMLFormElement;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('lf-err')!;
      err.hidden = true;
      const email = (document.getElementById('lf-email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('lf-pass') as HTMLInputElement).value;
      const btn = f.querySelector('button')!; btn.setAttribute('disabled', 'true');
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      btn.removeAttribute('disabled');
      if (error) { err.textContent = p('loginErr'); err.hidden = false; }
    });
  }

  async function currentEmail() {
    const { data } = await supabase.auth.getUser();
    return data.user?.email || '';
  }

  // ---------- Felles for felt: dagens dato, valgt prosjekt, avviksnummer ----------
  const todayISO = () => { const d = new Date(); return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10); };
  const longDate = () => new Date().toLocaleDateString(lang() === 'en' ? 'en-GB' : lang() === 'pl' ? 'pl-PL' : 'nb-NO', { weekday: 'long', day: 'numeric', month: 'long' });
  const firstName = () => (ME.name || '').split(/\s+/)[0];
  // Prosjektet håndverkeren jobber på huskes på telefonen, så avvik/sjekkliste/bilder
  // alltid starter med riktig prosjekt valgt.
  const FIELD_KEY = 'dekmar-field-project';
  function fieldProject(): string | null { try { return localStorage.getItem(FIELD_KEY) || null; } catch (_e) { return null; } }
  // explicit = valgt av brukeren i dag: da overstyrer ikke ressursplanen valget resten av dagen.
  function setFieldProject(id: string | null, explicit = false) { try { if (id) localStorage.setItem(FIELD_KEY, id); else localStorage.removeItem(FIELD_KEY); if (explicit) localStorage.setItem(FIELD_KEY + ':day', todayISO()); } catch (_e) { /* */ } }
  const fieldPickedToday = () => { try { return localStorage.getItem(FIELD_KEY + ':day') === todayISO(); } catch (_e) { return false; } };
  async function myAssignmentsToday(): Promise<any[]> {
    const names = [ME.name, ME.email].filter(Boolean);
    if (!names.length) return [];
    const { data } = await supabase.from('resource_assignments').select('project_id, employee').eq('work_date', todayISO()).in('employee', names);
    return data || [];
  }
  /**
   * Neste avviksnummer, årsbasert og felles for hele firmaet (ÅÅÅÅ-NNN).
   * Tidligere talte hvert prosjekt fra 001, så samme nummer fantes på flere
   * prosjekter i registeret. Hentes rett før lagring, ikke når skjemaet åpnes.
   */
  async function nextDeviationNumber(): Promise<string> {
    const yr = new Date().getFullYear();
    const { data } = await supabase.from('deviations').select('number').like('number', `${yr}-%`);
    let mx = 0;
    (data || []).forEach((d: any) => { const m = String(d.number || '').match(/^(\d{4})-(\d+)$/); if (m && +m[1] === yr) mx = Math.max(mx, parseInt(m[2], 10)); });
    return `${yr}-${String(mx + 1).padStart(3, '0')}`;
  }

  // ---------- Oversikt ----------
  async function renderDashboard() {
    if (!ME.id) await loadMe();
    if (ME.role === 'ansatt') return renderFieldHome();
    redraw = renderDashboard;
    await ensureShell('dashboard');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const [projC, devC, docC, openDevs, plan] = await Promise.all([
      supabase.from('projects').select('id', { count: 'exact', head: true }).eq('status', 'active'),
      supabase.from('deviations').select('id', { count: 'exact', head: true }).neq('status', 'closed'),
      supabase.from('documents').select('id', { count: 'exact', head: true }),
      supabase.from('deviations').select('id, number, severity, status, description, project_id, created_at, projects(name)').neq('status', 'closed').order('created_at', { ascending: false }).limit(6),
      supabase.from('resource_assignments').select('employee, project_id, projects(name)').eq('work_date', todayISO()),
    ]);
    const nProj = projC.count ?? 0, nDev = devC.count ?? 0, nDoc = docC.count ?? 0;
    const devRows = (openDevs.data || []).map((d: any) => `
      <li><button type="button" class="dash-row" data-dev="${esc(d.id)}" data-proj="${esc(d.project_id)}">
        <span class="dash-row-main"><strong>${esc(devTitle(d))}</strong> · ${esc(d.projects?.name || '')}<span class="dash-row-sub">${esc([d.severity ? devSeverityLabel(d.severity) : '', (d.description || '').slice(0, 90)].filter(Boolean).join(' · '))}</span></span>
        <span class="p-badge ${devStatusClass(d.status)}">${esc(devStatusLabel(d.status))}</span>
      </button></li>`).join('');
    const byProj = new Map<string, { name: string; people: string[] }>();
    (plan.data || []).forEach((a: any) => { const g = byProj.get(a.project_id) || { name: a.projects?.name || '—', people: [] }; g.people.push(a.employee); byProj.set(a.project_id, g); });
    const planRows = Array.from(byProj.entries()).map(([pid, g]) => `
      <li><button type="button" class="dash-row" data-openproj="${esc(pid)}">
        <span class="dash-row-main"><strong>${esc(g.name)}</strong><span class="dash-row-sub">${esc(g.people.join(', '))}</span></span>
        <span class="p-go">${ICONS.chevron}</span>
      </button></li>`).join('');
    root.innerHTML = `
      <div class="dash-hero">
        <h1>${esc(p('overview'))}</h1>
        <p class="p-muted dash-date">${esc(longDate())}${ME.name ? ` · ${esc(ME.name)}` : ''}</p>
      </div>
      <div class="dash-quick">
        <button type="button" class="btn btn--primary" data-act="dev"><span class="btn-ic">${ICONS.plus}</span>${esc(p('fieldReport'))}</button>
        <button type="button" class="btn btn--ghost" data-act="cl"><span class="btn-ic">${ICONS.checklist}</span>${esc(p('newChecklist'))}</button>
        <button type="button" class="btn btn--ghost" data-act="doc"><span class="btn-ic">${ICONS.workdoc}</span>${esc(p('newWorkdoc').replace(/^\+\s*/, ''))}</button>
      </div>
      <div class="dash-stats">
        <button class="dash-stat" data-go="projects"><span class="dash-stat-n">${nProj}</span><span class="dash-stat-l">${esc(p('activeProjects'))}</span></button>
        <button class="dash-stat ${nDev ? 'is-alert' : ''}" data-go="deviations"><span class="dash-stat-n">${nDev}</span><span class="dash-stat-l">${esc(p('openDeviations'))}</span></button>
        <button class="dash-stat" data-go="documents"><span class="dash-stat-n">${nDoc}</span><span class="dash-stat-l">${esc(p('documents'))}</span></button>
      </div>
      <div class="dash-cols">
        <section class="dash-panel">
          <div class="dash-panel-hd"><h2>${esc(p('latestOpenDeviations'))}</h2><button type="button" class="p-linkbtn" data-go="deviations">${esc(p('seeAll'))}</button></div>
          ${devRows ? `<ul class="dash-rows">${devRows}</ul>` : `<p class="p-muted">${esc(p('noOpenDeviations'))}</p>`}
        </section>
        <section class="dash-panel">
          <div class="dash-panel-hd"><h2>${esc(p('plannedToday'))}</h2><button type="button" class="p-linkbtn" data-go="resource">${esc(p('seeAll'))}</button></div>
          ${planRows ? `<ul class="dash-rows">${planRows}</ul>` : `<p class="p-muted">${esc(p('nobodyPlanned'))}</p>`}
        </section>
      </div>`;
    root.querySelectorAll<HTMLElement>('[data-go]').forEach((el) => el.addEventListener('click', () => goNav(el.dataset.go!)));
    root.querySelectorAll<HTMLElement>('[data-dev]').forEach((el) => el.addEventListener('click', () => openDeviationById(el.dataset.dev!, el.dataset.proj!)));
    root.querySelectorAll<HTMLElement>('[data-openproj]').forEach((el) => el.addEventListener('click', () => openProject(el.dataset.openproj!)));
    root.querySelector('[data-act="dev"]')!.addEventListener('click', () => renderNewDeviation(null));
    root.querySelector('[data-act="cl"]')!.addEventListener('click', () => renderNewChecklist(null, 'checklist'));
    root.querySelector('[data-act="doc"]')!.addEventListener('click', () => goNav('workdoc'));
  }

  // ---------- Felt-visning (rolle ansatt): dagens jobb + de fire tingene man gjør på taket ----------
  async function renderFieldHome() {
    redraw = renderFieldHome;
    await ensureShell('dashboard');
    root.innerHTML = `<p class="portal-loading">…</p>`;
    const [projs, mine, myDevs, myCls, myDocs] = await Promise.all([
      wdActiveProjects(),
      myAssignmentsToday(),
      supabase.from('deviations').select('id, number, status, severity, description, project_id, created_at, projects(name)').eq('created_by', ME.id).order('created_at', { ascending: false }).limit(5),
      supabase.from('checklists').select('id, type, title, title_i18n, sections, answers, performed_by, performed_date, created_at, project_id, projects(name)').eq('created_by', ME.id).order('created_at', { ascending: false }).limit(3),
      supabase.from('work_docs').select('id, title, i18n, project_id, created_at, projects(name)').eq('created_by', ME.id).order('created_at', { ascending: false }).limit(3),
    ]);
    const todayIds = Array.from(new Set(mine.map((a: any) => a.project_id)));
    // Dagens tildeling vinner over det som var valgt sist.
    let sel = fieldProject();
    if (todayIds.length && (!sel || (!todayIds.includes(sel) && !fieldPickedToday()))) { sel = todayIds[0]; setFieldProject(sel); }
    if (sel && !projs.some((x: any) => x.id === sel)) sel = null;
    const pname = (id: string) => (projs.find((x: any) => x.id === id) || {}).name || '';
    const todayHtml = todayIds.length
      ? `<ul class="fh-jobs">${todayIds.map((id) => `<li><button type="button" class="fh-job${id === sel ? ' is-sel' : ''}" data-openjob="${esc(id)}" aria-label="${esc(p('openProjectBtn'))}: ${esc(pname(id) || '')}"><span class="fh-job-name">${esc(pname(id) || '—')}</span><span class="fh-job-end">${id === sel ? `<span class="fh-job-tag">${esc(p('fieldWorkingOn'))}</span>` : ''}<span class="fh-job-go">${ICONS.chevron}</span></span></button></li>`).join('')}</ul>`
      : `<p class="p-muted fh-nojob">${esc(p('fieldNoJobToday'))}</p>`;
    const projOpts = projs.map((pr: any) => `<option value="${esc(pr.id)}"${pr.id === sel ? ' selected' : ''}>${esc(pr.name)}</option>`).join('');
    type Row = { at: string; html: string };
    const rows: Row[] = [];
    (myDevs.data || []).forEach((d: any) => rows.push({ at: d.created_at, html: `<li><button type="button" class="dash-row" data-dev="${esc(d.id)}" data-proj="${esc(d.project_id)}"><span class="dash-row-main"><strong>${esc(devTitle(d))}</strong> · ${esc(d.projects?.name || '')}<span class="dash-row-sub">${esc([fmt(d.created_at), d.severity ? devSeverityLabel(d.severity) : '', (d.description || '').slice(0, 70)].filter(Boolean).join(' · '))}</span></span><span class="p-badge ${devStatusClass(d.status)}">${esc(devStatusLabel(d.status))}</span></button></li>` }));
    (myCls.data || []).forEach((c: any) => rows.push({ at: c.created_at, html: `<li><button type="button" class="dash-row" data-cl="${esc(c.id)}"><span class="dash-row-main"><strong>${esc(formTitle(c, c.type === 'verneround' ? t('verneround') : t('checklist')))}</strong> · ${esc(c.projects?.name || '')}<span class="dash-row-sub">${esc(fmt(c.performed_date || c.created_at))}</span></span><span class="p-muted p-go-txt">PDF ${ICONS.chevron}</span></button></li>` }));
    (myDocs.data || []).forEach((w: any) => rows.push({ at: w.created_at, html: `<li><button type="button" class="dash-row" data-wd="${esc(w.id)}"><span class="dash-row-main"><strong>${esc(wdI18nVal(w, 'title') || p('workdocNav'))}</strong> · ${esc(w.projects?.name || '')}<span class="dash-row-sub">${esc(fmt(w.created_at))}</span></span><span class="p-go">${ICONS.chevron}</span></button></li>` }));
    rows.sort((a, b) => String(b.at).localeCompare(String(a.at)));
    root.innerHTML = `
      <div class="fh">
        <header class="fh-hello">
          <h1>${esc(firstName() ? fill(p('fieldHello'), { name: firstName() }) : p('fieldHelloNoName'))}</h1>
          <p class="p-muted">${esc(longDate())}</p>
        </header>
        <section class="fh-today" aria-labelledby="fh-today-h">
          <h2 id="fh-today-h">${esc(p('fieldToday'))}</h2>
          ${todayHtml}
          ${todayIds.length
            ? `<details class="fh-other"${sel && !todayIds.includes(sel) ? ' open' : ''}><summary>${esc(p('fieldOtherProject'))}</summary><label class="p-field fh-pick"><span class="sr-only">${esc(p('wdChooseProject'))}</span><select id="fh-proj"><option value="">${esc(p('wdChooseProject'))}…</option>${projOpts}</select></label></details>`
            : `<label class="p-field fh-pick">${esc(p('fieldWorkingOn'))}<select id="fh-proj"><option value="">${esc(p('wdChooseProject'))}…</option>${projOpts}</select></label>`}
        </section>
        <div class="fh-actions">
          <button type="button" class="fh-primary" data-act="dev"><span class="fh-ic">${ICONS.deviation}</span><span>${esc(p('fieldReport'))}</span></button>
          <div class="fh-secondary">
            <button type="button" class="fh-btn" data-act="cl"><span class="fh-ic">${ICONS.checklist}</span><span>${esc(t('checklist'))}</span></button>
            <button type="button" class="fh-btn" data-act="vr"><span class="fh-ic">${ICONS.inspect}</span><span>${esc(t('verneround'))}</span></button>
            <button type="button" class="fh-btn" data-act="doc"><span class="fh-ic">${ICONS.camera}</span><span>${esc(p('workdocNav'))}</span></button>
            <button type="button" class="fh-btn" data-act="hb"><span class="fh-ic">${ICONS.handbook}</span><span>${esc(p('hmsHandbook'))}</span></button>
          </div>
        </div>
        <section class="fh-recent" aria-labelledby="fh-recent-h">
          <h2 id="fh-recent-h">${esc(p('fieldMine'))}</h2>
          ${rows.length ? `<ul class="dash-rows">${rows.slice(0, 6).map((r) => r.html).join('')}</ul>` : `<p class="p-muted">${esc(p('fieldNoneYet'))}</p>`}
        </section>
      </div>`;
    const selEl = document.getElementById('fh-proj') as HTMLSelectElement;
    selEl.addEventListener('change', () => { setFieldProject(selEl.value || null, true); renderFieldHome(); });
    // Dagens jobb er selve inngangen til prosjektet: ett trykk åpner det.
    root.querySelectorAll<HTMLElement>('[data-openjob]').forEach((b) => b.addEventListener('click', () => { setFieldProject(b.dataset.openjob!, true); openProject(b.dataset.openjob!); }));
