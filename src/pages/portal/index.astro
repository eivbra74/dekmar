  // ---------- Sortering ----------
  /**
   * Felles sorteringsrad for listene.
   *
   * Prosjektnummeret har ingen egen kolonne — Tripletex-importen legger
   * `displayName` i `name`, og den ser ut som «10364 Borgenveien 40». Nummeret
   * hentes derfor ut av navnet. Sorteres det som tekst, kommer 10364 før 9812;
   * derfor tall, ikke streng.
   */
  const projNo = (v: any): number => {
    const m = String(v?.name || '').match(/^\s*(\d{3,})/);
    return m ? parseInt(m[1], 10) : Number.MAX_SAFE_INTEGER;
  };

  const byText = (a: any, b: any) =>
    String(a || '').localeCompare(String(b || ''), 'nb', { sensitivity: 'base', numeric: true });

  type SortDef = { v: string; label: () => string; cmp: (a: any, b: any) => number };

  function sortBar(id: string, defs: SortDef[], current: string): string {
    const opts = defs.map((d) => `<option value="${esc(d.v)}"${d.v === current ? ' selected' : ''}>${esc(d.label())}</option>`).join('');
    return `<div class="p-sortbar">
      <span class="p-sortbar-label">${esc(p('sortBy'))}</span>
      <select id="${esc(id)}">${opts}</select>
    </div>`;
  }

  /** Sorterer en kopi. Å sortere lista på plass ville endret rekkefølgen for
      alle andre visninger som holder samme array. */
  function applySort(rows: any[], defs: SortDef[], v: string): any[] {
    const d = defs.find((x) => x.v === v) || defs[0];
    return [...rows].sort(d.cmp);
  }

  const SORTS_PROJECTS: SortDef[] = [
    { v: 'num',   label: () => p('sortNumber'),  cmp: (a, b) => projNo(a) - projNo(b) },
    { v: 'name',  label: () => p('sortName'),    cmp: (a, b) => byText(a.name, b.name) },
    { v: 'new',   label: () => p('sortNewest'),  cmp: (a, b) => String(b.created_at || '').localeCompare(String(a.created_at || '')) },
    { v: 'old',   label: () => p('sortOldest'),  cmp: (a, b) => String(a.created_at || '').localeCompare(String(b.created_at || '')) },
    { v: 'client', label: () => p('sortCustomer'), cmp: (a, b) => byText(a.client, b.client) },
