  const nok = (n: number) => (isFinite(n) ? n : 0).toLocaleString('nb-NO', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  const numv = (v: any) => { const n = parseFloat(String(v).replace(/\s/g, '').replace(',', '.')); return isFinite(n) ? n : 0; };
  const qStatusLabel = (s: string) => (({ draft: p('qStatusDraft'), sent: p('qStatusSent'), accepted: p('qStatusAccepted'), declined: p('qStatusDeclined') } as any)[s] || s);

  async function seedQuoteElements() {
    try {
      if (!QUOTE_ELEMENTS_SEEDED) {
        const { data: existing } = await supabase.from('quote_elements').select('slug');
        const have = new Set((existing || []).map((x: any) => x.slug));
        const missing = STD_QUOTE_ELEMENTS.filter((e: any) => !have.has(e.slug));
        if (missing.length) await supabase.from('quote_elements').insert(missing.map((e: any) => ({ category: e.category, spec: e.spec, unit: e.unit, price: e.price, slug: e.slug, sort: e.sort, is_standard: true })));
        QUOTE_ELEMENTS_SEEDED = true;
      }
    } catch (_e) { /* ignore */ }
    const { data } = await supabase.from('quote_elements').select('*').order('sort').order('category');
    QUOTE_ELEMENTS = data && data.length ? data : STD_QUOTE_ELEMENTS;
  }

  let LOGO_CACHE: string | null = null;
  async function ensureLogo(): Promise<string> {
    if (LOGO_CACHE !== null) return LOGO_CACHE;
    try {
      const blob = await (await fetch('/dekmar-logo.png')).blob();
      LOGO_CACHE = await new Promise<string>((r) => { const fr = new FileReader(); fr.onload = () => r(fr.result as string); fr.readAsDataURL(blob); });
    } catch (_e) { LOGO_CACHE = ''; }
    return LOGO_CACHE;
  }

  /**
   * Henter kunderegisteret fra Tripletex.
   *
   * Upsert på `tripletex_id`, som prosjekt- og produktimporten: kjøres den
   * igjen, oppdateres de samme radene i stedet for at registeret dobles.
   *
   * Inaktive kunder i Tripletex hoppes over. De er som regel avsluttede
   * kundeforhold, og å dra dem inn ville gjort søkefeltet ubrukelig.
   *
   * Felter som ikke finnes i Tripletex (kontaktperson, notater) rører vi ikke
   * — derfor listes kolonnene eksplisitt i stedet for å sende hele objektet.
   * En import skal ikke slette det noen har skrevet inn for hånd.
   */
  async function importTripletexCustomers(btn: HTMLButtonElement) {
    const old = btn.textContent;
    btn.disabled = true; btn.textContent = p('ttImporting');
    try {
      const vals = (await tripletexFetch('customers')).filter((v: any) => !v.isInactive);
      const { data: u } = await supabase.auth.getUser();
      // Inkrementelt: kun kunder som ikke allerede finnes (endrer ikke eksisterende).
      const { data: existing } = await supabase.from('customers').select('tripletex_id').not('tripletex_id', 'is', null);
      const have = new Set((existing || []).map((r: any) => String(r.tripletex_id)));
      const rows = vals.filter((v: any) => !have.has(String(v.id))).map((v: any) => {
        const a = v.physicalAddress || {};
        const addr = [a.addressLine1, [a.postalCode, a.city].filter(Boolean).join(' ')].filter(Boolean).join(', ');
        return {
          tripletex_id: v.id,
          name: v.name || ('Kunde ' + v.id),
          org_no: v.organizationNumber || null,
          email: v.email || null,
          phone: v.phoneNumberMobile || v.phoneNumber || null,
          address: addr || null,
          created_by: u.user?.id,
        };
      });
      for (let i = 0; i < rows.length; i += 200) {
        const chunk = rows.slice(i, i + 200); if (!chunk.length) break;
        const { error } = await supabase.from('customers').insert(chunk);
        if (error) throw new Error(error.message);
      }
      btn.textContent = rows.length + ' ' + p('ttNewImported');
      setTimeout(renderCustomers, 1200);
    } catch (e) {
      toast(p('ttFail'), 'err', (e as Error).message);
      btn.disabled = false; btn.textContent = old;
    }
  }

