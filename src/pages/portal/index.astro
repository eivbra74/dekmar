  function renderArticleEditor(a: any) {
    redraw = () => renderArticleEditor(a);
    const isNew = !a;
    root.innerHTML = `
      <div class="p-head">
        <h1>${esc(isNew ? p('newArticle').replace('+ ', '') : p('edit'))}</h1>
        <div class="p-user"><button class="btn btn--ghost" id="ae-back"><span class="btn-ic">${ICONS.arrowLeft}</span>${esc(p('backGeneric'))}</button></div>
      </div>
      <div class="p-card">
        <p class="p-muted" style="margin-top:0">${esc(p('editingInLang'))}: ${lang().toUpperCase()}</p>
        <div class="p-grid2">
          <label class="p-field">${esc(p('articleTitleLabel'))}<input id="ae-title" type="text" value="${esc(a ? artText(a, 'title') : '')}"></label>
          <label class="p-field">${esc(p('articleCategoryLabel'))}<input id="ae-cat" type="text" value="${esc(a ? artText(a, 'category') : '')}"></label>
        </div>
        <label class="p-field">${esc(p('articleSummaryLabel'))}<input id="ae-sum" type="text" value="${esc(a ? artText(a, 'summary') : '')}"></label>
        <label class="p-field">${esc(p('articleBodyLabel'))}<textarea id="ae-body" rows="12">${esc(a ? artText(a, 'body') : '')}</textarea></label>
        <button class="btn btn--primary" id="ae-save" type="button">${esc(p('save'))}</button>
        ${a && !a.is_standard ? `<button class="btn btn--ghost" id="ae-del" style="margin-left:8px">${esc(p('del'))}</button>` : ''}
        <span class="p-muted" id="ae-msg" style="margin-left:10px"></span>
      </div>`;
    document.getElementById('ae-back')!.addEventListener('click', () => (a ? renderArticle(a) : renderArticles()));
    const del = document.getElementById('ae-del'); if (del) del.addEventListener('click', async () => {
      if (!(await confirmDelete('nArticle', artText(a, 'title')))) return;
      if (!(await runDelete(supabase.from('articles').delete().eq('id', a.id)))) return;
      await ensureArticles(); renderArticles();
    });
    document.getElementById('ae-save')!.addEventListener('click', async () => {
      const title = (document.getElementById('ae-title') as HTMLInputElement).value.trim();
      const msg = document.getElementById('ae-msg')!;
      if (!title) { msg.textContent = p('nameRequired'); return; }
      const L = lang();
      // sett verdien for gjeldende språk, behold øvrige språk (eller speil for nye artikler)
      const merge = (field: string, value: string) => {
        const cur = a ? artTri(a, field) : { no: '', pl: '', en: '' };
        const anyOther = cur.no || cur.pl || cur.en;
        const obj: any = { no: cur.no || (anyOther ? cur.no : value), pl: cur.pl || (anyOther ? cur.pl : value), en: cur.en || (anyOther ? cur.en : value) };
        if (!a) { obj.no = value; obj.pl = value; obj.en = value; } // ny artikkel: speil til alle språk
        obj[L] = value;
        return JSON.stringify(obj);
      };
      const payload: any = {
        title: merge('title', title),
        category: merge('category', (document.getElementById('ae-cat') as HTMLInputElement).value.trim()),
        summary: merge('summary', (document.getElementById('ae-sum') as HTMLInputElement).value.trim()),
        body: merge('body', (document.getElementById('ae-body') as HTMLTextAreaElement).value),
        updated_at: new Date().toISOString(),
      };
      let error;
      if (isNew) { ({ error } = await supabase.from('articles').insert({ ...payload, slug: null, is_standard: false, sort: 100 })); }
      else { ({ error } = await supabase.from('articles').update(payload).eq('id', a.id)); }
      if (error) { msg.textContent = error.message; return; }
      await ensureArticles(); renderArticles();
    });
  }

