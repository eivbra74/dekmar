          ${activeProj.map((pr: any) => { const logged = sumBy[pr.id] || 0; const budget = numv(pr.budget_hours); const rem = budget - logged; const over = budget > 0 && rem < 0;
            return `<tr class="p-click" data-goproj="${esc(pr.id)}"><td>${esc(pr.name)}</td><td style="text-align:right">${budget > 0 ? esc(nok(budget)) : '—'}</td><td style="text-align:right">${esc(nok(logged))}</td><td style="text-align:right${over ? ';color:#cc1f2a;font-weight:600' : ''}">${budget > 0 ? (over ? esc(p('overBudget')) + ' ' + esc(nok(-rem)) : esc(nok(rem))) : '—'}</td><td>${timeBar(logged, budget)}</td></tr>`;
