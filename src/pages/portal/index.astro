      const { error } = await supabase.from('quotes').insert({ title: state.name || null, project_id: state.project_id || null, customer_id: state.customer_id || null, lines: qlines, terms: STD_QUOTE_TERMS.filter((tm: any) => tm.on).map((tm: any) => tm.text.replace('{rate}', nok(QUOTE_LETTER.hourlyDefault || 850))), vat_rate: 25, valid_days: QUOTE_LETTER.validDaysDefault || 30, hourly_rate: QUOTE_LETTER.hourlyDefault || 850, signatory: (QUOTE_LETTER.signatories[0] || {}).name, status: 'draft', created_by: u.user?.id });
