      const isChem = (document.getElementById('fe-chem') as HTMLInputElement).checked;
      const hazards = isChem ? Array.from(root.querySelectorAll<HTMLInputElement>('.fe-haz:checked')).map((x) => x.value).join(',') : null;
      const payload: any = {
        name, supplier: (document.getElementById('fe-supplier') as HTMLInputElement).value.trim() || null,
        category: (document.getElementById('fe-cat') as HTMLInputElement).value.trim() || null,
        unit: (document.getElementById('fe-unit') as HTMLInputElement).value.trim() || null,
        use_area: (document.getElementById('fe-use') as HTMLInputElement).value.trim() || null,
        is_chemical: isChem,
        signal_word: isChem ? ((document.getElementById('fe-signal') as HTMLSelectElement).value || null) : null,
        hazards, sds_url: (document.getElementById('fe-sds') as HTMLInputElement).value.trim() || null,
        fdv_url: (document.getElementById('fe-fdv') as HTMLInputElement).value.trim() || null,
        notes: (document.getElementById('fe-notes') as HTMLTextAreaElement).value.trim() || null,
      };
      const sdsFile = (document.getElementById('fe-sdsfile') as HTMLInputElement).files?.[0];
      if (sdsFile) {
        msg.textContent = p('uploading');
        const safe = sdsFile.name.replace(/[^a-z0-9._-]+/gi, '_');
        const path = `sds/fdv/${crypto.randomUUID()}_${safe}`;
        const up = await supabase.storage.from('ks-docs').upload(path, sdsFile, { contentType: sdsFile.type || 'application/pdf' });
        if (up.error) { msg.textContent = up.error.message; return; }
        payload.sds_path = path;
      }
      let error;
      if (isNew) { ({ error } = await supabase.from('fdv_products').insert({ ...payload, slug: null, is_standard: false })); }
      else { ({ error } = await supabase.from('fdv_products').update(payload).eq('id', f.id)); }
      if (error) { msg.textContent = error.message; return; }
      await ensureFdv(); renderFdv();
    });
  }

