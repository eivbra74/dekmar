  // Timeseksjon i prosjektvisningen: budsjett + ført + fremdrift + føringer + timeliste-PDF
  async function renderProjectTime(projectId: string) {
    const secEl = document.getElementById('sec-time'); if (!secEl) return;
    const [{ data: pr }, { data: ent }, { data: calcs }] = await Promise.all([
      supabase.from('projects').select('budget_hours').eq('id', projectId).single(),
      supabase.from('time_entries').select('*').eq('project_id', projectId).order('work_date', { ascending: false }),
      supabase.from('calculations').select('lines').eq('project_id', projectId),
    ]);
    const entries = ent || [];
    const logged = entries.reduce((s: number, e: any) => s + numv(e.hours), 0);
    const budget = numv(pr?.budget_hours);
    const calcHours = (calcs || []).reduce((s: number, c: any) => s + (c.lines || []).filter((l: any) => l.type === 'arbeid').reduce((a: number, l: any) => a + numv(l.qty), 0), 0);
    const rem = budget - logged; const over = budget > 0 && rem < 0;
    const email = await currentEmailSafe();
    const actList = TIME_ACTIVITIES.map((a) => `<option value="${esc(a)}">`).join('');
    secEl.innerHTML = `
      <h2>${esc(p('timeSection'))}</h2>
