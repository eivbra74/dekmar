    contracts:   ['admin', 'leder'],
    // Styrer systemet selv.
    templates:   ['admin'],
    // Ansatte-mappen er synlig for alle, men innholdet er rollestyrt: ansatt ser
    // bare seg selv, leder kan invitere og ser ikke-admins, admin ser/endrer alt.
    // Selve haandhevingen ligger i RLS paa profiles + admin-sjekk i edge-funksjoner.
    team:        ['admin', 'leder', 'ansatt'],
  };

  let ME: { id: string; email: string; role: string; name: string } = { id: '', email: '', role: 'ansatt', name: '' };

  /**
   * Henter innlogget bruker og rolle, og stempler «sist sett».
   *
   * Faller tilbake til 'ansatt' hvis noe feiler. Det er med vilje: en
   * nettverksfeil skal gi for LITE tilgang, ikke for mye.
   */
  async function loadMe() {
    try {
      const { data: u } = await supabase.auth.getUser();
      if (!u.user) return;
      ME.id = u.user.id;
      ME.email = u.user.email || '';
      const { data: pr, error } = await supabase.from('profiles').select('role, full_name').eq('id', u.user.id).maybeSingle();
      if (error) {
        // Migrasjon 018 er kjoert i prod, saa role-kolonnen finnes. En feil her
        // (RLS, nettverk) skal gi MINST privilegium, ikke mest: en ansatt skal
        // aldri faa admin-menyen fordi et kall glapp. Fail-closed til 'ansatt';
        // ved genuin feil laster brukeren siden paa nytt.
        console.warn('[roller] kunne ikke lese rolle; faller til ansatt', error.message);
        ME.role = 'ansatt';
        return;
      }
      // Rad finnes, men uten rolle: da ER hun ansatt.
      ME.role = (pr as any)?.role || 'ansatt';
      // Noen profiler har e-postadressen som navn (opprettet via invitasjon/sett passord): da regnes det som uten navn.
      const fullName = String((pr as any)?.full_name || '').trim();
      ME.name = fullName.includes('@') ? '' : fullName;
      // Sesjoner varer i uker, så «sist innlogget» alene ville vist en gammel
      // dato for en som bruker portalen daglig. Dette er det andre tallet.
      void supabase.from('profiles').update({ last_seen_at: new Date().toISOString() }).eq('id', u.user.id);
    } catch {
      // Nettverksfeil e.l.: ME.id forblir tom, saa ensureShell proever igjen
      // ved neste navigasjon. Menyen viser i mellomtiden minst mulig.
    }
  }

  const canSee = (navId: string) => (ROLE_ACCESS[navId] || ['admin']).includes(ME.role);

  /** Sender en bruker uten tilgang til oversikten i stedet for en tom side. */
  function guard(navId: string): boolean {
    if (canSee(navId)) return true;
    renderDashboard();
