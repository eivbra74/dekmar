  // ================= Ukekontroll =================
  let WEEK_STATE: { y: number; w: number } | null = null;
  function isoWeekOf(d: Date): [number, number] {
    const dt = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
    const day = (dt.getUTCDay() + 6) % 7; dt.setUTCDate(dt.getUTCDate() - day + 3);
    const firstThu = new Date(Date.UTC(dt.getUTCFullYear(), 0, 4));
    const week = 1 + Math.round(((dt.getTime() - firstThu.getTime()) / 86400000 - 3 + ((firstThu.getUTCDay() + 6) % 7)) / 7);
    return [dt.getUTCFullYear(), week];
  }
  function mondayOf(y: number, w: number): Date {
    const simple = new Date(Date.UTC(y, 0, 4)); const day = (simple.getUTCDay() + 6) % 7;
    const monday = new Date(simple); monday.setUTCDate(simple.getUTCDate() - day + (w - 1) * 7); return monday;
  }
  const ymd = (d: Date) => d.toISOString().slice(0, 10);
  function shiftWeek(y: number, w: number, delta: number): { y: number; w: number } {
    const mon = mondayOf(y, w); mon.setUTCDate(mon.getUTCDate() + delta * 7);
    const [ny, nw] = isoWeekOf(new Date(mon.getUTCFullYear(), mon.getUTCMonth(), mon.getUTCDate())); return { y: ny, w: nw };
  }

