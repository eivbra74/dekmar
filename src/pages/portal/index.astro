        ${emps.map((e) => `<tr><td>${esc(e)}</td>${byEmp[e].days.map((h) => `<td style="text-align:right">${h ? esc(nok(h)) : ''}</td>`).join('')}<td style="text-align:right;font-weight:600">${esc(nok(byEmp[e].total))}</td></tr>`).join('')}
