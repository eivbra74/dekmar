  // Gjoer en ferdig jsPDF om til base64 (uten data:-prefiks) for e-postvedlegg
  function pdfToBase64(doc: any): string { try { return (doc.output('datauristring') || '').split(',')[1] || ''; } catch (_e) { return ''; } }

  // Oversett en samling norske tekster til EN/PL via DeepL (Edge Function). Returnerer et oppslag NO->oversatt.
  async function translateMap(strings: string[], target: string): Promise<Map<string, string>> {
    const uniq = [...new Set(strings.map((s) => String(s == null ? '' : s)).filter((s) => s.trim()))];
    const m = new Map<string, string>();
    if (!uniq.length) return m;
    const { data, error } = await supabase.functions.invoke('translate', { body: { texts: uniq, target } });
    let errMsg = error ? (error.message || 'error') : ((data && (data as any).error) || '');
    if (error && (error as any).context && typeof (error as any).context.json === 'function') { try { const b = await (error as any).context.json(); if (b && b.error) errMsg = b.error; } catch (_e) { /* ignore */ } }
    if (errMsg) throw new Error(errMsg);
    const tr = ((data as any).translations) || [];
    uniq.forEach((s, i) => m.set(s, tr[i] || s));
    return m;
  }
  const langName = (t: string) => (t === 'PL' ? 'PL' : (t === 'NB' || t === 'NO') ? 'NO' : 'EN');

  // Bygger flerspraaklig tittel {no,pl,en} fra en tittel skrevet paa gjeldende
  // spraak. Oversetter til de to andre spraakene via translate-funksjonen slik
  // at listenavnet vises paa innlogget spraak (ogsaa brukertillegg som «uke 39»).
  async function formTitleI18n(title: string): Promise<Record<string, string>> {
    const src = lang();
    const out: Record<string, string> = { no: title, pl: title, en: title };
    if (!title || !title.trim()) return out;
    const targets: [string, string][] = [['NB', 'no'], ['PL', 'pl'], ['EN', 'en']];
    for (const [tgt, k] of targets) {
      if (k === src) continue;
      try { const m = await translateMap([title], tgt); out[k] = m.get(title) || title; } catch (_e) { out[k] = title; }
    }
    out[src] = title;
    return out;
  }
  // Viser listenavn paa innlogget spraak, med fallback til lagret tittel.
  const formTitle = (c: any, fallback = '') => (c && c.title_i18n && c.title_i18n[lang()]) || (c && c.title) || fallback;

