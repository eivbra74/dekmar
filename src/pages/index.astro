---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { references } from '../data/references';

const featured = services.filter((s) =>
  ['skratak', 'flate-tak', 'blikkenslager'].includes(s.slug)
);
const previewRefs = references.slice(0, 4);
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg" style={`background-image:url(/images/brand/hero.jpg)`}></div>
    <div class="hero__overlay"></div>
    <div class="container hero__inner">
      <span class="eyebrow hero__eyebrow">Takentreprenør &amp; blikkenslager i {site.area}</span>
      <h1>Velkommen til Dekmar AS</h1>
      <p class="hero__tagline">{site.tagline}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/kontakt/">Be om tilbud</a>
        <a class="btn btn--light" href="/tjenester/">Se våre tjenester</a>
      </div>
    </div>
  </section>

  <!-- USP-bar -->
  <section class="usp-bar">
    <div class="container usp-grid">
      {site.usps.map((u) => (
        <div class="usp">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5"/></svg>
          <span>{u}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- INTRO -->
  <section class="section">
    <div class="container intro-grid">
      <div>
        <span class="eyebrow">Om Dekmar AS</span>
        <h2>Kvalitet, faste priser og komplette løsninger</h2>
        <p class="lead">
          Vi er en blikkenslager og takentreprenør som holder til i Oslo. Vårt kjennetegn er
          kvalitet på våre tjenester. Vi tilbyr komplette løsninger der alt er inkludert i
          leveringen – med fast pris til avtalt tid.
        </p>
        <p>
          Vi utfører oppdrag for private, borettslag og eiendomsselskaper, samt sameier og
          offentlige etater. Vi arbeider primært i Oslo og Viken, men tar på oss oppdrag utenfor
          dette området etter avtale. Hvert tilbud utarbeides spesielt for det aktuelle prosjektet,
          slik at du får best mulig løsning til en markedsdyktig pris.
        </p>
        <a class="btn btn--ghost" href="/om-oss/">Mer om oss</a>
      </div>
      <ul class="intro-list">
        <li>Nytt tak: skråtak, flate tak, takstein, shingel, plater og belegg</li>
        <li>Tradisjonelle og diffusjonsåpne løsninger</li>
        <li>Alt i blikkenslagerarbeid</li>
        <li>Membraner og belegg for flate tak, balkonger m.m.</li>
        <li>Eget blikkenslagerverksted med egen serviceavdeling</li>
      </ul>
    </div>
  </section>

  <!-- FEATURED TJENESTER -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Tjenester</span>
        <h2>Alt innen tak og blikkenslagerarbeid</h2>
        <p class="lead">
          Vi utfører alt innen takarbeid, takomlegging og reparasjoner samt ny taktekking.
        </p>
      </div>
      <div class="grid grid--3">
        {featured.map((s) => <ServiceCard service={s} />)}
      </div>

      <div class="all-services">
        <h3>Alle tjenester</h3>
        <ul class="chip-list">
          {services.map((s) => (
            <li><a class="chip" href={`/tjenester/${s.slug}/`}>{s.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- REFERANSER -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Referanser</span>
        <h2>Et utvalg av våre prosjekter</h2>
        <p class="lead">
          Vi arbeider med rehabilitering og nybygg – fra bygårder og næringsbygg til skoler,
          idrettshaller og kirker.
        </p>
      </div>
      <div class="grid grid--4 ref-grid">
        {previewRefs.map((r) => (
          <a class="ref-card" href={`/referanser/${r.slug}/`}>
            <img src={r.images[0]} alt={r.title} loading="lazy" decoding="async" />
            <span class="ref-card__label">{r.title}</span>
          </a>
        ))}
      </div>
      <div class="center-btn">
        <a class="btn btn--ghost" href="/referanser/">Se alle referanser</a>
      </div>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(78vh, 640px);
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.03);
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(15, 17, 21, 0.82) 0%,
      rgba(15, 17, 21, 0.55) 55%,
      rgba(15, 17, 21, 0.35) 100%
    );
  }
  .hero__inner {
    position: relative;
    padding-block: 60px;
    max-width: 720px;
  }
  .hero__eyebrow {
    color: #ff8a91;
  }
  .hero h1 {
    color: #fff;
    margin-bottom: 0.15em;
  }
  .hero__tagline {
    font-family: var(--font-head);
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    font-weight: 500;
    color: #e7e9ec;
    margin-bottom: 1.4em;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* USP */
  .usp-bar {
    background: var(--brand);
    color: #fff;
  }
  .usp-grid {
    display: grid;
    gap: 14px 30px;
    grid-template-columns: 1fr;
    padding-block: 22px;
  }
  @media (min-width: 720px) {
    .usp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .usp-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .usp {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 0.98rem;
  }
  .usp svg {
    flex: none;
  }

  /* Intro */
  .intro-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .intro-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }
  .intro-list {
    list-style: none;
    margin: 0;
    padding: 26px;
    background: var(--surface);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .intro-list li {
    position: relative;
    padding-left: 30px;
    font-weight: 500;
  }
  .intro-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 12px;
    height: 12px;
    background: var(--brand);
    border-radius: 3px;
    transform: rotate(45deg);
  }

  /* All services chips */
  .all-services {
    margin-top: 52px;
    text-align: center;
  }
  .all-services h3 {
    margin-bottom: 18px;
  }
  .chip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .chip {
    display: inline-block;
    padding: 9px 16px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }
  .chip:hover {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
    text-decoration: none;
  }

  /* Referanser */
  .ref-card {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .ref-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .ref-card:hover img {
    transform: scale(1.06);
  }
  .ref-card__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 26px 16px 14px;
    color: #fff;
    font-family: var(--font-head);
    font-weight: 600;
    background: linear-gradient(transparent, rgba(15, 17, 21, 0.85));
  }
  .center-btn {
    text-align: center;
    margin-top: 38px;
  }
</style>
